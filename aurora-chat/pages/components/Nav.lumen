    transform: translateY(0);
  }
}
/* Global Form field styling for Login / Checkout / Cart */
.field {
  width: 100%;
  padding: 0.8rem 1.2rem;
  font-family: var(--lumen-font);
  font-size: 0.9375rem;
  border: 1px solid var(--lumen-border);
  border-radius: 10px;
  background: var(--lumen-surface);
  color: var(--lumen-fg);
  box-sizing: border-box;
  transition: all 0.2s ease;
}
.field:focus {
  outline: none;
  border-color: var(--lumen-primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--lumen-primary) 20%, transparent);
}
.aurora-nav {
  position:sticky;
  top:0;
