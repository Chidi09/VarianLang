  --lumen-surface: #ffffff;
  --lumen-surface-2: #f4f4f5;
  --lumen-fg: #09090b;
  --lumen-muted: #e4e4e7;
  --lumen-muted-fg: #71717a;
  --lumen-border: #e4e4e7;
  --lumen-radius: 12px;
}
:root.dark {
  --lumen-bg: #09090b;
  --lumen-surface: #18181b;
  --lumen-surface-2: #27272a;
  --lumen-fg: #fafafa;
  --lumen-muted: #27272a;
  --lumen-muted-fg: #a1a1aa;
  --lumen-border: #27272a;
  --lumen-primary: #818cf8;
}
.lmn-app {
  animation: page-fade-in 0.3s ease-out forwards;
}
@keyframes page-fade-in {
  from {
    opacity: 0;
    transform: translateY(8px);
