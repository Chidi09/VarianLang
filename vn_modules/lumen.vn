// lumen.vn — Lumen, the Varian frontend framework (server-driven live).
//
// A Lumen component renders to HTML on the SERVER (on top of Zenith). Event
// bindings like @click are compiled to `data-lumen-*` hook attributes; a tiny
// client runtime forwards those events over a WebSocket, the server re-renders
// the component and patches the DOM. Logic is written in Varian — Lumen is to
// Varian what JSX is to TypeScript.
//
// This file is MILESTONE 1: the server-side renderer for Lumen's `{{ }}` markup
// syntax, plus the @event -> data-lumen-* rewrite that the (future) live client
// will hook into. The live WebSocket/DOM-diff layer and `.lumen` single-file
// component compilation are later milestones.
//
// Markup:
//   {{ expr }}                     interpolate, HTML-escaped (safe by default)
//   {{! expr }}                    interpolate, raw / unescaped (trusted only)
//   {{#if expr}} .. {{else}} .. {{/if}}
//   {{#each items as item}} .. {{/each}}
//   @click="handler"               -> data-lumen-click="handler"  (live hook)
//
// `expr` is resolved against the context struct (dotted paths supported), using
// the same lookup/truthy/bind helpers Zenith's template engine already uses.

// ─── small string helper: replace every `find` with `repl` ───
fn _lumen_replace(s, find, repl) {
    let out = ""
    let i = 0
    let n = s.len()
    let flen = find.len()
    while i < n {
        let hit = _substr_index(s, find, i)
        if hit < 0 {
            out = out + s.substring(i, n)
            i = n
        } else {
            out = out + s.substring(i, hit) + repl
            i = hit + flen
        }
    }
    return out
}

// Rewrite @event="..." attribute bindings into data-lumen-event="..." hooks.
// The live client runtime listens for these and forwards the event server-side.
fn _lumen_bind_events(html) {
    let events = ["click", "input", "change", "submit", "keydown", "keyup", "blur", "focus", "mouseover", "mouseout"]
    let out = html
    for i in 0..events.len() {
        out = _lumen_replace(out, "@" + events[i] + "=\"", "data-lumen-" + events[i] + "=\"")
    }
    return out
}

// Is `token` (e.g. "else", "/if", "/each") one of the tokens we should halt at?
fn _lumen_is_stop(token, stop_tags) {
    if stop_tags == null { return false }
    for i in 0..stop_tags.len() {
        if stop_tags[i] == token { return true }
    }
    return false
}

// Render tpl[pos..stop) against ctx. Halts at the first {{else}}/{{/if}}/{{/each}}
// whose token is in stop_tags, reporting it back via "tag". Returns {out,pos,tag}.
fn _lumen_render_region(tpl, pos, stop, ctx, stop_tags) {
    // Varian treats `{` as interpolation in strings, so the delimiters are
    // written with brace escapes: "\{\{" is the literal two-char open marker.
    let OPEN = "\{\{"
    let CLOSE = "\}\}"
    let out = ""
    let i = pos
    while i < stop {
        let tag = _substr_index(tpl, OPEN, i)
        if tag < 0 or tag >= stop {
            out = out + tpl.substring(i, stop)
            i = stop
        } else {
            out = out + tpl.substring(i, tag)
            let close = _substr_index(tpl, CLOSE, tag + 2)
            if close < 0 or close >= stop {
                // No closing braces — emit the rest verbatim.
                out = out + tpl.substring(tag, stop)
                i = stop
            } else {
                let marker = tpl.code_at(tag + 2)
                if marker == 33 {                 // '!' raw interpolation
                    let expr = _sanitize.trim(tpl.substring(tag + 3, close))
                    let looked = _tpl_lookup(ctx, expr)
                    let val = ""
                    if looked != null { val = "" + looked }
                    out = out + val
                    i = close + 2
                } else if marker == 123 {          // '{' — triple brace {{{ }}} raw unescaped
                    let triple_close = "\}\}\}"
                    let tclose = _substr_index(tpl, triple_close, tag + 3)
                    if tclose < 0 or tclose >= stop {
                        out = out + tpl.substring(tag, stop)
                        i = stop
                    } else {
                        let expr = _sanitize.trim(tpl.substring(tag + 3, tclose))
                        let looked = _tpl_lookup(ctx, expr)
                        let val = ""
                        if looked != null { val = "" + looked }
                        out = out + val   // raw — no escape_html
                        i = tclose + 3
                    }
                } else if marker == 35 {           // '#' block: if / each
                    let directive = _sanitize.trim(tpl.substring(tag + 3, close))
                    let after = close + 2
                    if directive.starts_with("if ") {
                        let res = _lumen_do_if(tpl, after, stop, ctx, _sanitize.trim(directive.substring(3, directive.len())))
                        out = out + _validate.get_field(res, "out")
                        i = _validate.get_field(res, "pos")
                    } else if directive.starts_with("each ") {
                        let res = _lumen_do_each(tpl, after, stop, ctx, _sanitize.trim(directive.substring(5, directive.len())))
                        out = out + _validate.get_field(res, "out")
                        i = _validate.get_field(res, "pos")
                    } else {
                        i = after
                    }
                } else if marker == 47 {           // '/' closing token: /if, /each
                    let token = "/" + _sanitize.trim(tpl.substring(tag + 3, close))
                    if _lumen_is_stop(token, stop_tags) {
                        return http.create_struct(["out", "pos", "tag"], [out, close + 2, token])
                    }
                    i = close + 2
                } else {
                    let inner = _sanitize.trim(tpl.substring(tag + 2, close))
                    if inner == "else" and _lumen_is_stop("else", stop_tags) {
                        return http.create_struct(["out", "pos", "tag"], [out, close + 2, "else"])
                    }
                    // {{ expr }} — escaped interpolation (safe by default)
                    let looked = _tpl_lookup(ctx, inner)
                    let val = ""
                    if looked != null { val = "" + looked }
                    out = out + _sanitize.escape_html(val)
                    i = close + 2
                }
            }
        }
    }
    return http.create_struct(["out", "pos", "tag"], [out, i, ""])
}

// {{#if expr}} body [{{else}} body] {{/if}}
fn _lumen_do_if(tpl, pos, stop, ctx, expr) {
    let truthy = _tpl_truthy(_tpl_lookup(ctx, expr))
    let first = _lumen_render_region(tpl, pos, stop, ctx, ["else", "/if"])
    let stopped = _validate.get_field(first, "tag")
    let out = ""
    if truthy { out = _validate.get_field(first, "out") }
    let cur = _validate.get_field(first, "pos")
    if stopped == "else" {
        let second = _lumen_render_region(tpl, cur, stop, ctx, ["/if"])
        if truthy == false { out = _validate.get_field(second, "out") }
        cur = _validate.get_field(second, "pos")
    }
    return http.create_struct(["out", "pos"], [out, cur])
}

// {{#each items as item}} body {{/each}}
fn _lumen_do_each(tpl, pos, stop, ctx, header) {
    let aspos = header.index_of(" as ")
    let list_expr = _sanitize.trim(header.substring(0, aspos))
    let var_name = _sanitize.trim(header.substring(aspos + 4, header.len()))
    let items = _tpl_lookup(ctx, list_expr)
    let out = ""
    let body_end = pos
    if items != null {
        for j in 0..items.len() {
            let child = _tpl_bind(ctx, var_name, items[j])
            let res = _lumen_render_region(tpl, pos, stop, child, ["/each"])
            out = out + _validate.get_field(res, "out")
            body_end = _validate.get_field(res, "pos")
        }
    }
    if body_end == pos {
        // Empty list: consume the body once so we land past {{/each}}.
        let res = _lumen_render_region(tpl, pos, stop, ctx, ["/each"])
        body_end = _validate.get_field(res, "pos")
    }
    return http.create_struct(["out", "pos"], [out, body_end])
}

let _lumen_active_child_states = null
let _lumen_component_names = []
let _lumen_components = []
// Global notification channel for async resource updates (capacity 64).
// Background resource tasks send `true` here when they finish fetching;
// _lumen_live_loop polls it to trigger re-renders.
let _lumen_async_updates = task.channel(64)
// Pub-sub registry: struct of topic → struct of key → value.
// All connections (tasks) share this; the single-threaded cooperative
// scheduler guarantees no races.
let _lumen_pubsub_data = http.create_struct([], [])
let _lumen_query_deps = http.create_struct([], [])
let _lumen_reactive_started = [false]
let _lumen_table_version = [http.create_struct([], [])]
let _lumen_qcache = [http.create_struct([], [])]
let _lumen_cache_stats = [http.create_struct(["hits", "misses"], [0, 0])]
let _lumen_watched_tables = [http.create_struct([], [])]

let _lumen_presence_data = http.create_struct([], [])
let _lumen_active_connections = []

fn _lumen_with_field(st, name, val) {
    let keys = _validate.get_keys(st)
    let vals = []
    let found = false
    for i in 0..keys.len() {
        if keys[i] == name {
            vals = vals.push(val)
            found = true
        } else {
            vals = vals.push(_validate.get_field(st, keys[i]))
        }
    }
    if found == false {
        keys = keys.push(name)
        vals = vals.push(val)
    }
    return http.create_struct(keys, vals)
}

fn lumen_presence_join(topic, user_id, meta) {
    let topic_pres = _validate.get_field(_lumen_presence_data, topic)
    if topic_pres == null {
        topic_pres = http.create_struct([], [])
    }
    topic_pres = _lumen_with_field(topic_pres, user_id, meta)
    _lumen_presence_data = _lumen_with_field(_lumen_presence_data, topic, topic_pres)
    _lumen_presence_broadcast(topic)
}

fn lumen_presence_leave(topic, user_id) {
    let topic_pres = _validate.get_field(_lumen_presence_data, topic)
    if topic_pres != null {
        let keys = _validate.get_keys(topic_pres)
        let nkeys = []
        let nvals = []
        for i in 0..keys.len() {
            if keys[i] != user_id {
                nkeys = nkeys.push(keys[i])
                nvals = nvals.push(_validate.get_field(topic_pres, keys[i]))
            }
        }
        topic_pres = http.create_struct(nkeys, nvals)
        _lumen_presence_data = _lumen_with_field(_lumen_presence_data, topic, topic_pres)
    }
    _lumen_presence_broadcast(topic)
}

fn lumen_presence_list(topic) {
    let topic_pres = _validate.get_field(_lumen_presence_data, topic)
    if topic_pres == null {
        return []
    }
    let keys = _validate.get_keys(topic_pres)
    let list = []
    for i in 0..keys.len() {
        let meta = _validate.get_field(topic_pres, keys[i])
        list = list.push(http.create_struct(["user_id", "meta"], [keys[i], meta]))
    }
    return list
}

fn _lumen_presence_broadcast(topic) {
    let plist = lumen_presence_list(topic)
    for i in 0.._lumen_active_connections.len() {
        let conn = _lumen_active_connections[i]
        if conn.topic == topic {
            let new_state = conn.state
            new_state = _lumen_with_field(new_state, "presence", plist)
            conn.state = new_state
            try {
                let html = (conn.component.render_fn)(new_state)
                let prev = conn.prev_html
                if prev != null and html != prev {
                    let res = _lumen_send_update(conn.ws, prev, html)
                    conn.prev_html = html
                }
            } catch e {}
        }
    }
}


fn lumen_register_component(name, component) {
    // Last registration wins: a user component overrides a built-in of the same
    // name (the built-in vocabulary registers first, at prelude load), and a
    // file recompiled by `vn dev` replaces its prior entry instead of stacking.
    for i in 0.._lumen_component_names.len() {
        if _lumen_component_names[i] == name {
            _lumen_components[i] = component
            return
        }
    }
    _lumen_component_names = _lumen_component_names.push(name)
    _lumen_components = _lumen_components.push(component)
}

fn _lumen_get_component(name) {
    for i in 0.._lumen_component_names.len() {
        if _lumen_component_names[i] == name {
            return _lumen_components[i]
        }
    }
    return null
}

// Rewrite `key={ expr }` to `key="{{ expr }}"` inside component opening tags.
// Uses brace-depth matching so nested braces (e.g. data={ {key: val} }) are
// handled correctly — finds the outer closing } rather than the first inner one.
fn _lumen_rewrite_prop_braces(html) {
    let out = []
    let i = 0
    let n = html.len()
    while i < n {
        let lt = html.index_of("<", i)
        if lt < 0 {
            out.append(html.substring(i, n))
            break
        }
        out.append(html.substring(i, lt))
        if lt + 1 < n {
            let nc = html.code_at(lt + 1)
            if nc >= 65 and nc <= 90 {
                let gt = html.index_of(">", lt)
                if gt < 0 {
                    out.append(html.substring(lt, n))
                    break
                }
                let tag_sub = html.substring(lt, gt + 1)
                let rew = []
                let j = 0
                let tn = tag_sub.len()
                while j < tn {
                    let eqb = tag_sub.index_of("={", j)
                    if eqb < 0 {
                        rew.append(tag_sub.substring(j, tn))
                        break
                    }
                    rew.append(tag_sub.substring(j, eqb + 1))
                    // Find matching closing brace with depth tracking
                    let depth = 1
                    let close = eqb + 2
                    let in_str = false
                    while close < tn and depth > 0 {
                        let cc = tag_sub.code_at(close)
                        if in_str {
                            if cc == 34 { in_str = false }  // "
                            if cc == 92 and close + 1 < tn { close = close + 1 }  // \
                        } else if cc == 34 {                // "
                            in_str = true
                        } else if cc == 123 {               // {
                            depth = depth + 1
                        } else if cc == 125 {               // }
                            depth = depth - 1
                        }
                        if depth > 0 { close = close + 1 }
                    }
                    if close >= tn or depth > 0 {
                        rew.append(tag_sub.substring(eqb + 1, tn))
                        break
                    }
                    let inner = _sanitize.trim(tag_sub.substring(eqb + 2, close))
                    rew.append("\"\{\{")
                    rew.append(inner)
                    rew.append("}}\"")
                    j = close + 1
                }
                out.append(rew.join(""))
                i = gt + 1
            } else {
                out.append("<")
                i = lt + 1
            }
        } else {
            out.append("<")
            i = lt + 1
        }
    }
    return out.join("")
}

fn _lumen_parse_attrs(attr_str) {
    let keys = []
    let vals = []
    let i = 0
    let n = attr_str.len()
    while i < n {
        while i < n and attr_str.code_at(i) <= 32 { i = i + 1 }
        if i >= n { break }
        let eq = attr_str.index_of("=", i)
        if eq < 0 { break }
        let key = _sanitize.trim(attr_str.substring(i, eq))
        let quote_pos = eq + 1
        while quote_pos < n and attr_str.code_at(quote_pos) <= 32 { quote_pos = quote_pos + 1 }
        if quote_pos >= n { break }
        let quote_char = attr_str.substring(quote_pos, quote_pos + 1)
        if quote_char != "\"" and quote_char != "'" { break }
        let close_quote = attr_str.index_of(quote_char, quote_pos + 1)
        if close_quote < 0 { break }
        let val = attr_str.substring(quote_pos + 1, close_quote)
        keys = keys.push(key)
        vals = vals.push(val)
        i = close_quote + 1
    }
    return http.create_struct(keys, vals)
}

fn _lumen_rewrite_child_events(html, child_id) {
    let events = ["click", "input", "change", "submit", "keydown", "keyup", "blur", "focus", "mouseover", "mouseout"]
    let out = html
    for i in 0..events.len() {
        let attr = "data-lumen-" + events[i] + "=\""
        out = _lumen_replace(out, attr, attr + child_id + ":")
    }
    return out
}

fn _lumen_process_composition(html, state) {
    let n = html.len()

    // M9 fast path: a component tag is a "<" followed by an uppercase letter.
    // If the markup has none (every leaf component, the common case), skip the
    // full char-by-char rebuild and its allocations — just return the input.
    let scan = 0
    let found_comp = false
    while scan < n {
        let lt = html.index_of("<", scan)
        if lt < 0 { break }
        if lt + 1 < n {
            let nc = html.code_at(lt + 1)
            if nc >= 65 and nc <= 90 { found_comp = true; break }
        }
        scan = lt + 1
    }
    if found_comp == false { return html }

    let out = ""
    let i = 0
    let child_counts = {}

    while i < n {
        let tag_start = html.index_of("<", i)
        if tag_start < 0 {
            out = out + html.substring(i, n)
            break
        }
        out = out + html.substring(i, tag_start)

        let is_comp = false
        if tag_start + 1 < n {
            let next_char = html.code_at(tag_start + 1)
            if next_char >= 65 and next_char <= 90 {
                is_comp = true
            }
        }

        if is_comp == false {
            out = out + "<"
            i = tag_start + 1
            continue
        }

        let tag_end = html.index_of(">", tag_start)
        if tag_end < 0 {
            out = out + html.substring(tag_start, n)
            break
        }

        let tag_content = html.substring(tag_start + 1, tag_end)
        let is_self_closing = false
        if tag_content.ends_with("/") {
            is_self_closing = true
            tag_content = tag_content.substring(0, tag_content.len() - 1)
        }

        let space_pos = tag_content.index_of(" ")
        let comp_name = ""
        let attrs_str = ""
        if space_pos < 0 {
            comp_name = _sanitize.trim(tag_content)
        } else {
            comp_name = _sanitize.trim(tag_content.substring(0, space_pos))
            attrs_str = tag_content.substring(space_pos + 1, tag_content.len())
        }

        let comp = _lumen_get_component(comp_name)
        if comp == null {
            let slash_str = ""
            if is_self_closing { slash_str = "/" }
            out = out + "<" + tag_content + slash_str + ">"
            i = tag_end + 1
            continue
        }

        let raw_attrs = _lumen_parse_attrs(attrs_str)
        let child_id = _validate.get_field(raw_attrs, "id")
        if child_id == null {
            let current_count = _validate.get_field(child_counts, comp_name)
            if current_count == null { current_count = 0 }
            child_id = comp_name + "_" + current_count
            child_counts = _tpl_bind(child_counts, comp_name, current_count + 1)
        }

        if _lumen_active_child_states == null {
            _lumen_active_child_states = {}
        }
        let child_state = _validate.get_field(_lumen_active_child_states, child_id)
        if child_state == null {
            child_state = (comp.state_fn)()
            child_state = _tpl_bind(child_state, "_comp", comp_name)
            child_state = _tpl_bind(child_state, "_id", child_id)
        }

        let attr_keys = _validate.get_keys(raw_attrs)
        for k in 0..attr_keys.len() {
            let key = attr_keys[k]
            if key != "id" {
                let val = _validate.get_field(raw_attrs, key)
                child_state = _tpl_bind(child_state, key, val)
            }
        }

        // ─── M6: slots ───
        // For a paired tag <Comp>..inner..</Comp>, the inner markup is the
        // component's `children`. It's already interpolated against the parent
        // context (composition runs after lumen_render's {{ }} pass), so we just
        // recursively process it for nested components, then inject it into the
        // child's {{! children }} slot AFTER the child's own events are scoped.
        // A placeholder keeps the two event scopes from colliding: the child's
        // own @events get the child_id prefix; the slot content (already final)
        // is spliced in untouched.
        let next_i = tag_end + 1
        let slot_html = ""
        let has_slot = false
        if is_self_closing == false {
            let close_tag = "</" + comp_name + ">"
            let close_tag_pos = html.index_of(close_tag, tag_end)
            if close_tag_pos >= 0 {
                let inner = html.substring(tag_end + 1, close_tag_pos)
                slot_html = _lumen_process_composition(inner, state)
                has_slot = true
                next_i = close_tag_pos + close_tag.len()
            }
        }
        if has_slot {
            child_state = _tpl_bind(child_state, "children", "<!--lumen-slot-->")
        }
        _lumen_active_child_states = _tpl_bind(_lumen_active_child_states, child_id, child_state)

        let child_html = (comp.render_fn)(child_state)
        let child_html_rewritten = _lumen_rewrite_child_events(child_html, child_id)
        if has_slot {
            child_html_rewritten = _lumen_replace(child_html_rewritten, "<!--lumen-slot-->", slot_html)
        }
        out = out + child_html_rewritten
        i = next_i
    }
    return out
}

// Escapes template text for embedding in a generated Varian string literal.
// Backed by the native `_lumen_escape_str` (O(n)); the old pure-Varian loop was
// O(n^2) and OOM-killed the compiler on large pages (docs/book pages). Kept as a
// thin wrapper so call sites and tests are unchanged.
fn _lumen_escape_string(s) {
    return _lumen_escape_str(s)
}

// True if `ch` (a single character) is an identifier character. Returns a real
// bool (an explicit if/return): `>=` yields an int 0/1 in Varian, and `0 ==
// false` is false, so callers that compare `== false` need a genuine boolean.
fn _lumen_is_ident_char(ch) {
    let alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    if alphabet.index_of(ch) >= 0 { return true }
    return false
}

// True if `name` is a plain identifier (non-empty, ident chars only). Guards the
// extractor against treating a stray `fn ` followed by junk as a handler.
fn _lumen_is_simple_ident(name) {
    if name.len() == 0 { return false }
    for k in 0..name.len() {
        if _lumen_is_ident_char(name.substring(k, k + 1)) == false { return false }
    }
    return true
}

fn _lumen_extract_fns(script) {
    // Collect top-level `fn name(...)` handler names from a component <script>.
    // The hard part is NOT line position (handlers can sit on one line with no
    // newlines, e.g. `}fn b(`) but distinguishing a real `fn` from one that
    // appears inside a string literal — code samples stored in an examples map
    // would otherwise register phantom handlers and crash the page. So we scan
    // structurally: a `fn ` only counts when we are NOT inside a string ("..."
    // or '...', escapes honored) and NOT inside a // or /* */ comment, and it
    // sits at a word boundary. `state` is the reserved init fn, never a handler.
    let names = []
    let n = script.len()
    let i = 0
    while i < n {
        let c = script.substring(i, i + 1)
        if c == "/" and i + 1 < n and script.substring(i + 1, i + 2) == "/" {
            let nl = script.index_of("\n", i)
            if nl < 0 { break }
            i = nl + 1
        } else if c == "/" and i + 1 < n and script.substring(i + 1, i + 2) == "*" {
            let close = script.index_of("*/", i + 2)
            if close < 0 { break }
            i = close + 2
        } else if c == "\"" or c == "'" {
            let quote = c
            i = i + 1
            while i < n {
                let d = script.substring(i, i + 1)
                if d == "\\" { i = i + 2 }
                else if d == quote { i = i + 1; break }
                else { i = i + 1 }
            }
        } else if c == "f" and i + 3 <= n and script.substring(i, i + 3) == "fn " {
            let boundary = (i == 0)
            if i > 0 {
                if _lumen_is_ident_char(script.substring(i - 1, i)) == false { boundary = true }
            }
            if boundary {
                let name_start = i + 3
                let open_paren = script.index_of("(", name_start)
                if open_paren > name_start {
                    let name = _sanitize.trim(script.substring(name_start, open_paren))
                    if name != "state" and _lumen_is_simple_ident(name) {
                        names = names.push(name)
                    }
                }
            }
            i = i + 3
        } else {
            i = i + 1
        }
    }
    return names
}

// ─── Lumen imports — explicit component dependencies ───
//
// A .lumen <script> may begin with import lines, the way Svelte/Vue SFCs do:
//
//     import Hero from "./components/Hero.lumen"     // a local component file
//     import { Button, Card, Stack } from "lumen/ui" // the built-in vocabulary
//
// This replaces the old "every file in pages/components is a magic global" model
// with a real dependency graph: a page declares what it uses, the build resolves
// and compiles exactly those files, and using a tag you never imported (and that
// isn't a built-in) is a build error instead of a silent global lookup.
//
// Imports are a *compiler* directive (handled here), not Varian syntax — they are
// stripped out before the <script> body is emitted as Varian, just like Svelte
// processes its own imports. Each import is a struct { names: [...], path: "..." }.

fn _lumen_parse_import_line(line) {
    // line already trimmed and known to start with "import ".
    let rest = _sanitize.trim(line.substring(7, line.len()))
    let from_pos = rest.index_of(" from ")
    if from_pos < 0 { return null }
    let lhs = _sanitize.trim(rest.substring(0, from_pos))
    let rhs = _sanitize.trim(rest.substring(from_pos + 6, rest.len()))

    // Path is the quoted string on the right.
    let q = rhs.index_of("\"")
    if q < 0 { q = rhs.index_of("'") }
    if q < 0 { return null }
    let qc = rhs.substring(q, q + 1)
    let q2 = rhs.index_of(qc, q + 1)
    if q2 < 0 { return null }
    let path = rhs.substring(q + 1, q2)

    // Names: either `Name` or `{ A, B, C }`.
    let names = []
    if lhs.starts_with("{") {
        let close = lhs.index_of("}")
        if close < 0 { close = lhs.len() }
        let inner = lhs.substring(1, close)
        let parts = inner.split(",")
        for i in 0..parts.len() {
            let nm = _sanitize.trim(parts[i])
            if nm != "" { names = names.push(nm) }
        }
    } else if lhs != "" {
        names = names.push(_sanitize.trim(lhs))
    }
    return http.create_struct(["names", "path"], [names, path])
}

// Pull the leading `import ... from "..."` block off the top of a script.
// Imports must come first (as in JS/Svelte): we scan only the import region
// line-by-line, then slice the rest of the script as the body in one shot — O(n),
// not the O(n^2) of rebuilding the body line-by-line (which OOM'd large pages).
// Returns { imports: [ {names,path}, ... ], body: "<script without the imports>" }.
fn _lumen_extract_imports(script) {
    let imports = []
    let n = script.len()
    let pos = 0
    let body_start = 0
    let scanning = true
    while scanning and pos < n {
        let nl = script.index_of("\n", pos)
        let line_end = nl
        if line_end < 0 { line_end = n }
        let line = _sanitize.trim(script.substring(pos, line_end))
        if line == "" {
            pos = line_end + 1
            body_start = pos
        } else if line.starts_with("import ") and line.index_of(" from ") >= 0 {
            let imp = _lumen_parse_import_line(line)
            if imp != null { imports = imports.push(imp) }
            pos = line_end + 1
            body_start = pos
        } else {
            scanning = false
        }
    }
    let body = script.substring(body_start, n)
    return http.create_struct(["imports", "body"], [imports, body])
}

fn _lumen_scope_selector(sel, comp_name) {
    let suffix = "[data-lumen-css=\"" + comp_name + "\"]"
    let parts = sel.split(" ")
    let out = ""
    for j in 0..parts.len() {
        if j > 0 { out = out + " " }
        let part = _sanitize.trim(parts[j])
        if part == "" { continue }
        if j == parts.len() - 1 {
            let colon_pos = part.index_of(":")
            if colon_pos >= 0 {
                out = out + part.substring(0, colon_pos) + suffix + part.substring(colon_pos, part.len())
            } else {
                out = out + part + suffix
            }
        } else {
            out = out + part
        }
    }
    return out
}

fn _lumen_scope_css(css, comp_name) {
    let out = []
    let i = 0
    let n = css.len()
    let last_rule_end = 0
    while i < n {
        let open_brace = css.index_of("{", i)
        if open_brace < 0 {
            out.append(css.substring(last_rule_end, n))
            break
        }

        let raw_selector = css.substring(last_rule_end, open_brace)
        let trimmed_selector = _sanitize.trim(raw_selector)
        let parsed_selector = ""

        if trimmed_selector.starts_with("@") {
            parsed_selector = raw_selector
        } else if trimmed_selector != "" {
            let selector_parts = trimmed_selector.split(",")
            let new_sel = ""
            for p in 0..selector_parts.len() {
                if p > 0 { new_sel = new_sel + ", " }
                let single_sel = _sanitize.trim(selector_parts[p])
                new_sel = new_sel + _lumen_scope_selector(single_sel, comp_name)
            }
            parsed_selector = new_sel
        }

        out.append(parsed_selector + " {")
        let close_brace = css.index_of("}", open_brace)
        if close_brace < 0 {
            out.append(css.substring(open_brace + 1, n))
            break
        }
        out.append(css.substring(open_brace + 1, close_brace + 1))
        last_rule_end = close_brace + 1
        i = last_rule_end
    }
    return out.join("")
}

fn _lumen_scope_html(html, comp_name) {
    let attr = "data-lumen-css=\"" + comp_name + "\""
    let out = []
    let i = 0
    let n = html.len()
    while i < n {
        let tag_start = html.index_of("<", i)
        if tag_start < 0 {
            out.append(html.substring(i, n))
            break
        }
        out.append(html.substring(i, tag_start))

        let is_opening = false
        if tag_start + 1 < n {
            let c = html.code_at(tag_start + 1)
            if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) {
                is_opening = true
            }
        }

        if tag_start + 1 < n {
            let next_c = html.substring(tag_start + 1, tag_start + 2)
            if next_c == "/" or next_c == "!" {
                is_opening = false
            }
        }

        if is_opening == false {
            out.append("<")
            i = tag_start + 1
            continue
        }

        let tag_end = -1
        let in_quote = false
        let quote_char = ""
        let scan = tag_start + 1
        while scan < n {
            let char_at = html.substring(scan, scan + 1)
            if in_quote {
                if char_at == quote_char {
                    in_quote = false
                }
            } else {
                if char_at == "\"" or char_at == "'" {
                    in_quote = true
                    quote_char = char_at
                } else if char_at == ">" {
                    tag_end = scan
                    break
                }
            }
            scan = scan + 1
        }

        if tag_end < 0 {
            out.append(html.substring(tag_start, n))
            break
        }

        let tag_content = html.substring(tag_start + 1, tag_end)
        let space_or_slash = tag_content.len()
        if tag_content.ends_with("/") {
            space_or_slash = tag_content.len() - 1
            let base_tag = tag_content.substring(0, space_or_slash)
            out.append("<" + base_tag + " " + attr + "/>")
        } else {
            out.append("<" + tag_content + " " + attr + ">")
        }

        i = tag_end + 1
    }
    return out.join("")
}

fn lumen_compile_source(name, lumen_src) {
    let temp_start = lumen_src.index_of("<template>")
    let temp_end = lumen_src.index_of("</template>")
    // The component's <script> is the SFC logic block, conventionally last —
    // use last_index_of so inline `<script src="...">` tags in the template
    // (scrollspy, syntax highlighters, analytics) aren't mistaken for it, and
    // find the matching close AFTER it (the first `</script>` in the file may
    // belong to one of those earlier `<script src>` tags).
    let script_start = lumen_src.last_index_of("<script>")
    let script_end = -1
    if script_start >= 0 {
        script_end = lumen_src.index_of("</script>", script_start)
    }

    if temp_start < 0 or temp_end < 0 or script_start < 0 or script_end < 0 {
        throw("Invalid .lumen file structure: must contain <template> and <script> tags")
    }

    let template = lumen_src.substring(temp_start + 10, temp_end)
    let script = lumen_src.substring(script_start + 8, script_end)

    // Strip Lumen `import ... from "..."` directives: they declare component
    // dependencies (resolved by the build, see _lumen_build_dir) and must not
    // leak into the emitted Varian, which has no such statement.
    script = _lumen_extract_imports(script).body

    // Optional CSS extraction. Only `<style scoped>` triggers per-component
    // selector rewriting + data-lumen-css attribute injection; a plain
    // `<style>` block is emitted unchanged as global CSS.
    let has_style = false
    let is_scoped = false
    let css = ""
    let tag_len = 7
    let style_start = lumen_src.index_of("<style scoped>")
    if style_start >= 0 {
        is_scoped = true
        tag_len = 14
    } else {
        style_start = lumen_src.index_of("<style>")
        tag_len = 7
    }
    let style_end = -1
    if style_start >= 0 {
        style_end = lumen_src.index_of("</style>")
        if style_end > style_start {
            has_style = true
            css = lumen_src.substring(style_start + tag_len, style_end)
        }
    }

    if has_style {
        if is_scoped {
            let scoped_css = _lumen_scope_css(css, name)
            template = _lumen_scope_html(template, name)
            template = template + "<style>" + scoped_css + "</style>"
        } else {
            template = template + "<style>" + css + "</style>"
        }
    }

    // ─── Client islands ───
    // Browser code remains explicit. Activation wrappers are emitted only for
    // the policies an author requests; a component without <client> ships none.
    let client_from = 0
    while true {
        let client_start = lumen_src.index_of("<client", client_from)
        if client_start < 0 { break }
        let client_open_end = lumen_src.index_of(">", client_start + 7)
        if client_open_end < 0 { throw("Lumen: unclosed <client> opening tag in " + name) }
        let client_end = lumen_src.index_of("</client>", client_open_end + 1)
        if client_end < 0 { throw("Lumen: missing </client> in " + name) }

        let client_attrs = lumen_src.substring(client_start + 7, client_open_end)
        let attrs = _lumen_parse_attrs(client_attrs)
        let client_lang = _validate.get_field(attrs, "lang")
        if client_lang != null and client_lang != "" and client_lang != "js" and client_lang != "javascript" {
            throw("Lumen: <client> accepts browser JavaScript; precompile '" + client_lang + "' before embedding it in " + name)
        }
        let policy = _validate.get_field(attrs, "when")
        if policy == null or policy == "" { policy = "load" }
        // Verbatim by contract. Lumen must not pretend a few regular
        // expressions are a JavaScript or TypeScript compiler.
        let client_js = lumen_src.substring(client_open_end + 1, client_end)
        let activated = client_js

        if policy == "idle" {
            activated = "(function(f)\{(window.requestIdleCallback||function(g)\{setTimeout(g,1)\})(f)\})(function()\{" + client_js + "\n\});"
        } else if policy == "visible" {
            let target = _validate.get_field(attrs, "target")
            let target_js = "null"
            if target != null and target != "" { target_js = json_encode(target) }
            activated = "(function(s,f)\{var q=" + target_js + ",t=q?document.querySelector(q):s.previousElementSibling;while(t&&(t.tagName==='SCRIPT'||t.tagName==='STYLE'))t=t.previousElementSibling;if(!t||!window.IntersectionObserver)\{f();return\}var o=new IntersectionObserver(function(e)\{if(e[0]&&e[0].isIntersecting)\{o.disconnect();f()\}\});o.observe(t)\})(document.currentScript,function()\{" + client_js + "\n\});"
        } else if policy == "media" {
            let query = _validate.get_field(attrs, "media")
            if query == null or query == "" { throw("Lumen: <client when=\"media\"> requires a media query in " + name) }
            activated = "(function(f)\{var m=matchMedia(" + json_encode(query) + ");if(m.matches)\{f();return\}var h=function(e)\{if(e.matches)\{m.removeEventListener('change',h);f()\}\};m.addEventListener('change',h)\})(function()\{" + client_js + "\n\});"
        } else if policy != "load" {
            throw("Lumen: unknown client activation policy '" + policy + "' in " + name)
        }

        template = template + "<script>" + activated + "</script>"
        client_from = client_end + 9
    }

    let escaped_tpl = _lumen_escape_string(template)

    let names = _lumen_extract_fns(script)
    let name_str = ""
    let fn_str = ""
    for idx in 0..names.len() {
        if idx > 0 {
            name_str = name_str + ", "
            fn_str = fn_str + ", "
        }
        name_str = name_str + "\"" + names[idx] + "\""
        fn_str = fn_str + names[idx]
    }

    let out = "// Auto-generated by Lumen compiler from " + name + "\n"
    out = out + "fn _lumen_init_component_" + name + "() \{\n"
    out = out + "    let _tpl = \"" + escaped_tpl + "\"\n"
    out = out + script + "\n"
    out = out + "    return lumen_component(\n"
    out = out + "        state,\n"
    out = out + "        |s| \{ return lumen_render(_tpl, s) \},\n"
    out = out + "        [" + name_str + "],\n"
    out = out + "        [" + fn_str + "]\n"
    out = out + "    )\n"
    out = out + "\}\n"
    out = out + "lumen_register_component(\"" + name + "\", _lumen_init_component_" + name + "())\n"
    return out
}

fn lumen_compile_file(lumen_path, vn_path) {
    let src = io.read_text(lumen_path)
    if src == null {
        throw("Could not read .lumen file: " + lumen_path)
    }
    let slash = lumen_path.last_index_of("/")
    let file_part = lumen_path
    if slash >= 0 {
        file_part = lumen_path.substring(slash + 1, lumen_path.len())
    }
    let dot = file_part.index_of(".lumen")
    let name = file_part.substring(0, dot)
    let code = lumen_compile_source(name, src)
    io.write_text(vn_path, code)
}


// ─── Public API (Milestone 1) ───

// Render a Lumen template string against a context struct -> HTML string.
fn lumen_render(template, ctx) {
    let tpl2 = _lumen_rewrite_prop_braces(template)
    let res = _lumen_render_region(tpl2, 0, tpl2.len(), ctx, null)
    let raw_html = _lumen_bind_events(_validate.get_field(res, "out"))
    return _lumen_process_composition(raw_html, ctx)
}

// Convenience: a 200 text/html Response from a rendered Lumen template.
// Built with http.create_struct (not a `Response { }` literal) so this module
// doesn't depend on zenith.vn's struct declarations being parsed first — the
// vn_modules prelude order isn't guaranteed, and struct literals resolve their
// type at parse time while function calls resolve at runtime.
fn lumen_render_response(template, ctx) {
    return http.create_struct(
        ["status", "body", "content_type"],
        [200, lumen_render(template, ctx), "text/html"]
    )
}

// ─── Lumen store: shared mutable state (Zustand-style) ───
// `lumen_store(initial)` returns { get, set, all }.
// A store created inside state() is per-connection; at module top-level it is
// app-global (shared across all connections).
fn lumen_store(initial) {
    let holder = [initial]
    let get = |key| { return _validate.get_field(holder[0], key) }
    let set = |key, value| { holder[0] = _tpl_bind(holder[0], key, value); return null }
    let all = | | { return holder[0] }
    return http.create_struct(["get", "set", "all"], [get, set, all])
}

// ─── Pillar 1: reactive tick — drain DB changes, refetch dependent live
// queries, then wake all live loops so they re-render + morph. Driven by a
// single background task on a 30ms cadence (coalesces bulk writes). ───
fn _lumen_reactive_tick() {
    let tables = sqlite.drain_changes()
    if tables == null { return null }
    if tables.len() == 0 { return null }
    _lumen_bump_versions(tables)
    let any = false
    let ti = 0
    while ti < tables.len() {
        let deps = _validate.get_field(_lumen_query_deps, tables[ti])
        if deps != null {
            let di = 0
            while di < deps.len() {
                let refetch = deps[di]
                let _ = (refetch)()
                any = true
                di = di + 1
            }
        }
        ti = ti + 1
    }
    let wi = 0
    while wi < tables.len() {
        if _validate.get_field(_lumen_watched_tables[0], tables[wi]) != null { any = true }
        wi = wi + 1
    }
    if any { let _ = _lumen_async_updates <- true }
    return null
}

fn _lumen_ensure_reactive() {
    if _lumen_reactive_started[0] { return null }
    _lumen_reactive_started[0] = true
    let driver = | | {
        while true {
            _lumen_reactive_tick()
            task.sleep(30)
        }
    }
    let _ = task.spawn(driver, [])
    return null
}

fn live_query(fetcher) {
    _lumen_ensure_reactive()
    capture_start()
    let res = lumen_resource(fetcher)
    let tables = capture_end()
    let i = 0
    while i < tables.len() {
        let tbl = tables[i]
        let cur = _validate.get_field(_lumen_query_deps, tbl)
        if cur == null { cur = [] }
        cur = cur.push(_validate.get_field(res, "refetch"))
        _lumen_query_deps = _tpl_bind(_lumen_query_deps, tbl, cur)
        i = i + 1
    }
    return res
}

// ─── Pillar 2: headless data_table — server-driven, live, sortable, paginated.
// Build SQL via the db query builder, run it through the connection WRAPPER
// (so Pillar-1 read-set capture registers the table), wrapped in live_query so
// rows auto-update on DB change. Returns a headless core (TanStack-style):
//   let dt = data_table({ conn: db, table: "users",
//                         columns: [ {name:"id",label:"ID",sortable:true}, ... ],
//                         page_size: 25, order_by: "id", order_dir: "desc", filters: [] })
//   render:  each (dt.rows)() ...      handler: (dt.set_sort)("name")
fn _data_table_identifier(name) {
    if name == null or name == "" { return false }
    let segment_start = true
    for i in 0..name.len() {
        let c = name.substring(i, i + 1)
        if c == "." {
            if segment_start { return false }
            segment_start = true
        } else {
            if _lumen_is_ident_char(c) == false { return false }
            let code = c.code_at(0)
            if segment_start and code >= 48 and code <= 57 { return false }
            segment_start = false
        }
    }
    return segment_start == false
}

fn _data_table_column(columns, field, require_sortable) {
    if field == null { return false }
    for i in 0..columns.len() {
        if _validate.get_field(columns[i], "name") == field {
            if require_sortable and _validate.get_field(columns[i], "sortable") != true { return false }
            return true
        }
    }
    return false
}

fn _data_table_validate_filters(columns, filters) {
    let allowed = ["=", "!=", "<>", "<", "<=", ">", ">=", "LIKE"]
    for i in 0..filters.len() {
        let field = _validate.get_field(filters[i], "field")
        let op = _validate.get_field(filters[i], "op")
        if _data_table_column(columns, field, false) == false {
            throw("Lumen table: unknown filter column '" + field + "'")
        }
        let valid_op = false
        for j in 0..allowed.len() { if op == allowed[j] { valid_op = true } }
        if valid_op == false { throw("Lumen table: unsafe filter operator '" + op + "'") }
    }
    return true
}

fn _data_table_validate_contract(table, columns, filters, initial_sort) {
    if _data_table_identifier(table) == false { throw("Lumen table: unsafe table identifier") }
    for i in 0..columns.len() {
        if _data_table_identifier(_validate.get_field(columns[i], "name")) == false {
            throw("Lumen table: unsafe column identifier")
        }
    }
    _data_table_validate_filters(columns, filters)
    if initial_sort != null and _data_table_column(columns, initial_sort, true) == false {
        throw("Lumen table: sort column must be declared sortable")
    }
    return true
}

fn data_table(opts) {
    let conn = _validate.get_field(opts, "conn")
    let table = _validate.get_field(opts, "table")
    let columns = _validate.get_field(opts, "columns")
    if columns == null { columns = [] }
    let page_size = _validate.get_field(opts, "page_size")
    if page_size == null { page_size = 25 }

    // state holders (1-element arrays = the .vn mutable-cell idiom)
    let st_sort = [_validate.get_field(opts, "order_by")]
    let st_dir = ["asc"]
    let init_dir = _validate.get_field(opts, "order_dir")
    if init_dir != null { st_dir[0] = init_dir }
    let st_page = [1]
    let st_filters = [_validate.get_field(opts, "filters")]
    if st_filters[0] == null { st_filters[0] = [] }
    _data_table_validate_contract(table, columns, st_filters[0], st_sort[0])

    // column name list for SELECT (fall back to "*")
    let col_names = []
    let ci = 0
    while ci < columns.len() {
        let cn = _validate.get_field(columns[ci], "name")
        if cn != null { col_names = col_names.push(cn) }
        ci = ci + 1
    }
    if col_names.len() == 0 { col_names = ["*"] }

    let fetcher = | | {
        let q = db.select(table)
        q = q.fields(col_names)
        let params = []
        let fs = st_filters[0]
        let fi = 0
        while fi < fs.len() {
            let f = fs[fi]
            q = q.where(_validate.get_field(f, "field"), _validate.get_field(f, "op"))
            params = params.push(_validate.get_field(f, "value"))
            fi = fi + 1
        }
        if st_sort[0] != null { q = q.order_by(st_sort[0], st_dir[0]) }
        q = q.paginate(st_page[0], page_size)
        let compiled = q.build()
        // run through the connection wrapper so read-set capture sees the table
        return (conn.query)(compiled.sql, params)
    }

    let res = live_query(fetcher)

    let rows = | | {
        let s = (res.state)()
        if s.data == null { return [] }
        return s.data
    }
    let meta = | | {
        return http.create_struct(
            ["page", "page_size", "sort", "dir", "loading", "error"],
            [st_page[0], page_size, st_sort[0], st_dir[0], (res.state)().loading, (res.state)().error]
        )
    }
    let _apply = | | {
        let _ = (res.refetch)()
        let _ = _lumen_async_updates <- true
        return null
    }
    let set_sort = |field| {
        if _data_table_column(columns, field, true) == false { return null }
        if st_sort[0] == field {
            if st_dir[0] == "asc" { st_dir[0] = "desc" } else { st_dir[0] = "asc" }
        } else {
            st_sort[0] = field
            st_dir[0] = "asc"
        }
        st_page[0] = 1
        return (_apply)()
    }
    let set_filter = |filters| {
        _data_table_validate_filters(columns, filters)
        st_filters[0] = filters
        st_page[0] = 1
        return (_apply)()
    }
    let next_page = | | {
        st_page[0] = st_page[0] + 1
        return (_apply)()
    }
    let prev_page = | | {
        if st_page[0] > 1 { st_page[0] = st_page[0] - 1 }
        return (_apply)()
    }
    let reload = | | { return (_apply)() }

    return http.create_struct(
        ["rows", "meta", "columns", "set_sort", "set_filter", "next_page", "prev_page", "reload"],
        [rows, meta, columns, set_sort, set_filter, next_page, prev_page, reload]
    )
}

// ─── Pillar 2: render a data_table core to live HTML (sortable headers + pager).
// Built as a plain HTML string then passed through lumen_render so @click binds.
// Header buttons carry value="<col>" so the clicked column name reaches the
// |s,v| sort handler (the client sends el.value).
fn _data_table_html(core) {
    let cols = core.columns
    let rows = (core.rows)()
    let m = (core.meta)()

    let head = "<thead><tr>"
    let ci = 0
    while ci < cols.len() {
        let col = cols[ci]
        let cname = _validate.get_field(col, "name")
        let clabel = _validate.get_field(col, "label")
        if clabel == null { clabel = cname }
        let sortable = _validate.get_field(col, "sortable")
        if sortable {
            let arrow = ""
            if m.sort == cname {
                if m.dir == "desc" { arrow = " ▼" } else { arrow = " ▲" }
            }
            head = head + "<th class=\"lmn-th\"><button class=\"lmn-th-btn\" @click=\"dt_sort\" value=\"" + cname + "\">" + _sanitize.escape_html(clabel) + arrow + "</button></th>"
        } else {
            head = head + "<th class=\"lmn-th\">" + _sanitize.escape_html(clabel) + "</th>"
        }
        ci = ci + 1
    }
    head = head + "</tr></thead>"

    let body = "<tbody>"
    if m.loading {
        body = body + "<tr><td class=\"lmn-td lmn-td-msg\" colspan=\"" + cols.len() + "\">Loading…</td></tr>"
    } else {
        if m.error != null {
            body = body + "<tr><td class=\"lmn-td lmn-td-msg\" colspan=\"" + cols.len() + "\">" + _sanitize.escape_html("" + m.error) + "</td></tr>"
        } else {
            if rows.len() == 0 {
                body = body + "<tr><td class=\"lmn-td lmn-td-msg\" colspan=\"" + cols.len() + "\">No rows.</td></tr>"
            } else {
                let ri = 0
                while ri < rows.len() {
                    let row = rows[ri]
                    body = body + "<tr>"
                    let cj = 0
                    while cj < cols.len() {
                        let cn = _validate.get_field(cols[cj], "name")
                        let cell = _validate.get_field(row, cn)
                        let txt = ""
                        if cell != null { txt = _sanitize.escape_html("" + cell) }
                        body = body + "<td class=\"lmn-td\">" + txt + "</td>"
                        cj = cj + 1
                    }
                    body = body + "</tr>"
                    ri = ri + 1
                }
            }
        }
    }
    body = body + "</tbody>"

    let pager = "<div class=\"lmn-pager\">" +
        "<button class=\"lmn-pager-btn\" @click=\"dt_prev\">Prev</button>" +
        "<span class=\"lmn-pager-info\">Page " + m.page + "</span>" +
        "<button class=\"lmn-pager-btn\" @click=\"dt_next\">Next</button>" +
        "</div>"

    let html = "<div class=\"lmn-table-wrap\"><table class=\"lmn-table\">" + head + body + "</table>" + pager + "</div>"
    return lumen_render(html, {})
}

// ─── Pillar 2: build a live, mountable data-table component over a DB table.
// Usage (like examples/lumen_counter.vn):
//   let conn = db.connect("sqlite", "app.db")
//   let users = data_table_component({ conn: conn, table: "users",
//       columns: [ {name:"id",label:"ID",sortable:true}, {name:"email",label:"Email",sortable:true} ],
//       page_size: 25, order_by: "id", order_dir: "desc" })
//   lumen_mount(app, "/users", users)
// It auto-updates when the underlying table changes (built on live_query).
fn data_table_component(opts) {
    let conn = _validate.get_field(opts, "conn")
    let table = _validate.get_field(opts, "table")
    let columns = _validate.get_field(opts, "columns")
    if columns == null { columns = [] }
    let page_size = _validate.get_field(opts, "page_size")
    if page_size == null { page_size = 25 }
    let init_sort = _validate.get_field(opts, "order_by")
    let init_dir = _validate.get_field(opts, "order_dir")
    if init_dir == null { init_dir = "asc" }
    let filters = _validate.get_field(opts, "filters")
    if filters == null { filters = [] }
    _data_table_validate_contract(table, columns, filters, init_sort)
    let cfg = http.create_struct(
        ["conn", "table", "columns", "page_size", "filters"],
        [conn, table, columns, page_size, filters]
    )
    _lumen_watch_table(table)

    let state_fn = | | {
        return http.create_struct(["dt_sort", "dt_dir", "dt_page"], [init_sort, init_dir, 1])
    }
    let render_fn = |s| { return _render_dt_live(cfg, s) }
    let handler_names = ["dt_sort", "dt_next", "dt_prev", "dt_reload"]
    let handler_fns = [
        |s, v| {
            if _data_table_column(columns, v, true) == false { return s }
            if s.dt_sort == v {
                if s.dt_dir == "asc" { s.dt_dir = "desc" } else { s.dt_dir = "asc" }
            } else {
                s.dt_sort = v
                s.dt_dir = "asc"
            }
            s.dt_page = 1
            return s
        },
        |s, v| { s.dt_page = s.dt_page + 1; return s },
        |s, v| { if s.dt_page > 1 { s.dt_page = s.dt_page - 1 } return s },
        |s, v| { return s }
    ]
    return lumen_component(state_fn, render_fn, handler_names, handler_fns)
}

// Render the per-connection table from cfg (captured config) + s (per-conn state).
fn _render_dt_live(cfg, s) {
    let conn = _validate.get_field(cfg, "conn")
    let table = _validate.get_field(cfg, "table")
    let columns = _validate.get_field(cfg, "columns")
    let page_size = _validate.get_field(cfg, "page_size")
    let filters = _validate.get_field(cfg, "filters")
    let sort = _validate.get_field(s, "dt_sort")
    let dir = _validate.get_field(s, "dt_dir")
    if dir == null { dir = "asc" }
    let page = _validate.get_field(s, "dt_page")
    if page == null { page = 1 }

    let col_names = []
    let ci = 0
    while ci < columns.len() {
        let cn = _validate.get_field(columns[ci], "name")
        if cn != null { col_names = col_names.push(cn) }
        ci = ci + 1
    }
    if col_names.len() == 0 { col_names = ["*"] }

    let q = db.select(table).fields(col_names)
    let params = []
    let fi = 0
    while fi < filters.len() {
        let f = filters[fi]
        q = q.where(_validate.get_field(f, "field"), _validate.get_field(f, "op"))
        params = params.push(_validate.get_field(f, "value"))
        fi = fi + 1
    }
    if sort != null { q = q.order_by(sort, dir) }
    q = q.paginate(page, page_size)
    let compiled = q.build()

    let rows = []
    let err = null
    try { rows = cached_query(conn, compiled.sql, params, [table]) } catch e { err = "" + e }

    let ncols = columns.len()
    let head = "<thead><tr>"
    let hi = 0
    while hi < ncols {
        let col = columns[hi]
        let cname = _validate.get_field(col, "name")
        let clabel = _validate.get_field(col, "label")
        if clabel == null { clabel = cname }
        let sortable = _validate.get_field(col, "sortable")
        if sortable {
            let arrow = ""
            if sort == cname {
                if dir == "desc" { arrow = " ▼" } else { arrow = " ▲" }
            }
            head = head + "<th class=\"lmn-th\"><button class=\"lmn-th-btn\" @click=\"dt_sort\" value=\"" + cname + "\">" + _sanitize.escape_html("" + clabel) + arrow + "</button></th>"
        } else {
            head = head + "<th class=\"lmn-th\">" + _sanitize.escape_html("" + clabel) + "</th>"
        }
        hi = hi + 1
    }
    head = head + "</tr></thead>"

    let body = "<tbody>"
    if err != null {
        body = body + "<tr><td class=\"lmn-td lmn-td-msg\" colspan=\"" + ncols + "\">" + _sanitize.escape_html(err) + "</td></tr>"
    } else {
        if rows.len() == 0 {
            body = body + "<tr><td class=\"lmn-td lmn-td-msg\" colspan=\"" + ncols + "\">No rows.</td></tr>"
        } else {
            let ri = 0
            while ri < rows.len() {
                let row = rows[ri]
                body = body + "<tr>"
                let cj = 0
                while cj < ncols {
                    let cn2 = _validate.get_field(columns[cj], "name")
                    let cell = _validate.get_field(row, cn2)
                    let txt = ""
                    if cell != null { txt = _sanitize.escape_html("" + cell) }
                    body = body + "<td class=\"lmn-td\">" + txt + "</td>"
                    cj = cj + 1
                }
                body = body + "</tr>"
                ri = ri + 1
            }
        }
    }
    body = body + "</tbody>"

    let pager = "<div class=\"lmn-pager\"><button class=\"lmn-pager-btn\" @click=\"dt_prev\">Prev</button><span class=\"lmn-pager-info\">Page " + page + "</span><button class=\"lmn-pager-btn\" @click=\"dt_next\">Next</button></div>"
    let html = "<div class=\"lmn-table-wrap\"><table class=\"lmn-table\">" + head + body + "</table>" + pager + "</div>"
    return lumen_render(html, {})
}

// ─── Pillar 2 Chunk 3: VIRTUAL (windowed) data table. Renders only the rows
// scrolled into view (limit/offset driven by the client's scroll position) plus
// spacer rows that fake the full scroll height — so a million-row table ships
// only ~40 <tr> at a time. Live via live_query; a live COUNT(*) tracks height.
fn data_table_virtual(opts) {
    let conn = _validate.get_field(opts, "conn")
    let table = _validate.get_field(opts, "table")
    let columns = _validate.get_field(opts, "columns")
    if columns == null { columns = [] }
    let row_height = _validate.get_field(opts, "row_height")
    if row_height == null { row_height = 36 }
    let viewport_height = _validate.get_field(opts, "viewport_height")
    if viewport_height == null { viewport_height = 480 }

    let st_sort = [_validate.get_field(opts, "order_by")]
    let st_dir = ["asc"]
    let init_dir = _validate.get_field(opts, "order_dir")
    if init_dir != null { st_dir[0] = init_dir }
    let st_filters = [_validate.get_field(opts, "filters")]
    if st_filters[0] == null { st_filters[0] = [] }
    _data_table_validate_contract(table, columns, st_filters[0], st_sort[0])
    let st_first = [0]
    let st_count = [40]
    let initc = _validate.get_field(opts, "window_count")
    if initc != null { st_count[0] = initc }

    let col_names = []
    let ci = 0
    while ci < columns.len() {
        let cn = _validate.get_field(columns[ci], "name")
        if cn != null { col_names = col_names.push(cn) }
        ci = ci + 1
    }
    if col_names.len() == 0 { col_names = ["*"] }

    // apply current filters to a builder; returns { q, params }
    let _apply_filters = |q| {
        let params = []
        let fs = st_filters[0]
        let fi = 0
        while fi < fs.len() {
            let f = fs[fi]
            q = q.where(_validate.get_field(f, "field"), _validate.get_field(f, "op"))
            params = params.push(_validate.get_field(f, "value"))
            fi = fi + 1
        }
        return http.create_struct(["q", "params"], [q, params])
    }

    let fetcher = | | {
        let q0 = db.select(table).fields(col_names)
        let bound = (_apply_filters)(q0)
        let q = bound.q
        if st_sort[0] != null { q = q.order_by(st_sort[0], st_dir[0]) }
        q = q.limit(st_count[0])
        q = q.offset(st_first[0])
        let compiled = q.build()
        return (conn.query)(compiled.sql, bound.params)
    }
    let res = live_query(fetcher)

    let count_fetcher = | | {
        let q0 = db.select(table).fields(["COUNT(*) AS n"])
        let bound = (_apply_filters)(q0)
        let cc = bound.q.build()
        return (conn.query)(cc.sql, bound.params)
    }
    let count_res = live_query(count_fetcher)

    let rows = | | {
        let s = (res.state)()
        if s.data == null { return [] }
        return s.data
    }
    let total = | | {
        let s = (count_res.state)()
        if s.data == null { return 0 }
        if s.data.len() == 0 { return 0 }
        let n = _validate.get_field(s.data[0], "n")
        if n == null { return 0 }
        return n
    }
    let meta = | | {
        return http.create_struct(
            ["first", "count", "row_height", "viewport_height", "sort", "dir", "total", "loading", "error"],
            [st_first[0], st_count[0], row_height, viewport_height, st_sort[0], st_dir[0], (total)(), (res.state)().loading, (res.state)().error]
        )
    }
    let _wake = | | {
        let _ = (res.refetch)()
        let _ = _lumen_async_updates <- true
        return null
    }
    let _wake_all = | | {
        let _ = (res.refetch)()
        let _ = (count_res.refetch)()
        let _ = _lumen_async_updates <- true
        return null
    }
    let set_window = |first, count| {
        if first < 0 { first = 0 }
        st_first[0] = first
        if count != null and count > 0 { st_count[0] = count }
        return (_wake)()
    }
    let set_sort = |field| {
        if _data_table_column(columns, field, true) == false { return null }
        if st_sort[0] == field {
            if st_dir[0] == "asc" { st_dir[0] = "desc" } else { st_dir[0] = "asc" }
        } else {
            st_sort[0] = field
            st_dir[0] = "asc"
        }
        st_first[0] = 0
        return (_wake)()
    }
    let set_filter = |filters| {
        _data_table_validate_filters(columns, filters)
        st_filters[0] = filters
        st_first[0] = 0
        return (_wake_all)()
    }
    let reload = | | { return (_wake_all)() }

    return http.create_struct(
        ["rows", "meta", "columns", "total", "set_window", "set_sort", "set_filter", "reload"],
        [rows, meta, columns, total, set_window, set_sort, set_filter, reload]
    )
}

// Render a virtual data_table core to live HTML: a fixed-height scroller whose
// <tbody> holds a top spacer row (height = first*row_height), the visible window
// of rows, and a bottom spacer row — so the scrollbar reflects the full dataset
// while the DOM stays small. data-lumen-vtable + data-row-h drive the client JS.
fn _data_table_virtual_html(core) {
    let cols = core.columns
    let rows = (core.rows)()
    let m = (core.meta)()
    let rh = m.row_height
    let first = m.first
    let total = m.total
    let ncols = cols.len()

    let head = "<thead><tr>"
    let ci = 0
    while ci < ncols {
        let col = cols[ci]
        let cname = _validate.get_field(col, "name")
        let clabel = _validate.get_field(col, "label")
        if clabel == null { clabel = cname }
        let sortable = _validate.get_field(col, "sortable")
        if sortable {
            let arrow = ""
            if m.sort == cname {
                if m.dir == "desc" { arrow = " ▼" } else { arrow = " ▲" }
            }
            head = head + "<th class=\"lmn-th\"><button class=\"lmn-th-btn\" @click=\"dt_sort\" value=\"" + cname + "\">" + _sanitize.escape_html(clabel) + arrow + "</button></th>"
        } else {
            head = head + "<th class=\"lmn-th\">" + _sanitize.escape_html(clabel) + "</th>"
        }
        ci = ci + 1
    }
    head = head + "</tr></thead>"

    let body = "<tbody>"
    let top_h = first * rh
    if top_h > 0 {
        body = body + "<tr class=\"lmn-vspace\" style=\"height:" + top_h + "px\"><td colspan=\"" + ncols + "\"></td></tr>"
    }
    if m.loading and rows.len() == 0 {
        body = body + "<tr><td class=\"lmn-td lmn-td-msg\" colspan=\"" + ncols + "\">Loading…</td></tr>"
    } else {
        if m.error != null {
            body = body + "<tr><td class=\"lmn-td lmn-td-msg\" colspan=\"" + ncols + "\">" + _sanitize.escape_html("" + m.error) + "</td></tr>"
        } else {
            let ri = 0
            while ri < rows.len() {
                let row = rows[ri]
                body = body + "<tr style=\"height:" + rh + "px\">"
                let cj = 0
                while cj < ncols {
                    let cn = _validate.get_field(cols[cj], "name")
                    let cell = _validate.get_field(row, cn)
                    let txt = ""
                    if cell != null { txt = _sanitize.escape_html("" + cell) }
                    body = body + "<td class=\"lmn-td\">" + txt + "</td>"
                    cj = cj + 1
                }
                body = body + "</tr>"
                ri = ri + 1
            }
        }
    }
    let shown = rows.len()
    let bottom_rows = total - first - shown
    if bottom_rows > 0 {
        let bottom_h = bottom_rows * rh
        body = body + "<tr class=\"lmn-vspace\" style=\"height:" + bottom_h + "px\"><td colspan=\"" + ncols + "\"></td></tr>"
    }
    body = body + "</tbody>"

    let wrap = "<div class=\"lmn-table-wrap lmn-vtable\" data-lumen-vtable data-row-h=\"" + rh + "\" style=\"height:" + m.viewport_height + "px;overflow:auto\"><table class=\"lmn-table\">" + head + body + "</table></div>"
    return lumen_render(wrap, {})
}

// Build a live, mountable VIRTUAL (windowed) data-table component. Same usage as
// data_table_component but for huge tables — only the scrolled window is shipped.
//   let big = data_table_virtual_component({ conn: conn, table: "events",
//       columns: [...], row_height: 36, viewport_height: 480 })
//   lumen_mount(app, "/events", big)
fn data_table_virtual_component(opts) {
    let conn = _validate.get_field(opts, "conn")
    let table = _validate.get_field(opts, "table")
    let columns = _validate.get_field(opts, "columns")
    if columns == null { columns = [] }
    let row_height = _validate.get_field(opts, "row_height")
    if row_height == null { row_height = 36 }
    let viewport_height = _validate.get_field(opts, "viewport_height")
    if viewport_height == null { viewport_height = 480 }
    let init_sort = _validate.get_field(opts, "order_by")
    let init_dir = _validate.get_field(opts, "order_dir")
    if init_dir == null { init_dir = "asc" }
    let filters = _validate.get_field(opts, "filters")
    if filters == null { filters = [] }
    _data_table_validate_contract(table, columns, filters, init_sort)

    let cfg = http.create_struct(
        ["conn", "table", "columns", "row_height", "viewport_height"],
        [conn, table, columns, row_height, viewport_height]
    )
    _lumen_watch_table(table)

    let state_fn = | | {
        return http.create_struct(["first", "count", "sort", "dir", "filters"],
            [0, 40, init_sort, init_dir, filters])
    }
    let render_fn = |s| { return _render_dt_virtual_live(cfg, s) }
    let handler_names = ["dt_window", "dt_sort", "dt_reload"]
    let handler_fns = [
        |s, v| {
            if _data_table_column(columns, v, true) == false { return s }
            let f = _validate.get_field(v, "f")
            let c = _validate.get_field(v, "c")
            if f < 0 { f = 0 }
            s.first = f
            if c != null and c > 0 { s.count = c }
            return s
        },
        |s, v| {
            if s.sort == v {
                if s.dir == "asc" { s.dir = "desc" } else { s.dir = "asc" }
            } else {
                s.sort = v
                s.dir = "asc"
            }
            s.first = 0
            return s
        },
        |s, v| { return s }
    ]
    return lumen_component(state_fn, render_fn, handler_names, handler_fns)
}

fn _render_dt_virtual_live(cfg, s) {
    let conn = _validate.get_field(cfg, "conn")
    let table = _validate.get_field(cfg, "table")
    let columns = _validate.get_field(cfg, "columns")
    let row_height = _validate.get_field(cfg, "row_height")
    let viewport_height = _validate.get_field(cfg, "viewport_height")
    let sort = _validate.get_field(s, "sort")
    let dir = _validate.get_field(s, "dir")
    if dir == null { dir = "asc" }
    let first = _validate.get_field(s, "first")
    if first == null { first = 0 }
    let count = _validate.get_field(s, "count")
    if count == null { count = 40 }
    let filters = _validate.get_field(s, "filters")
    if filters == null { filters = [] }

    let col_names = []
    let ci = 0
    while ci < columns.len() {
        let cn = _validate.get_field(columns[ci], "name")
        if cn != null { col_names = col_names.push(cn) }
        ci = ci + 1
    }
    if col_names.len() == 0 { col_names = ["*"] }

    let count_q = db.select(table).fields(["COUNT(*) AS n"])
    let count_params = []
    let cfi = 0
    while cfi < filters.len() {
        let f = filters[cfi]
        count_q = count_q.where(_validate.get_field(f, "field"), _validate.get_field(f, "op"))
        count_params = count_params.push(_validate.get_field(f, "value"))
        cfi = cfi + 1
    }
    let count_compiled = count_q.build()
    let total_rows = 0
    try {
        let cr = cached_query(conn, count_compiled.sql, count_params, [table])
        if cr != null and cr.len() > 0 {
            let n = _validate.get_field(cr[0], "n")
            if n != null { total_rows = n }
        }
    } catch e {}

    let data_q = db.select(table).fields(col_names)
    let data_params = []
    let dfi = 0
    while dfi < filters.len() {
        let f = filters[dfi]
        data_q = data_q.where(_validate.get_field(f, "field"), _validate.get_field(f, "op"))
        data_params = data_params.push(_validate.get_field(f, "value"))
        dfi = dfi + 1
    }
    if sort != null { data_q = data_q.order_by(sort, dir) }
    data_q = data_q.limit(count)
    data_q = data_q.offset(first)
    let data_compiled = data_q.build()
    let rows = []
    let err = null
    try { rows = cached_query(conn, data_compiled.sql, data_params, [table]) } catch e { err = "" + e }

    let ncols = columns.len()
    let head = "<thead><tr>"
    let hi = 0
    while hi < ncols {
        let col = columns[hi]
        let cname = _validate.get_field(col, "name")
        let clabel = _validate.get_field(col, "label")
        if clabel == null { clabel = cname }
        let sortable = _validate.get_field(col, "sortable")
        if sortable {
            let arrow = ""
            if sort == cname {
                if dir == "desc" { arrow = " ▼" } else { arrow = " ▲" }
            }
            head = head + "<th class=\"lmn-th\"><button class=\"lmn-th-btn\" @click=\"dt_sort\" value=\"" + cname + "\">" + _sanitize.escape_html("" + clabel) + arrow + "</button></th>"
        } else {
            head = head + "<th class=\"lmn-th\">" + _sanitize.escape_html("" + clabel) + "</th>"
        }
        hi = hi + 1
    }
    head = head + "</tr></thead>"

    let body = "<tbody>"
    let top_h = first * row_height
    if top_h > 0 {
        body = body + "<tr class=\"lmn-vspace\" style=\"height:" + top_h + "px\"><td colspan=\"" + ncols + "\"></td></tr>"
    }
    if err != null {
        body = body + "<tr><td class=\"lmn-td lmn-td-msg\" colspan=\"" + ncols + "\">" + _sanitize.escape_html(err) + "</td></tr>"
    } else {
        let ri = 0
        while ri < rows.len() {
            let row = rows[ri]
            body = body + "<tr style=\"height:" + row_height + "px\">"
            let cj = 0
            while cj < ncols {
                let cn2 = _validate.get_field(columns[cj], "name")
                let cell = _validate.get_field(row, cn2)
                let txt = ""
                if cell != null { txt = _sanitize.escape_html("" + cell) }
                body = body + "<td class=\"lmn-td\">" + txt + "</td>"
                cj = cj + 1
            }
            body = body + "</tr>"
            ri = ri + 1
        }
    }
    let shown = rows.len()
    let bottom_rows = total_rows - first - shown
    if bottom_rows > 0 {
        let bottom_h = bottom_rows * row_height
        body = body + "<tr class=\"lmn-vspace\" style=\"height:" + bottom_h + "px\"><td colspan=\"" + ncols + "\"></td></tr>"
    }
    body = body + "</tbody>"

    let wrap = "<div class=\"lmn-table-wrap lmn-vtable\" data-lumen-vtable data-row-h=\"" + row_height + "\" style=\"height:" + viewport_height + "px;overflow:auto\"><table class=\"lmn-table\">" + head + body + "</table></div>"
    return lumen_render(wrap, {})
}

// ─── Pillar 4: typed URL / search state — parse the query into a typed struct,
// serialize state back to a query string, and a hidden marker the client syncs
// to the address bar. Codec handles space & = % # (v1). ───

fn _lumen_hex_nibble(c) {
    if c >= 48 and c <= 57 { return c - 48 }
    if c >= 97 and c <= 102 { return c - 87 }
    if c >= 65 and c <= 70 { return c - 55 }
    return -1
}

fn _lumen_qs_decode(val) {
    let out = []
    let i = 0
    let n = val.len()
    while i < n {
        let c = val.code_at(i)
        if c == 43 {
            out = out.push(32)
            i = i + 1
        } else if c == 37 and i + 2 < n {
            let hi = _lumen_hex_nibble(val.code_at(i + 1))
            let lo = _lumen_hex_nibble(val.code_at(i + 2))
            if hi >= 0 and lo >= 0 {
                out = out.push(hi * 16 + lo)
                i = i + 3
            } else {
                out = out.push(c)
                i = i + 1
            }
        } else {
            out = out.push(c)
            i = i + 1
        }
    }
    return "".from_codes(out)
}

fn _lumen_qs_encode(v) {
    let out = ""
    let i = 0
    let n = v.len()
    let hex = "0123456789ABCDEF"
    while i < n {
        let code = v.code_at(i)
        if (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or
           (code >= 48 and code <= 57) or code == 45 or code == 46 or
           code == 95 or code == 126 {
            out = out + v.substring(i, i + 1)
        } else {
            out = out + "%" + hex.substring(code / 16, code / 16 + 1) + hex.substring(code % 16, code % 16 + 1)
        }
        i = i + 1
    }
    return out
}

fn _lumen_parse_query(raw) {
    let q = raw
    if q == null { q = "" }
    if q.len() > 0 {
        if q.substring(0, 1) == "?" { q = q.substring(1, q.len()) }
    }
    let out_keys = []
    let out_vals = []
    if q == "" { return http.create_struct(out_keys, out_vals) }
    // split on & into pairs
    let pairs = []
    let cur = ""
    let i = 0
    let n = q.len()
    while i < n {
        let c = q.substring(i, i + 1)
        if c == "&" {
            if cur != "" { pairs = pairs.push(cur) }
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    if cur != "" { pairs = pairs.push(cur) }
    let pi = 0
    while pi < pairs.len() {
        let pair = pairs[pi]
        let eq = pair.index_of("=")
        let k = pair
        let val = ""
        if eq >= 0 {
            k = pair.substring(0, eq)
            val = pair.substring(eq + 1, pair.len())
        }
        if k != "" {
            out_keys = out_keys.push(_lumen_qs_decode(k))
            out_vals = out_vals.push(_lumen_qs_decode(val))
        }
        pi = pi + 1
    }
    return http.create_struct(out_keys, out_vals)
}

fn _lumen_coerce(rawv, typ) {
    if typ == "string" { return rawv }
    if typ == "bool" {
        if rawv == "true" { return true }
        if rawv == "false" { return false }
        return null
    }
    if typ == "int" or typ == "number" {
        let r = null
        try { r = json_decode(rawv) } catch e { r = null }
        let actual = type_of(r)
        if typ == "int" and actual == "int" { return r }
        if typ == "number" and (actual == "int" or actual == "float") { return r }
        return null
    }
    throw("Lumen search: unknown schema type '" + typ + "'")
}

// Parse + validate the request's query string into a typed struct.
// schema = struct name -> { type, default, validator? }  (type: string|int|number|bool)
fn lumen_search(req, schema) {
    let raw = _validate.get_field(req, "query")
    if raw == null { raw = "" }
    let parsed = _lumen_parse_query(raw)
    let keys = _validate.get_keys(schema)
    let out_keys = []
    let out_vals = []
    let ki = 0
    while ki < keys.len() {
        let key = keys[ki]
        let spec = _validate.get_field(schema, key)
        let dflt = _validate.get_field(spec, "default")
        let typ = _validate.get_field(spec, "type")
        if typ == null { typ = "string" }
        let validator = _validate.get_field(spec, "validator")
        let rawv = _validate.get_field(parsed, key)
        let value = dflt
        if rawv != null and rawv != "" {
            let coerced = _lumen_coerce(rawv, typ)
            if coerced != null {
                if validator != null {
                    let res = _validate_parse(validator, coerced)
                    if res.success { value = res.data } else { value = dflt }
                } else {
                    value = coerced
                }
            }
        }
        out_keys = out_keys.push(key)
        out_vals = out_vals.push(value)
        ki = ki + 1
    }
    return http.create_struct(out_keys, out_vals)
}

// Serialize a struct of search values to "?k=v&k2=v2" (skips null/empty; encodes values).
fn lumen_search_to_qs(values) {
    let keys = _validate.get_keys(values)
    let out = ""
    let first = true
    let ki = 0
    while ki < keys.len() {
        let key = keys[ki]
        let v = _validate.get_field(values, key)
        if v != null and ("" + v) != "" {
            if first { out = "?"; first = false } else { out = out + "&" }
            out = out + _lumen_qs_encode(key) + "=" + _lumen_qs_encode("" + v)
        }
        ki = ki + 1
    }
    return out
}

// Hidden marker a component renders so the client syncs the address bar to its state.
fn _lumen_url_marker(values) {
    let qs = lumen_search_to_qs(values)
    return "<div data-lumen-url=\"" + _sanitize.escape_html(qs) + "\" style=\"display:none\"></div>"
}

// ─── Pillar 5: shared reactive query cache. Identical queries across all
// connections share one execution; a DB write bumps the affected tables'
// versions (from the reactive tick), staling matching cache entries. Opt-in:
// route a hot read through cached_query(conn, sql, params, tables). ───

fn _lumen_bump_versions(tables) {
    let ti = 0
    while ti < tables.len() {
        let t = tables[ti]
        let cur = _validate.get_field(_lumen_table_version[0], t)
        if cur == null { cur = 0 }
        _lumen_table_version[0] = _tpl_bind(_lumen_table_version[0], t, cur + 1)
        ti = ti + 1
    }
    return null
}

fn _lumen_version_sig(tables) {
    let sig = ""
    let ti = 0
    while ti < tables.len() {
        let t = tables[ti]
        let v = _validate.get_field(_lumen_table_version[0], t)
        if v == null { v = 0 }
        sig = sig + t + ":" + v + ";"
        ti = ti + 1
    }
    return sig
}

// Run a query through the shared cache. `tables` = the table name(s) the query
// reads (so a write to any of them invalidates this entry). Returns the rows.
fn cached_query(conn, sql, params, tables) {
    if params == null { params = [] }
    if tables == null { tables = [] }
    let key = sql + "||" + json_encode(params)
    let cur_sig = _lumen_version_sig(tables)
    let entry = _validate.get_field(_lumen_qcache[0], key)
    if entry != null {
        if entry.sig == cur_sig {
            let h = _validate.get_field(_lumen_cache_stats[0], "hits")
            _lumen_cache_stats[0] = _tpl_bind(_lumen_cache_stats[0], "hits", h + 1)
            return entry.result
        }
    }
    let result = (conn.query)(sql, params)
    let new_entry = http.create_struct(["result", "sig", "tables"], [result, cur_sig, tables])
    _lumen_qcache[0] = _tpl_bind(_lumen_qcache[0], key, new_entry)
    let m = _validate.get_field(_lumen_cache_stats[0], "misses")
    _lumen_cache_stats[0] = _tpl_bind(_lumen_cache_stats[0], "misses", m + 1)
    return result
}

// Manually invalidate cached queries reading these tables (for Postgres /
// external writes that don't trip the sqlite update hook).
fn lumen_cache_invalidate(tables) {
    _lumen_bump_versions(tables)
    return null
}

fn lumen_perf_stats() {
    let h = _validate.get_field(_lumen_cache_stats[0], "hits")
    let m = _validate.get_field(_lumen_cache_stats[0], "misses")
    let entries = _validate.get_keys(_lumen_qcache[0]).len()
    return http.create_struct(["cache_hits", "cache_misses", "cache_entries"], [h, m, entries])
}

// Register a table so the reactive tick wakes ALL live loops when it changes
// (per-connection render-query model: each loop re-renders from its own state).
fn _lumen_watch_table(t) {
    _lumen_ensure_reactive()
    _lumen_watched_tables[0] = _tpl_bind(_lumen_watched_tables[0], t, true)
    return null
}

// ─── Lumen async resource: off-thread fetch with live re-render ───
// Same surface as lumen_resource but `refetch()` spawns a background task
// that runs the fetcher off the render thread. When the fetch completes,
// the holder is updated and _lumen_live_loop re-renders the component.
// Usage:
//   let users = lumen_async_resource(| | { return db.query("select ...") })
//   render:  if (users.state().loading { ... } else { each users.state().data ... }
//   handler: let _ = (users.refetch)()  // spawns bg fetch; loop re-renders on completion
fn lumen_async_resource(fetcher) {
    let notify_ch = task.channel(64)
    let holder = [http.create_struct(["loading","error","data"], [true, null, null])]
    let apply = |st| { holder[0] = st; return st }
    let run = | | {
        let st = null
        try {
            let d = fetcher()
            st = http.create_struct(["loading","error","data"], [false, null, d])
        } catch e {
            st = http.create_struct(["loading","error","data"], [false, "" + e, null])
        }
        let _ = (apply)(st)
        // Notify the live loop via the global channel
        let _ = _lumen_async_updates <- true
        return st
    }
    // Run once eagerly so first render has data
    let _ = (run)()
    let snapshot = | | { return holder[0] }
    let refetch = | | {
        let _ = task.spawn(run, [])
        return null
    }
    return http.create_struct(
        ["state", "refetch"],
        [snapshot, refetch]
    )
}

// ─── Lumen pub-sub: cross-connection broadcast ───
// `lumen_publish(topic, key, value)` updates a global topic registry and
// notifies all live loops (via _lumen_async_updates) so they re-render.
// `lumen_subscribe(topic)` returns `{ get(key) }` that reads the latest
// value from the shared registry.
// `lumen_broadcast_store(topic, initial)` is a store like lumen_store that
// auto-publishes every `set()` to the topic.
//
// Since all connections share the same VM globals and the scheduler is
// cooperative (single-threaded), there are no race conditions.
//
// Usage:
//   let counter = lumen_broadcast_store("counter", http.create_struct(["n"], [0]))
//   (counter.set)("n", (counter.get)("n") + 1)  // broadcasts to all connections
//   let sub = lumen_subscribe("counter")
//   render:  {{ (sub.get)("n") }}
fn lumen_publish(topic, key, value) {
    let topic_data = _validate.get_field(_lumen_pubsub_data, topic)
    if topic_data == null {
        topic_data = http.create_struct([key], [value])
    } else {
        topic_data = _tpl_bind(topic_data, key, value)
    }
    _lumen_pubsub_data = _tpl_bind(_lumen_pubsub_data, topic, topic_data)
    // Wake all live loops so they re-render with the new value
    let _ = _lumen_async_updates <- true
}

fn lumen_subscribe(topic) {
    let get = |key| {
        let topic_data = _validate.get_field(_lumen_pubsub_data, topic)
        if topic_data == null { return null }
        return _validate.get_field(topic_data, key)
    }
    return http.create_struct(["get"], [get])
}

fn lumen_broadcast_store(topic, initial) {
    let holder = [initial]
    // Publish initial values so late subscribers see them
    let init_keys = _validate.get_keys(initial)
    for i in 0..init_keys.len() {
        let k = init_keys[i]
        let _ = lumen_publish(topic, k, _validate.get_field(initial, k))
    }
    let get = |key| { return _validate.get_field(holder[0], key) }
    let set = |key, value| {
        holder[0] = _tpl_bind(holder[0], key, value)
        let _ = lumen_publish(topic, key, value)
        return null
    }
    let all = | | { return holder[0] }
    return http.create_struct(["get", "set", "all"], [get, set, all])
}

// ─── Lumen M2 — live layer (server-driven interactivity) ───
//
// Build a component struct from its three plain-Varian pieces:
//   state_fn()        -> initial state
//   render_fn(state)  -> rendered HTML string (calls lumen_render internally)
//   handler_names/handler_fns  -> parallel arrays mapping handler name -> fn
//
// Returns a struct with http.create_struct (no parse-order dependency).

fn lumen_component(state_fn, render_fn, handler_names, handler_fns) {
    return http.create_struct(
        ["state_fn", "render_fn", "handler_names", "handler_fns"],
        [state_fn, render_fn, handler_names, handler_fns]
    )
}

// M7 DX: render a component against its initial state to an HTML string.
// Snapshot-friendly: tests can assert on lumen_snapshot(component) directly,
// and it drives any child components through the normal composition pass.
fn lumen_snapshot(component) {
    _lumen_active_child_states = {}
    return (component.render_fn)((component.state_fn)())
}

// ─── Lumen test helpers (Workstream 3) ───

fn lumen_test_render(comp, state) {
    _lumen_active_child_states = {}
    return (comp.render_fn)(state)
}

fn lumen_test_event(comp, state, hname, value) {
    let names = comp.handler_names
    let fns = comp.handler_fns
    let handler = null
    for i in 0..names.len() {
        if names[i] == hname { handler = fns[i]; break }
    }
    if handler == null { return http.create_struct(["state", "html"], [state, ""]) }
    let new_state = null
    try {
        new_state = handler(state, value)
    } catch e {
        new_state = state
    }
    _lumen_active_child_states = {}
    let html = (comp.render_fn)(new_state)
    return http.create_struct(["state", "html"], [new_state, html])
}

fn lumen_test_contains(html, substr) {
    return html.index_of(substr) != -1
}

fn lumen_test_attr(html, attr_name) {
    return html.index_of(attr_name + "=\"") != -1 or html.index_of(attr_name + "=") != -1
}

fn lumen_test_count(html, substr) {
    let count = 0
    let pos = 0
    while true {
        let found = html.index_of(substr, pos)
        if found < 0 { break }
        count = count + 1
        pos = found + substr.len()
    }
    return count
}

// Emit a browser-native document hint. This requires no Lumen client action;
// the browser may fetch the destination when it has spare capacity.
fn lumen_prefetch(href) {
    let url = "" + href
    if url == "" or url.index_of("\r") >= 0 or url.index_of("\n") >= 0 {
        throw "lumen_prefetch: href must be a non-empty URL without control characters"
    }
    return "<link rel=\"prefetch\" as=\"document\" href=\"" + _sanitize.escape_html(url) + "\">"
}

// Mark an ordinary anchor for intent prefetch. Navigation remains native and
// works without JavaScript; only the small prefetch action is conditionally emitted.
fn lumen_prefetch_link(href, content) {
    let url = "" + href
    if url == "" or url.index_of("\r") >= 0 or url.index_of("\n") >= 0 {
        throw "lumen_prefetch_link: href must be a non-empty URL without control characters"
    }
    return "<a href=\"" + _sanitize.escape_html(url) + "\" data-lumen-prefetch>" + content + "</a>"
}

// Enable browser-native same-origin cross-document view transitions. Browsers
// without the feature keep normal navigation, and reduced-motion users get no
// generated transition animation. This emits CSS only and adds zero JS.
fn lumen_view_transitions() {
    return "<style>@view-transition \{ navigation: auto; \}" +
           "@media (prefers-reduced-motion: reduce) \{::view-transition-group(*) \{ animation-duration: 0s; \}\}</style>"
}

fn _lumen_view_transition_name(name) {
    let value = "" + name
    if value == "" { throw "lumen_view_transition: name must not be empty" }
    let first = value.substring(0, 1)
    let initial = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-"
    let rest = initial + "0123456789"
    if initial.index_of(first) < 0 { throw "lumen_view_transition: name must be a CSS identifier" }
    for i in 1..value.len() {
        if rest.index_of(value.substring(i, i + 1)) < 0 {
            throw "lumen_view_transition: name must be a CSS identifier"
        }
    }
    return value
}

// Give corresponding elements on two documents the same native transition name.
fn lumen_view_transition(name, content) {
    let safe_name = _lumen_view_transition_name(name)
    return "<div style=\"view-transition-name:" + safe_name + "\">" + content + "</div>"
}

fn _lumen_locale_match(tag, supported) {
    if tag == null { return null }
    let wanted = _sanitize.trim("" + tag).lower()
    if wanted == "" or wanted == "*" { return null }
    for i in 0..supported.len() {
        if ("" + supported[i]).lower() == wanted { return supported[i] }
    }
    let dash = wanted.index_of("-")
    let base = wanted
    if dash >= 0 { base = wanted.substring(0, dash) }
    for i in 0..supported.len() {
        let candidate = ("" + supported[i]).lower()
        if candidate == base or candidate.starts_with(base + "-") { return supported[i] }
    }
    return null
}

fn _lumen_accept_language(raw, supported) {
    if raw == null or raw == "" { return null }
    let choices = ("" + raw).split(",")
    let selected = null
    let selected_q = -1.0
    for i in 0..choices.len() {
        let parts = choices[i].split(";")
        let tag = _sanitize.trim(parts[0])
        let quality = 1.0
        for j in 1..parts.len() {
            let option = _sanitize.trim(parts[j])
            if option.starts_with("q=") {
                try { quality = json_decode(option.substring(2, option.len())) } catch e { quality = 0.0 }
                let quality_type = type_of(quality)
                if (quality_type != "int" and quality_type != "float") or quality < 0 or quality > 1 {
                    quality = 0.0
                }
            }
        }
        if quality > selected_q and quality > 0 {
            let matched = _lumen_locale_match(tag, supported)
            if matched != null { selected = matched; selected_q = quality }
        }
    }
    return selected
}

// Resolve locale routing without browser state. Explicit /locale paths win,
// then Accept-Language quality negotiation, then the configured fallback.
// `path` is stripped of the locale prefix for application route matching.
fn lumen_locale_route(req, supported, default_locale) {
    if type_of(supported) != "array" or supported.len() == 0 {
        throw "lumen_locale_route: supported must be a non-empty locale array"
    }
    if _lumen_locale_match(default_locale, supported) == null {
        throw "lumen_locale_route: default locale must be supported"
    }
    let path = _validate.get_field(req, "path")
    if path == null or path == "" { path = "/" }
    let segments = path.split("/")
    let explicit = null
    if segments.len() > 1 { explicit = _lumen_locale_match(segments[1], supported) }
    let locale = explicit
    let source = "path"
    let route_path = path
    if explicit != null {
        let cut = 1 + segments[1].len()
        route_path = path.substring(cut, path.len())
        if route_path == "" { route_path = "/" }
    } else {
        source = "header"
        let headers = _validate.get_field(req, "headers")
        let raw = null
        if headers != null {
            raw = _validate.get_field(headers, "accept_language")
            if raw == null { raw = _validate.get_field(headers, "accept-language") }
        }
        locale = _lumen_accept_language(raw, supported)
        if locale == null { locale = default_locale; source = "default" }
    }
    let canonical_path = "/" + locale
    if route_path != "/" { canonical_path = canonical_path + route_path }
    return http.create_struct(
        ["locale", "path", "canonical_path", "prefixed", "source"],
        [locale, route_path, canonical_path, explicit != null, source]
    )
}

// Emit SEO alternate links for every locale plus x-default. Pure HTML, zero JS.
fn lumen_locale_alternates(path, supported, default_locale) {
    if _lumen_locale_match(default_locale, supported) == null {
        throw "lumen_locale_alternates: default locale must be supported"
    }
    let route_path = "" + path
    if route_path == "" { route_path = "/" }
    if route_path.starts_with("/") == false { route_path = "/" + route_path }
    let out = ""
    for i in 0..supported.len() {
        let locale = "" + supported[i]
        let href = "/" + locale
        if route_path != "/" { href = href + route_path }
        out = out + "<link rel=\"alternate\" hreflang=\"" + _sanitize.escape_html(locale) + "\" href=\"" + _sanitize.escape_html(href) + "\">"
    }
    let fallback = "/" + default_locale
    if route_path != "/" { fallback = fallback + route_path }
    return out + "<link rel=\"alternate\" hreflang=\"x-default\" href=\"" + _sanitize.escape_html(fallback) + "\">"
}

fn _lumen_same_origin_path(value, label) {
    let path = "" + value
    if path == "" or path.starts_with("/") == false or path.starts_with("//") or
       path.index_of("\r") >= 0 or path.index_of("\n") >= 0 {
        throw("Lumen " + label + " must be an absolute same-origin path")
    }
    return path
}

// Opt into an already mounted Lumen service worker. Without this marker no
// registration code ships and no worker is installed.
fn lumen_offline(worker_path, scope) {
    let worker = _lumen_same_origin_path(worker_path, "offline worker")
    let worker_scope = _lumen_same_origin_path(scope, "offline scope")
    return "<span hidden data-lumen-offline=\"" + _sanitize.escape_html(worker) +
           "\" data-lumen-scope=\"" + _sanitize.escape_html(worker_scope) + "\"></span>"
}

fn _lumen_offline_worker_source(cache_name, assets, fallback) {
    if type_of(assets) != "array" { throw "Lumen offline assets must be an array" }
    let safe_assets = []
    for i in 0..assets.len() {
        let asset = _lumen_same_origin_path(assets[i], "offline asset")
        if _lumen_list_has(safe_assets, asset) == false { safe_assets = safe_assets.push(asset) }
    }
    let safe_fallback = _lumen_same_origin_path(fallback, "offline fallback")
    if _lumen_list_has(safe_assets, safe_fallback) == false { safe_assets = safe_assets.push(safe_fallback) }
    let cache = "lumen:" + cache_name
    return "const C=" + json_encode(cache) + ",A=" + json_encode(safe_assets) + ",F=" + json_encode(safe_fallback) + ";" +
           "self.addEventListener('install',e=>e.waitUntil(caches.open(C).then(c=>c.addAll(A)).then(()=>self.skipWaiting())));" +
           "self.addEventListener('activate',e=>e.waitUntil(caches.keys().then(a=>Promise.all(a.filter(k=>k.startsWith('lumen:')&&k!==C).map(k=>caches.delete(k)))).then(()=>self.clients.claim())));" +
           "self.addEventListener('fetch',e=>\{let r=e.request;if(r.method!=='GET')return;if(r.mode==='navigate')e.respondWith(fetch(r).catch(()=>caches.match(F)));else e.respondWith(caches.match(r).then(x=>x||fetch(r)))\});"
}

// Mount a generated worker directly from Varian configuration—no generated
// asset needs to be checked into the application repository.
fn lumen_mount_offline(app, worker_path, cache_name, assets, fallback) {
    let path = _lumen_same_origin_path(worker_path, "offline worker")
    if cache_name == null or ("" + cache_name) == "" { throw "Lumen offline cache name must not be empty" }
    let source = _lumen_offline_worker_source("" + cache_name, assets, fallback)
    radix_insert(app.root, "GET" + path, |req| {
        return http.create_struct(
            ["status", "body", "content_type", "headers"],
            [200, source, "application/javascript; charset=utf-8",
             http.create_struct(["Cache-Control", "Service-Worker-Allowed"], ["no-cache", "/"])]
        )
    }, "Lumen offline service worker")
    return path
}

fn _lumen_image_url(value, label) {
    let url = "" + value
    if url == "" or url.index_of("\r") >= 0 or url.index_of("\n") >= 0 {
        throw("Lumen image " + label + " must be a non-empty URL without control characters")
    }
    return url
}

fn _lumen_image_srcset(candidates) {
    if candidates == null { return "" }
    if type_of(candidates) != "array" { throw "Lumen image srcset must be an array" }
    let out = ""
    let previous_width = 0
    for i in 0..candidates.len() {
        let candidate = candidates[i]
        let width = _validate.get_field(candidate, "width")
        if type_of(width) != "int" or width <= 0 or width <= previous_width {
            throw "Lumen image srcset widths must be positive and strictly increasing"
        }
        let url = _lumen_image_url(_validate.get_field(candidate, "src"), "candidate")
        if i > 0 { out = out + ", " }
        out = out + _sanitize.escape_html(url) + " " + width + "w"
        previous_width = width
    }
    return out
}

fn _lumen_image_tag(src, alt, opts) {
    let url = _lumen_image_url(src, "source")
    if type_of(alt) != "string" { throw "Lumen image alt text must be an explicit string" }
    if opts == null { throw "Lumen image options are required" }
    let width = _validate.get_field(opts, "width")
    let height = _validate.get_field(opts, "height")
    if type_of(width) != "int" or width <= 0 or type_of(height) != "int" or height <= 0 {
        throw "Lumen images require positive integer width and height"
    }
    let loading = _validate.get_field(opts, "loading")
    if loading == null { loading = "lazy" }
    if loading != "lazy" and loading != "eager" { throw "Lumen image loading must be lazy or eager" }
    let priority = _validate.get_field(opts, "fetchpriority")
    if priority == null { priority = "auto" }
    if priority != "auto" and priority != "high" and priority != "low" {
        throw "Lumen image fetchpriority must be auto, high, or low"
    }
    if loading == "lazy" and priority == "high" {
        throw "Lumen image cannot combine lazy loading with high fetch priority"
    }
    let sizes = _validate.get_field(opts, "sizes")
    let srcset = _lumen_image_srcset(_validate.get_field(opts, "srcset"))
    let responsive = ""
    if srcset != "" { responsive = " srcset=\"" + srcset + "\"" }
    if sizes != null and ("" + sizes) != "" {
        if srcset == "" { throw "Lumen image sizes requires srcset" }
        responsive = responsive + " sizes=\"" + _sanitize.escape_html("" + sizes) + "\""
    }
    return "<img src=\"" + _sanitize.escape_html(url) + "\" alt=\"" +
           _sanitize.escape_html("" + alt) + "\" width=\"" + width + "\" height=\"" + height +
           "\" loading=\"" + loading + "\" decoding=\"async\" fetchpriority=\"" + priority + "\"" + responsive + ">"
}

// Render a layout-stable responsive image using browser-native selection only.
fn lumen_image(src, alt, opts) {
    return _lumen_image_tag(src, alt, opts)
}

// Render ordered modern-format sources followed by the required fallback image.
// opts.sources = [{ type: "image/avif", srcset: [{src,width}, ...] }, ...]
fn lumen_picture(src, alt, opts) {
    let sources = _validate.get_field(opts, "sources")
    if sources == null or type_of(sources) != "array" or sources.len() == 0 {
        throw "Lumen picture sources must be a non-empty array"
    }
    let html = "<picture>"
    for i in 0..sources.len() {
        let source = sources[i]
        let media_type = _validate.get_field(source, "type")
        if media_type != "image/avif" and media_type != "image/webp" and media_type != "image/jpeg" and media_type != "image/png" {
            throw "Lumen picture source type is not supported"
        }
        let srcset = _lumen_image_srcset(_validate.get_field(source, "srcset"))
        if srcset == "" { throw "Lumen picture source srcset must not be empty" }
        html = html + "<source type=\"" + media_type + "\" srcset=\"" + srcset + "\""
        let sizes = _validate.get_field(opts, "sizes")
        if sizes != null and ("" + sizes) != "" { html = html + " sizes=\"" + _sanitize.escape_html("" + sizes) + "\"" }
        html = html + ">"
    }
    return html + _lumen_image_tag(src, alt, opts) + "</picture>"
}

fn lumen_test_render_response(comp, state) {
    return lumen_render_response((comp.render_fn)(state), state)
}

// Resolve a handler by name against the registered set ONLY.  Returns null if
// the name isn't registered — the caller must then silently ignore the event.
// This is the security gate: never dispatch an arbitrary name from the wire.
fn _lumen_handler(component, name) {
    let names = component.handler_names
    for i in 0..names.len() {
        if names[i] == name { return component.handler_fns[i] }
    }
    return null
}

// Mount a live component on a Zenith app.
//   GET <path>       → initial HTML page (full shell)
//   GET <path>/live  → WebSocket upgrade → live loop
//
// Uses radix_insert directly instead of app.get() because zenith.vn's impl
// methods aren't visible when this module is compiled (prelude order).
fn _lumen_get_layouts_for_path(path) {
    let segs = path.split("/")
    let layouts = []
    let root_lay = _lumen_get_component("Layout")
    if root_lay != null { layouts = layouts.push(root_lay) }
    let prefix = ""
    for i in 0..segs.len() {
        let seg = segs[i]
        if seg != "" {
            let clean = seg
            if seg.starts_with(":") {
                clean = seg.substring(1, seg.len())
            }
            prefix = prefix + _lumen_pascal(clean)
            let lay = _lumen_get_component(prefix + "Layout")
            if lay != null {
                layouts = layouts.push(lay)
            }
        }
    }
    return layouts
}

fn _lumen_get_loading_for_path(path) {
    let segs = path.split("/")
    let loading = _lumen_get_component("Loading")
    let prefix = ""
    for i in 0..segs.len() {
        let seg = segs[i]
        if seg != "" {
            let clean = seg
            if seg.starts_with(":") {
                clean = seg.substring(1, seg.len())
            }
            prefix = prefix + _lumen_pascal(clean)
            let lod = _lumen_get_component(prefix + "Loading")
            if lod != null {
                loading = lod
            }
        }
    }
    return loading
}

fn _lumen_get_error_for_path(path) {
    let segs = path.split("/")
    let boundary = _lumen_get_component("Error")
    let prefix = ""
    for i in 0..segs.len() {
        let seg = segs[i]
        if seg != "" {
            let clean = seg
            if seg.starts_with(":") { clean = seg.substring(1, seg.len()) }
            prefix = prefix + _lumen_pascal(clean)
            let candidate = _lumen_get_component(prefix + "Error")
            if candidate != null { boundary = candidate }
        }
    }
    return boundary
}

fn _lumen_apply_layouts(path, state, inner) {
    let html = inner
    let layouts = _lumen_get_layouts_for_path(path)
    for i in 0..layouts.len() {
        let idx = layouts.len() - 1 - i
        let lay = layouts[idx]
        let lay_state = state
        if lay.state_fn != null {
            let defaults = (lay.state_fn)()
            let keys = _validate.get_keys(defaults)
            for j in 0..keys.len() {
                let key = keys[j]
                if _validate.get_field(lay_state, key) == null {
                    lay_state = _lumen_with_field(lay_state, key, _validate.get_field(defaults, key))
                }
            }
        }
        lay_state = _lumen_with_field(lay_state, "children", html)
        html = (lay.render_fn)(lay_state)
    }
    return html
}

// Explicit server-loader result. Plain structs remain valid loader data; use
// this wrapper only when the loader also wants to declare invalidation keys.
// The private marker avoids reserving ordinary application field names.
fn lumen_load(data, dependencies) {
    if data == null { data = http.create_struct([], []) }
    if dependencies == null { dependencies = [] }
    if type_of(data) != "struct" { throw("Lumen load data must be a struct") }
    if type_of(dependencies) != "array" and type_of(dependencies) != "tuple" {
        throw("Lumen load dependencies must be an array")
    }
    let clean = []
    for i in 0..dependencies.len() {
        let key = dependencies[i]
        if type_of(key) != "string" or key == "" { throw("Lumen load dependency keys must be non-empty strings") }
        if _lumen_list_has(clean, key) == false { clean = clean.push(key) }
    }
    return http.create_struct(["_lumen_load_result", "data", "dependencies"], [true, data, clean])
}

fn lumen_redirect(location, status) {
    if type_of(location) != "string" or location == "" or location.index_of("\r") >= 0 or location.index_of("\n") >= 0 {
        throw("Lumen redirect location must be non-empty and contain no newlines")
    }
    if status != 301 and status != 302 and status != 303 and status != 307 and status != 308 {
        throw("Lumen redirect status must be 301, 302, 303, 307, or 308")
    }
    return http.create_struct(["_lumen_redirect", "location", "status"], [true, location, status])
}

fn _lumen_loader_result(value) {
    if value == null { return http.create_struct(["data", "dependencies"], [http.create_struct([], []), []]) }
    if type_of(value) != "struct" { throw("Lumen load handlers must return a struct or lumen_load(...)") }
    if _validate.get_field(value, "_lumen_redirect") == true {
        return http.create_struct(["data", "dependencies", "redirect"], [http.create_struct([], []), [], value])
    }
    if _validate.get_field(value, "_lumen_load_result") == true {
        return http.create_struct(
            ["data", "dependencies", "redirect"],
            [_validate.get_field(value, "data"), _validate.get_field(value, "dependencies"), null]
        )
    }
    return http.create_struct(["data", "dependencies", "redirect"], [value, [], null])
}

fn _lumen_merge_loader_data(state, data) {
    if data == null { return state }
    if type_of(data) != "struct" { throw("Lumen load data must be a struct") }
    let keys = _validate.get_keys(data)
    for i in 0..keys.len() {
        state = _lumen_with_field(state, keys[i], _validate.get_field(data, keys[i]))
    }
    return state
}

fn _lumen_loader_request(req, data, dependencies) {
    let context = _validate.get_field(req, "context")
    if context == null { context = http.create_struct([], []) }
    context = context.set("lumen_data", data)
    context = context.set("lumen_dependencies", dependencies)
    return req.set("context", context)
}

fn lumen_parent_data(req) {
    let context = _validate.get_field(req, "context")
    if context == null { return http.create_struct([], []) }
    let data = _validate.get_field(context, "lumen_data")
    if data == null { return http.create_struct([], []) }
    return data
}

fn lumen_load_dependencies(req) {
    let context = _validate.get_field(req, "context")
    if context == null { return [] }
    let dependencies = _validate.get_field(context, "lumen_dependencies")
    if dependencies == null { return [] }
    return dependencies
}

// Ordered, server-native HTML streaming. String chunks flush immediately;
// function/closure chunks are invoked only when the stream reaches them, so
// earlier markup reaches the browser while later server work is still
// pending. No browser JavaScript is emitted by this primitive.
fn _lumen_validate_stream_chunks(chunks) {
    let kind = type_of(chunks)
    if kind != "array" and kind != "tuple" { throw("Lumen stream chunks must be an array") }
    for i in 0..chunks.len() {
        let chunk_kind = type_of(chunks[i])
        let is_deferred = chunk_kind == "struct" and _validate.get_field(chunks[i], "_lumen_deferred") == true
        if chunk_kind != "string" and chunk_kind != "function" and chunk_kind != "closure" and is_deferred == false {
            throw("Lumen stream chunks must be strings, zero-argument functions, or lumen_defer boundaries")
        }
    }
    return chunks
}

fn _lumen_defer_id_valid(id) {
    if type_of(id) != "string" or id == "" or id.len() > 96 { return false }
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.:"
    for i in 0..id.len() {
        if allowed.index_of(id.substring(i, i + 1)) < 0 { return false }
    }
    return true
}

fn lumen_defer(id, fallback_html, resolver, error_html) {
    if _lumen_defer_id_valid(id) == false { throw("Lumen deferred boundary id is invalid") }
    if type_of(fallback_html) != "string" { throw("Lumen deferred fallback must be HTML text") }
    if error_html != null and type_of(error_html) != "string" { throw("Lumen deferred error fallback must be HTML text") }
    let resolver_kind = type_of(resolver)
    if resolver_kind != "function" and resolver_kind != "closure" { throw("Lumen deferred resolver must be a function") }
    return http.create_struct(
        ["_lumen_deferred", "id", "fallback", "resolve", "error"],
        [true, id, fallback_html, resolver, error_html]
    )
}

fn _lumen_stream_document_tail_index(html) {
    let body = html.index_of("</body>")
    let doc = html.index_of("</html>")
    if body >= 0 and doc >= 0 and doc < body { return doc }
    if body >= 0 { return body }
    return doc
}

fn lumen_stream_html(chunks, headers) {
    chunks = _lumen_validate_stream_chunks(chunks)
    if headers == null { headers = http.create_struct([], []) }
    if type_of(headers) != "struct" { throw("Lumen stream headers must be a struct") }
    return stream_response(200, "text/html; charset=utf-8", headers, |stream| {
        let deferred = []
        let defer_runtime_sent = false
        let document_tail = ""
        for i in 0..chunks.len() {
            let chunk = chunks[i]
            if type_of(chunk) == "struct" and _validate.get_field(chunk, "_lumen_deferred") == true {
                if defer_runtime_sent == false {
                    stream = stream.write("<script>" + _lumen_module("defer") + "</script>")
                    defer_runtime_sent = true
                }
                let id = _validate.get_field(chunk, "id")
                stream = stream.write("<lumen-defer data-lumen-defer=\"" + _sanitize.escape_html(id) + "\" aria-busy=\"true\" style=\"display:contents\">" + _validate.get_field(chunk, "fallback") + "</lumen-defer>")
                deferred = deferred.push(chunk)
            } else {
                if type_of(chunk) != "string" { chunk = chunk() }
                if type_of(chunk) != "string" { throw("Lumen stream functions must return strings") }
                if i == chunks.len() - 1 {
                    let tail_at = _lumen_stream_document_tail_index(chunk)
                    if tail_at >= 0 {
                        document_tail = chunk.substring(tail_at, chunk.len())
                        chunk = chunk.substring(0, tail_at)
                    }
                }
                stream = stream.write(chunk)
            }
        }
        for i in 0..deferred.len() {
            let boundary = deferred[i]
            let resolved = null
            try { resolved = (_validate.get_field(boundary, "resolve"))() } catch e {
                resolved = _validate.get_field(boundary, "error")
            }
            if resolved != null {
                if type_of(resolved) != "string" { throw("Lumen deferred resolvers must return HTML text") }
                stream = stream.write("<template data-lumen-defer-result=\"" + _sanitize.escape_html(_validate.get_field(boundary, "id")) + "\">" + resolved + "</template>")
            } else {
                stream = stream.write("<template data-lumen-defer-result=\"" + _sanitize.escape_html(_validate.get_field(boundary, "id")) + "\" data-lumen-defer-keep></template>")
            }
        }
        if document_tail != "" { stream = stream.write(document_tail) }
        return stream
    })
}

fn _lumen_run_loader(component, req, state, dependencies) {
    let loader = _lumen_handler(component, "load")
    if loader == null { return http.create_struct(["state", "dependencies", "redirect"], [state, dependencies, null]) }
    let result = _lumen_loader_result(loader(_lumen_loader_request(req, state, dependencies)))
    if _validate.get_field(result, "redirect") != null {
        return http.create_struct(["state", "dependencies", "redirect"], [state, dependencies, result.redirect])
    }
    state = _lumen_merge_loader_data(state, result.data)
    for i in 0..result.dependencies.len() {
        let key = result.dependencies[i]
        if _lumen_list_has(dependencies, key) == false { dependencies = dependencies.push(key) }
    }
    return http.create_struct(["state", "dependencies", "redirect"], [state, dependencies, null])
}

fn _lumen_render_route(component, state, path, req) {
    try {
        let dependencies = []
        let layouts = _lumen_get_layouts_for_path(path)
        for i in 0..layouts.len() {
            let loaded = _lumen_run_loader(layouts[i], req, state, dependencies)
            state = loaded.state
            dependencies = loaded.dependencies
            if loaded.redirect != null {
                return http.create_struct(["state", "html", "error", "dependencies", "redirect"], [state, "", null, dependencies, loaded.redirect])
            }
        }
        let loaded = _lumen_run_loader(component, req, state, dependencies)
        state = loaded.state
        dependencies = loaded.dependencies
        if loaded.redirect != null {
            return http.create_struct(["state", "html", "error", "dependencies", "redirect"], [state, "", null, dependencies, loaded.redirect])
        }
        _lumen_active_child_states = {}
        let html = (component.render_fn)(state)
        return http.create_struct(["state", "html", "error", "dependencies", "redirect"], [state, _lumen_apply_layouts(path, state, html), null, dependencies, null])
    } catch e {
        let boundary = _lumen_get_error_for_path(path)
        if boundary == null { throw(e) }
        let error_state = http.create_struct([], [])
        if boundary.state_fn != null { error_state = (boundary.state_fn)() }
        error_state = _lumen_with_field(error_state, "error", _lumen_error_msg(e))
        error_state = _lumen_with_field(error_state, "status", 500)
        let html = (boundary.render_fn)(error_state)
        return http.create_struct(["state", "html", "error", "dependencies", "redirect"], [state, _lumen_apply_layouts(path, state, html), "" + e, [], null])
    }
}

fn _lumen_redirect_response(redirect) {
    return http.create_struct(
        ["status", "body", "content_type", "headers"],
        [redirect.status, "", "text/plain", http.create_struct(["Location"], [redirect.location])]
    )
}

fn lumen_mount(app, path, component) {
    let ws_path = path + "/live"
    if path == "/" { ws_path = "/live" }
    if _lumen_handler(component, "action") != null {
        let post_handler = |req| {
            let act_fn = _lumen_handler(component, "action")
            let res = act_fn(req)
            if res != null { return res }
            return http.create_struct(["status","body","content_type"], [200, "success", "text/plain"])
        }
        radix_insert(app.root, "POST" + path, post_handler, "Lumen action handler")
    }
    let page = |req| {
        let state = (component.state_fn)()
        let rendered = _lumen_render_route(component, state, path, req)
        if rendered.redirect != null { return _lumen_redirect_response(rendered.redirect) }
        state = rendered.state
        let html = rendered.html
        let loading = _lumen_get_loading_for_path(path)
        let loading_html = ""
        if loading != null {
            loading_html = (loading.render_fn)((loading.state_fn)())
        }
        let full_html = _lumen_shell_with_loading(html, ws_path, _lumen_scan_directives(html), loading_html)
        let state_json = json_encode(state)
        let hydrate_script = "<script id=\"__LUMEN_DATA__\" type=\"application/json\">" + state_json + "</script>"
        let body_end_idx = full_html.index_of("</body>")
        if body_end_idx >= 0 {
            full_html = full_html.substring(0, body_end_idx) + hydrate_script + full_html.substring(body_end_idx, full_html.len())
        }
        let response_status = 200
        if rendered.error != null { response_status = 500 }
        return http.create_struct(["status","body","content_type"], [response_status, full_html, "text/html"])
    }
    let live = |req| {
        if _lumen_live_origin_allowed(req) == false { return _lumen_live_origin_error() }
        let ws = upgrade_websocket(req)
        if ws == null {
            return http.create_struct(["status","body","content_type"], [400, "bad ws", "text/plain"])
        }
        _lumen_live_loop(ws, component, null, req)
        return http.create_struct(["status","body","content_type","_keep_open"], [101, "", "", true])
    }
    radix_insert(app.root, "GET" + path, page, "Lumen page")
    radix_insert(app.root, "GET" + ws_path, live, "Lumen live socket")
}

fn lumen_mount_dynamic(app, path, component, param) {
    let ws_path = path + "/live"
    if path == "/" { ws_path = "/live" }
    if _lumen_handler(component, "action") != null {
        let post_handler = |req| {
            let act_fn = _lumen_handler(component, "action")
            let res = act_fn(req)
            if res != null { return res }
            return http.create_struct(["status","body","content_type"], [200, "success", "text/plain"])
        }
        radix_insert(app.root, "POST" + path, post_handler, "Lumen action handler")
    }
    let page = |req| {
        let state = (component.state_fn)()
        let pval = _validate.get_field(req.params, param)
        if pval != null {
            state = _lumen_with_field(state, param, pval)
        }
        let rendered = _lumen_render_route(component, state, path, req)
        if rendered.redirect != null { return _lumen_redirect_response(rendered.redirect) }
        state = rendered.state
        let html = rendered.html
        let loading = _lumen_get_loading_for_path(path)
        let loading_html = ""
        if loading != null {
            loading_html = (loading.render_fn)((loading.state_fn)())
        }
        let full_html = _lumen_shell_with_loading(html, ws_path, _lumen_scan_directives(html), loading_html)
        let state_json = json_encode(state)
        let hydrate_script = "<script id=\"__LUMEN_DATA__\" type=\"application/json\">" + state_json + "</script>"
        let body_end_idx = full_html.index_of("</body>")
        if body_end_idx >= 0 {
            full_html = full_html.substring(0, body_end_idx) + hydrate_script + full_html.substring(body_end_idx, full_html.len())
        }
        let response_status = 200
        if rendered.error != null { response_status = 500 }
        return http.create_struct(["status","body","content_type"], [response_status, full_html, "text/html"])
    }
    let live = |req| {
        if _lumen_live_origin_allowed(req) == false { return _lumen_live_origin_error() }
        let ws = upgrade_websocket(req)
        if ws == null {
            return http.create_struct(["status","body","content_type"], [400, "bad ws", "text/plain"])
        }
        _lumen_live_loop(ws, component, null, req)
        return http.create_struct(["status","body","content_type","_keep_open"], [101, "", "", true])
    }
    radix_insert(app.root, "GET" + path, page, "Lumen page")
    radix_insert(app.root, "GET" + ws_path, live, "Lumen live socket")
}

fn lumen_mount_data(app, path, component, provider) {
    let ws_path = path + "/live"
    if path == "/" { ws_path = "/live" }
    if _lumen_handler(component, "action") != null {
        let post_handler = |req| {
            let act_fn = _lumen_handler(component, "action")
            let res = act_fn(req)
            if res != null { return res }
            return http.create_struct(["status","body","content_type"], [200, "success", "text/plain"])
        }
        radix_insert(app.root, "POST" + path, post_handler, "Lumen action handler")
    }
    let page = |req| {
        let state = (provider)(req)
        let rendered = _lumen_render_route(component, state, path, req)
        if rendered.redirect != null { return _lumen_redirect_response(rendered.redirect) }
        state = rendered.state
        let html = rendered.html
        let loading = _lumen_get_loading_for_path(path)
        let loading_html = ""
        if loading != null {
            loading_html = (loading.render_fn)((loading.state_fn)())
        }
        let full_html = _lumen_shell_with_loading(html, ws_path, _lumen_scan_directives(html), loading_html)
        let state_json = json_encode(state)
        let hydrate_script = "<script id=\"__LUMEN_DATA__\" type=\"application/json\">" + state_json + "</script>"
        let body_end_idx = full_html.index_of("</body>")
        if body_end_idx >= 0 {
            full_html = full_html.substring(0, body_end_idx) + hydrate_script + full_html.substring(body_end_idx, full_html.len())
        }
        let response_status = 200
        if rendered.error != null { response_status = 500 }
        return http.create_struct(["status","body","content_type"], [response_status, full_html, "text/html"])
    }
    let live = |req| {
        if _lumen_live_origin_allowed(req) == false { return _lumen_live_origin_error() }
        let ws = upgrade_websocket(req)
        if ws == null {
            return http.create_struct(["status","body","content_type"], [400, "bad ws", "text/plain"])
        }
        _lumen_live_loop(ws, component, provider, req)
        return http.create_struct(["status","body","content_type","_keep_open"], [101, "", "", true])
    }
    radix_insert(app.root, "GET" + path, page, "Lumen page")
    radix_insert(app.root, "GET" + ws_path, live, "Lumen live socket")
}

// ─── SEO & Metadata ───
// Per-request metadata accumulated by the page's <script>. Reset before each render.
let _lumen_page_meta = {}
let _lumen_custom_head = ""

// Declare metadata for the current page. Call at top of <script>:
//   lumen_meta("My Page", "A description", { image: "/og.png", twitter: "@handle" })
// The values are injected into <head> by _lumen_shell.
fn lumen_meta(title, description, og) {
    if og == null { og = {} }
    _lumen_page_meta = http.create_struct(
        ["title", "description", "og_title", "og_description", "og_image", "twitter_card", "twitter_site",
         "canonical", "hreflang", "og_type", "og_url", "og_site_name", "og_locale",
         "twitter_title", "twitter_description", "twitter_image", "twitter_creator"],
        ["" + title, "" + description,
         "" + _validate.get_field(og, "title"), "" + _validate.get_field(og, "description"),
         "" + _validate.get_field(og, "image"), "" + _validate.get_field(og, "twitter"),
         "" + _validate.get_field(og, "site"),
         "" + _validate.get_field(og, "canonical"), "" + _validate.get_field(og, "hreflang"),
         "" + _validate.get_field(og, "type"), "" + _validate.get_field(og, "url"),
         "" + _validate.get_field(og, "site_name"), "" + _validate.get_field(og, "locale"),
         "" + _validate.get_field(og, "twitter_title"), "" + _validate.get_field(og, "twitter_description"),
         "" + _validate.get_field(og, "twitter_image"), "" + _validate.get_field(og, "twitter_creator")]
    )
}

fn _lumen_meta_safe(v) {
    if v == null or v == "null" or v == "" { return null }
    return v
}

// Generate <meta> and <link> tags from a meta struct. Returns empty string if no meta set.
fn _lumen_meta_tags() {
    let m = _lumen_page_meta
    let t = _lumen_meta_safe(_validate.get_field(m, "title"))
    if t == null { return "" }
    let desc = _lumen_meta_safe(_validate.get_field(m, "description"))
    let og_t = _lumen_meta_safe(_validate.get_field(m, "og_title"))
    if og_t == null { og_t = t }
    let og_d = _lumen_meta_safe(_validate.get_field(m, "og_description"))
    if og_d == null { og_d = desc }
    let og_i = _lumen_meta_safe(_validate.get_field(m, "og_image"))
    let tw_c = _lumen_meta_safe(_validate.get_field(m, "twitter_card"))
    let tw_s = _lumen_meta_safe(_validate.get_field(m, "twitter_site"))
    let ca = _lumen_meta_safe(_validate.get_field(m, "canonical"))
    let hl = _lumen_meta_safe(_validate.get_field(m, "hreflang"))
    let og_ty = _lumen_meta_safe(_validate.get_field(m, "og_type"))
    let og_u = _lumen_meta_safe(_validate.get_field(m, "og_url"))
    let og_sn = _lumen_meta_safe(_validate.get_field(m, "og_site_name"))
    let og_lo = _lumen_meta_safe(_validate.get_field(m, "og_locale"))
    let tw_t = _lumen_meta_safe(_validate.get_field(m, "twitter_title"))
    let tw_d = _lumen_meta_safe(_validate.get_field(m, "twitter_description"))
    let tw_i = _lumen_meta_safe(_validate.get_field(m, "twitter_image"))
    let tw_cr = _lumen_meta_safe(_validate.get_field(m, "twitter_creator"))
    let out = ""
    if t != null {
        out = out + "<title>" + _sanitize.escape_html(t) + "</title>\n"
        out = out + "<meta property=\"og:title\" content=\"" + _sanitize.escape_html(og_t) + "\">\n"
    }
    if desc != null {
        out = out + "<meta name=\"description\" content=\"" + _sanitize.escape_html(desc) + "\">\n"
        out = out + "<meta property=\"og:description\" content=\"" + _sanitize.escape_html(og_d) + "\">\n"
    }
    if og_i != null {
        out = out + "<meta property=\"og:image\" content=\"" + _sanitize.escape_html(og_i) + "\">\n"
    }
    if og_u != null {
        out = out + "<meta property=\"og:url\" content=\"" + _sanitize.escape_html(og_u) + "\">\n"
    }
    if og_sn != null {
        out = out + "<meta property=\"og:site_name\" content=\"" + _sanitize.escape_html(og_sn) + "\">\n"
    }
    if og_lo != null {
        out = out + "<meta property=\"og:locale\" content=\"" + _sanitize.escape_html(og_lo) + "\">\n"
    }
    if og_ty != null {
        out = out + "<meta property=\"og:type\" content=\"" + _sanitize.escape_html(og_ty) + "\">\n"
    } else {
        out = out + "<meta property=\"og:type\" content=\"website\">\n"
    }
    if tw_c != null {
        out = out + "<meta name=\"twitter:card\" content=\"" + _sanitize.escape_html(tw_c) + "\">\n"
    }
    if tw_s != null {
        out = out + "<meta name=\"twitter:site\" content=\"" + _sanitize.escape_html(tw_s) + "\">\n"
    }
    if tw_t != null {
        out = out + "<meta name=\"twitter:title\" content=\"" + _sanitize.escape_html(tw_t) + "\">\n"
    }
    if tw_d != null {
        out = out + "<meta name=\"twitter:description\" content=\"" + _sanitize.escape_html(tw_d) + "\">\n"
    }
    if tw_i != null {
        out = out + "<meta name=\"twitter:image\" content=\"" + _sanitize.escape_html(tw_i) + "\">\n"
    }
    if tw_cr != null {
        out = out + "<meta name=\"twitter:creator\" content=\"" + _sanitize.escape_html(tw_cr) + "\">\n"
    }
    if ca != null {
        out = out + "<link rel=\"canonical\" href=\"" + _sanitize.escape_html(ca) + "\">\n"
    }
    if hl != null {
        out = out + "<link rel=\"alternate\" hreflang=\"" + _sanitize.escape_html(hl) + "\">\n"
    }
    return out
}

// ─── M4: DOM patch protocol ───
// Send a render to the client as a minimal splice patch instead of full HTML.
// We compute the longest common ASCII prefix (p) and suffix (q) between the
// previously-sent HTML and the new HTML, and send only the changed middle:
//   { t: "p", s: p, e: q, d: middle }
// The client reconstructs:  new = prev[0:p] + d + prev[len-q:]  then morphs.
// Keeping the prefix/suffix ASCII-only guarantees the server's byte offsets
// equal the client's JS (UTF-16) string indices, so Unicode in the changed
// middle (sent verbatim in d) can never corrupt the splice. prev == null means
// "no baseline yet" (fresh connect) → send the full HTML to (re)sync.
fn _lumen_send_update(ws, prev, html) {
    if prev == null {
        ws.write(json_encode({ t: "html", html: html }))
        return html
    }
    let pn = prev.len()
    let hn = html.len()
    let lim = pn
    if hn < lim { lim = hn }
    let p = 0
    while p < lim {
        let cc = prev.code_at(p)
        if cc != html.code_at(p) { break }
        if cc >= 128 { break }   // keep prefix ASCII so byte offset == JS index
        p = p + 1
    }
    let q = 0
    let qlim = lim - p
    while q < qlim {
        let cp = prev.code_at(pn - 1 - q)
        if cp != html.code_at(hn - 1 - q) { break }
        if cp >= 128 { break }
        q = q + 1
    }
    let mid = html.substring(p, hn - q)
    ws.write(json_encode({ t: "p", s: p, e: q, d: mid }))
    return html
}

// M7 DX: turn a caught handler error into a friendly dev overlay message.
// errors.explain() gives a what/fix block; fall back to the raw value.
fn _lumen_error_msg(e) {
    let detail = errors.explain(e)
    if detail == null { return "" + e }
    return detail
}

// Dev only: drain server-side print() output captured during a handler/render
// and push it to the browser devtools over the live socket as a {t:"log"} frame
// (one entry per line). This is the "view server logs in the browser" feature —
// print() still writes to the terminal too. No-op unless `vn dev` set LUMEN_DEV.
fn _lumen_emit_logs(ws) {
    let out = __lumen_log_drain()
    if out == "" { return }
    let raw = out.split("\n")
    let lines = []
    for i in 0..raw.len() {
        if raw[i] != "" { lines = lines.push(raw[i]) }
    }
    if lines.len() > 0 {
        ws.write(json_encode({ t: "log", lines: lines }))
    }
}

// Per-connection event loop.
// ws.read() is NON-BLOCKING (returns "" on EAGAIN, null on close).
// The loop yields via task.yield() when no message is available so the
// cooperative scheduler can service other connections.
fn _lumen_live_loop(ws, component, provider, req) {
    let _dev = env.get("LUMEN_DEV")
    let _devon = _dev != null and _dev != ""
    if _devon { __lumen_log_start() }
    let state = null

    let pending_event = null
    let init_msg = ""
    let read_attempts = 0
    while init_msg == "" and read_attempts < 200 {
        init_msg = ws.read()
        if init_msg == "" {
            task.yield()
            read_attempts = read_attempts + 1
        }
    }
    if init_msg != null and init_msg != "" {
        let init_ev = json_decode(init_msg)
        if init_ev != null {
            if _validate.get_field(init_ev, "t") == "init" {
                state = _validate.get_field(init_ev, "state")
            } else {
                pending_event = init_msg
            }
        }
    }

    if state == null {
        if provider != null {
            state = (provider)(req)
        } else {
            state = (component.state_fn)()
            let loader = _lumen_handler(component, "load")
            if loader != null {
                let loaded = loader(req)
                if loaded != null {
                    let lkeys = _validate.get_keys(loaded)
                    for lk in 0..lkeys.len() {
                        let k = lkeys[lk]
                        state = _lumen_with_field(state, k, _validate.get_field(loaded, k))
                    }
                }
            }
        }
    }
    _lumen_active_child_states = {}
    let _initial = (component.render_fn)(state)
    let child_states = _lumen_active_child_states
    if _devon { _lumen_emit_logs(ws) }

    let user_id = null
    try {
        if req.session != null {
            user_id = _validate.get_field(req.session, "user_id")
        }
    } catch e {}
    if user_id == null {
        user_id = "user_" + crypto.random_string(4)
    }
    let meta = http.create_struct(["user_id", "browser"], [user_id, "Lumen Client"])
    let topic = _validate.get_field(ws, "path")
    if topic == null or topic == "" { topic = "default" }

    let conn_id = crypto.random_string(8)
    let conn_info = http.create_struct(
        ["id", "ws", "component", "state", "req", "topic", "prev_html"],
        [conn_id, ws, component, state, req, topic, _initial]
    )
    _lumen_active_connections = _lumen_active_connections.push(conn_info)
    lumen_presence_join(topic, user_id, meta)

    let prev = null
    let alive = true
    while alive {
        let msg = null
        if pending_event != null {
            msg = pending_event
            pending_event = null
        } else {
            msg = ws.read()
        }
        if msg == null {
            alive = false
        } else if msg != "" {
            let ev = json_decode(msg)
            let kind = _validate.get_field(ev, "t")
            if kind == "event" {
                let hname = _validate.get_field(ev, "h")
                let value = _validate.get_field(ev, "v")
                _lumen_active_child_states = child_states

                let colon_pos = hname.index_of(":")
                if colon_pos >= 0 {
                    let child_id = hname.substring(0, colon_pos)
                    let child_hname = hname.substring(colon_pos + 1, hname.len())
                    let child_state = _validate.get_field(child_states, child_id)
                    if child_state != null {
                        let comp_name = child_state._comp
                        let comp = _lumen_get_component(comp_name)
                        if comp != null {
                            let handler = _lumen_handler(comp, child_hname)
                            if handler != null {
                                if _devon { __lumen_log_start() }
                                try {
                                    let new_child_state = handler(child_state, value)
                                    new_child_state = _tpl_bind(new_child_state, "_comp", comp_name)
                                    new_child_state = _tpl_bind(new_child_state, "_id", child_id)
                                    child_states = _tpl_bind(child_states, child_id, new_child_state)
                                    _lumen_active_child_states = child_states
                                    let html = (component.render_fn)(state)
                                    child_states = _lumen_active_child_states
                                    if _devon { _lumen_emit_logs(ws) }
                                    prev = _lumen_send_update(ws, prev, html)
                                    conn_info.prev_html = html
                                } catch e {
                                    if _devon { _lumen_emit_logs(ws) }
                                    ws.write(json_encode({ t: "error", msg: _lumen_error_msg(e) }))
                                }
                            }
                        }
                    }
                } else {
                    let handler = _lumen_handler(component, hname)
                    if handler != null {
                        if _devon { __lumen_log_start() }
                        try {
                            state = handler(state, value)
                            conn_info.state = state
                            let html = (component.render_fn)(state)
                            conn_info.prev_html = html
                            child_states = _lumen_active_child_states
                            if _devon { _lumen_emit_logs(ws) }
                            prev = _lumen_send_update(ws, prev, html)
                        } catch e {
                            if _devon { _lumen_emit_logs(ws) }
                            ws.write(json_encode({ t: "error", msg: _lumen_error_msg(e) }))
                        }
                    }
                }
            }
        } else {
            task.yield()
        }
        // After every iteration, check for async resource updates.
        // Drain all pending notifications; re-render once if any arrived.
        while true {
            let upd = task.try_receive(_lumen_async_updates)
            if upd == null { break }
            let html = (component.render_fn)(state)
            child_states = _lumen_active_child_states
            prev = _lumen_send_update(ws, prev, html)
        }
    }
    // Disconnect teardown: drop this connection from the active set and leave
    // its presence topic, so closed sockets don't accumulate (keeps the
    // presence broadcast + re-render fan-out bounded). NOTE: do NOT touch
    // _lumen_query_deps here — those refetch closures are shared across all
    // connections (the live_query core is a singleton), so removing them would
    // break still-open clients.
    let _kept = []
    let _ci = 0
    while _ci < _lumen_active_connections.len() {
        if _lumen_active_connections[_ci].id != conn_id {
            _kept = _kept.push(_lumen_active_connections[_ci])
        }
        _ci = _ci + 1
    }
    _lumen_active_connections = _kept
    lumen_presence_leave(topic, user_id)
}

// The <head> Lumen injects into every page: responsive viewport, the full
// favicon set (served from /public — see _lumen_build_dir), a web-app
// manifest, the Degular typeface (loaded via Adobe Fonts), and a base style
// that wires Degular up with a system-font fallback so a page looks right
// even before the webfont arrives. This is the "batteries-included" head
// every Next/Nuxt/Vite starter ships — authors never write it themselves.
fn _lumen_head() {
    let base = "<meta charset=\"utf-8\">" +
               "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" +
               "<title>Aurora</title>" +
               "<meta name=\"theme-color\" content=\"#FBFCFF\" media=\"(prefers-color-scheme: light)\">" +
               "<meta name=\"theme-color\" content=\"#0B1020\" media=\"(prefers-color-scheme: dark)\">" +
               "<link rel=\"icon\" href=\"/favicon.ico\" sizes=\"any\">" +
               "<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">" +
               "<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">" +
               "<link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\">" +
               "<link rel=\"manifest\" href=\"/manifest.json\">" +
               "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap\">" +
               "<script>!function()\{var d=document.documentElement,t=localStorage.getItem('lumen-theme');if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme: dark)').matches))d.classList.add('dark')\}();</script>" +
"<style>:root\{--lumen-bg:#030d1a;--lumen-fg:#f0f6ff;--lumen-muted:#94a3b8;--lumen-primary:#3b82f6;--lumen-primary-fg:#030d1a;--lumen-primary-hover:#2563eb;--lumen-surface:#0d1c2d;--lumen-surface-2:#122131;--lumen-border:#1e3347;--lumen-radius:12px;--lumen-shadow:0 1px 2px rgba(0,0,0,.5),0 12px 28px -12px rgba(0,0,0,.7);--lumen-font:\"Inter\",\"Plus Jakarta Sans\",ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;--lumen-mono:ui-monospace,SFMono-Regular,\"JetBrains Mono\",Menlo,monospace;--hue-aurora-1:#3b82f6;--hue-aurora-2:#1d4ed8;--hue-zenith:#5b9cff;--hue-lumen:#f5b829;--hue-kiln:#f97316;--hue-constellation:#a78bfa\}" +
               "html\{font-family:var(--lumen-font);-webkit-font-smoothing:antialiased\}" +
               "body\{margin:0;background:var(--lumen-bg);color:var(--lumen-fg);transition:background 0.3s ease,color 0.3s ease\}</style>"
    let custom = _lumen_custom_head
    if custom != null and custom != "" {
        base = base + custom
    }
    return base
}


// Wrap the rendered component in the live shell (data-lumen-root + client).
// Injects SEO metadata, Lumen head defaults, data-lumen-root, and the client
// script into the page's own document structure so the browser sees a single
// valid HTML document with proper <head> and <body>.
// `manifest` is an optional array of LumenJS module names to include.
fn _lumen_shell(inner, ws_path, manifest) {
    let body_start = inner.index_of("<body")
    let body_end = inner.index_of("</body>")
    let head_end = inner.index_of("</head>")
    let meta_tags = _lumen_meta_tags()
    let _dev_inject = _lumen_dev_inject(manifest)

    if body_start == -1 or body_end == -1 {
        // Fragment — wrap in full document.
        let head_html = _lumen_head()
        if meta_tags != "" { head_html = head_html + meta_tags }
        let client_js = _lumen_client_js_with_manifest(manifest)
        return "<!DOCTYPE html><html lang=\"en\"><head>" + head_html + "</head><body>" +
               "<div data-lumen-root>" + inner + "</div>" +
               "<script>window.__LUMEN_WS__=\"" + ws_path + "\";" + client_js + _dev_inject + "</script>" +
               "</body></html>"
    }

    // Full document — inject into existing <head> and <body>.
    // 1. Inject meta tags + Lumen defaults before </head>
    let head_close = head_end
    if head_close < 0 { head_close = body_start }
    let head_prefix = inner.substring(0, head_close)
    let after_head  = inner.substring(head_close)

    // 2. Inject <div data-lumen-root> and client JS into <body>
    let rel_body_open = body_start - head_close
    let rel_body_tag_close = inner.index_of(">", body_start) - head_close + 1
    let rel_body_end = body_end - head_close

    let body_before = after_head.substring(rel_body_open, rel_body_tag_close)
    let body_content = after_head.substring(rel_body_tag_close, rel_body_end)
    let body_after  = after_head.substring(rel_body_end)

    let client_js = _lumen_client_js_with_manifest(manifest)
    return head_prefix + meta_tags + _lumen_head() + "</head>" +
           body_before +
           "<div data-lumen-root>" + body_content + "</div>" +
           "<script>window.__LUMEN_WS__=\"" + ws_path + "\";" + client_js + _dev_inject + "</script>" +
           body_after
}

// ─── LumenJS modules catalog ───
// Each module registers itself against one or more data-lumen-* attributes.
// Modules are opt-in: only emitted if the page statically references the attribute.
// Every brace is escaped as \{/\} for Varian string interpolation.

// _lumen_module (the JS string catalog itself) lives in
// vn_modules/lumen/browser_directives.vn — a Constellation-style package
// subdirectory, explicitly loaded here so it stays out of the ambient
// top-level prelude (see docs/planning/FRAMEWORK_MODULARIZATION_PLAN.md).
// It is a pure function of `name`, so load order relative to the rest of
// this file doesn't matter as long as it's loaded before first call, below.
use "lumen"

// Scan a template string for directive attributes and return a list of required LumenJS module names.
// Looks for data-lumen-* attributes that map to known modules, data-lumen-hook=X, and event modifiers.
fn _lumen_scan_directives(tpl) {
    return _lumen_detect_actions(tpl)
}

// ─── LumenJS client runtime ───
//
// Core transport + DOM morph + error overlay. Always shipped.
// Modules (clipboard, focus, scroll, …) are appended by _lumen_shell
// based on the page's static directive manifest.
//
// Every brace is escaped as \{/\} so Varian's {expr} interpolation doesn't eat it.

// Core runtime — always included.
// Minimal always-on live transport. Browser event capture and virtual-table
// scrolling are registry actions, so passive server-push pages do not ship them.
fn _lumen_client_core() {
    return "(function()\{var r=document.querySelector('[data-lumen-root]'),w,P,q=[],b=250,c=0;function C()\{w=new WebSocket((location.protocol==='https:'?'wss://':'ws://')+location.host+window.__LUMEN_WS__);window.__lumen_ws=w;w.onmessage=function(e)\{var m=JSON.parse(e.data);if(m.t==='log')\{if(window.__lumen_onlog)window.__lumen_onlog(m.lines);return\}if(m.t==='error')\{E(m.msg);return\}var o=document.getElementById('__lumen_err');if(o)o.remove();if(m.t==='html')\{P=m.html;M(r,P)\}else if(m.t==='p')\{P=P.slice(0,m.s)+m.d+P.slice(P.length-m.e);M(r,P)\}b=250;r.classList.remove('lumen-pending');var x=r.querySelector('[data-lumen-pending]');if(x)x.removeAttribute('data-lumen-pending')\};w.onclose=function()\{setTimeout(C,b);b=Math.min(b*2,5e3)\};w.onopen=function()\{if(window.__LUMEN_DEV__&&c)\{try\{sessionStorage.setItem('__lumen_hot','1')\}catch(e)\{\}location.reload();return\}c=1;b=250;var d=document.getElementById('__LUMEN_DATA__');if(d)w.send(JSON.stringify(\{t:'init',state:JSON.parse(d.textContent)\}));while(q.length&&w.readyState===1)w.send(q.shift())\}\}window.__lumen_dispatch=function(h,v,l)\{var m=JSON.stringify(\{t:'event',h:h,v:v\});if(w&&w.readyState===1)\{w.send(m);if(window.__LUMEN_LOADING__)M(r,window.__LUMEN_LOADING__)\}else q.push(m);if(l)l.setAttribute('data-lumen-pending','');r.classList.add('lumen-pending')\};function M(a,h)\{var f=document.activeElement,s,e,x,y;if(f&&(f===a||a.contains(f)))\{s=f.selectionStart;e=f.selectionEnd;x=f.scrollLeft;y=f.scrollTop\}var t=a.cloneNode(false);t.innerHTML=h;R(a,t);if(f&&(f===a||a.contains(f)))\{try\{f.selectionStart=s;f.selectionEnd=e\}catch(z)\{\}f.scrollLeft=x;f.scrollTop=y\}var u=a.querySelector&&a.querySelector('[data-lumen-url]');if(u)\{var n=u.getAttribute('data-lumen-url')||'',p=location.pathname+n;if(p!==location.pathname+location.search)try\{history.replaceState(\{\},'',p)\}catch(z)\{\}\}\}function R(a,b)\{if(!a||!b)return;if(a.nodeType!==b.nodeType||a.nodeName!==b.nodeName)\{a.replaceWith(b.cloneNode(true));return\}if(a.nodeType===3)\{if(a.nodeValue!==b.nodeValue)a.nodeValue=b.nodeValue;return\}var i,f=document.activeElement,n=\{\};if(b.attributes)for(i=0;i<b.attributes.length;i++)n[b.attributes[i].name]=1;if(a.attributes)for(i=a.attributes.length-1;i>=0;i--)if(!n[a.attributes[i].name])a.removeAttribute(a.attributes[i].name);if(b.attributes)for(i=0;i<b.attributes.length;i++)\{var t=b.attributes[i];if(f&&a===f&&t.name==='value')continue;if(a.getAttribute(t.name)!==t.value)a.setAttribute(t.name,t.value)\}var ac=a.childNodes,bc=b.childNodes,m=Math.max(ac.length,bc.length);for(i=0;i<m;i++)\{if(!ac[i])a.appendChild(bc[i].cloneNode(true));else R(ac[i],bc[i])\}while(a.childNodes.length>bc.length)a.removeChild(a.lastChild)\}function E(m)\{var o=document.getElementById('__lumen_err');if(!o)\{o=document.createElement('div');o.id='__lumen_err';o.style.cssText='position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;justify-content:center;background:rgba(10,14,22,.8);font-family:ui-monospace,monospace';o.onclick=function(e)\{if(e.target===o)o.remove()\};document.body.appendChild(o)\}o.innerHTML='';var d=document.createElement('pre');d.style.cssText='max-width:780px;width:90%;margin:0;padding:22px;color:#e8eaf0;background:#1b2233;border-top:4px solid #f5b829;border-radius:14px;white-space:pre-wrap;word-break:break-word';d.textContent=m;o.appendChild(d)\}C()\})()"
}

// Runtime-error presentation is kept separate from transport so its cost is
// visible and can later be policy-controlled without touching live semantics.
fn _lumen_error_brand() {
    return "(function()\{function showErr(o)\{if(!o||o.__lumen_brand)return;o.__lumen_brand=1;var h=document.createElement('div');h.style.cssText='display:flex;align-items:center;gap:12px;padding:16px 22px;background:linear-gradient(90deg,#222b40,#1b2233);color:#f5b829;font-weight:800;letter-spacing:4px';h.innerHTML='<svg width=\"26\" height=\"26\" viewBox=\"0 0 48 48\"><rect x=\"3\" y=\"3\" width=\"42\" height=\"42\" rx=\"11\" fill=\"#222b40\"/><path d=\"M26 7 L15 27 h7 L19 41 L33 21 h-8 L29 7 Z\" fill=\"#f5b829\"/></svg><span>LUMEN</span>';o.insertBefore(h,o.firstChild)\}new MutationObserver(function()\{showErr(document.getElementById('__lumen_err'))\}).observe(document.body||document.documentElement,\{childList:true,subtree:true\})\})()"
}

fn _lumen_client_js_with_manifest_and_loading(manifest, loading_html) {
    let js = _lumen_client_core() + ";" + _lumen_error_brand()
    let resolved = _lumen_resolve_actions(manifest)
    for i in 0..resolved.len() {
        let mod_js = _lumen_module(resolved[i])
        if mod_js != "" { js = js + ";" + mod_js }
    }
    if loading_html != null and loading_html != "" {
        js = js + ";window.__LUMEN_LOADING__=\"" + _lumen_escape_string(loading_html) + "\";"
    }
    return js
}

fn _lumen_client_js_with_manifest(manifest) {
    return _lumen_client_js_with_manifest_and_loading(manifest, null)
}

fn _lumen_client_js() {
    return _lumen_client_core()
}

fn _lumen_shell_with_loading(inner, ws_path, manifest, loading_html) {
    let body_start = inner.index_of("<body")
    let body_end = inner.index_of("</body>")
    let head_end = inner.index_of("</head>")
    let meta_tags = _lumen_meta_tags()
    let _dev_inject = _lumen_dev_inject(manifest)
    let client_js = _lumen_client_js_with_manifest_and_loading(manifest, loading_html)

    if body_start == -1 or body_end == -1 {
        let head_html = _lumen_head()
        if meta_tags != "" { head_html = head_html + meta_tags }
        return "<!DOCTYPE html><html lang=\"en\"><head>" + head_html + "</head><body>" +
               "<div data-lumen-root>" + inner + "</div>" +
               "<script>window.__LUMEN_WS__=\"" + ws_path + "\";" + client_js + _dev_inject + "</script>" +
               "</body></html>"
    }

    let head_close = head_end
    if head_close < 0 { head_close = body_start }
    let head_prefix = inner.substring(0, head_close)
    let after_head  = inner.substring(head_close)

    let rel_body_open = body_start - head_close
    let rel_body_tag_close = inner.index_of(">", body_start) - head_close + 1
    let rel_body_end = body_end - head_close

    let body_before = after_head.substring(rel_body_open, rel_body_tag_close)
    let body_content = after_head.substring(rel_body_tag_close, rel_body_end)
    let body_after  = after_head.substring(rel_body_end)

    return head_prefix + meta_tags + _lumen_head() + "</head>" +
           body_before +
           "<div data-lumen-root>" + body_content + "</div>" +
           "<script>window.__LUMEN_WS__=\"" + ws_path + "\";" + client_js + _dev_inject + "</script>" +
           body_after
}


// Convenience wrapper — returns core only (backward-compatible).
fn _lumen_client_js() {
    return _lumen_client_core()
}

// ─── Browser devtools overlay (Next.js-style) ───
// Injected by _lumen_shell ONLY when LUMEN_DEV is set (the `vn dev` server
// sets it). Reads window.__LUMEN_DEV__ {mode,modules,ver}. mode 'aurora'
// => fullstack badge, anything else => Lumen frontend badge. Self-contained:
// observes the live root for renders/latency/errors, polls the WS for status.
fn _lumen_devtools() {
    return "(function()\{var cfg=window.__LUMEN_DEV__||\{\};var isA=cfg.mode==='aurora';var brand=isA?'Aurora':'Lumen';var ACC=isA?'#4FACFE':'#f5b829';var start=Date.now();var st=\{renders:0,patches:0,errors:0,trips:0,lat:0,latAvg:0,t0:0,open:false,lastConn:'',log:[],filter:'all',actq:[]\};var KCOL=\{net:ACC,patch:ACC,error:'#ff5f56',nav:'#a78bfa',ws:'#4dd4ac',server:'#22d3ee',info:'#71717a'\};var GROUP=\{all:null,net:['net','patch'],server:['ws','info','server','nav'],error:['error']\};var favEl=document.querySelector('link[rel=\"icon\"],link[rel=\"shortcut icon\"],link[rel*=\"icon\"]');var fav=(favEl&&favEl.href)?favEl.href:'/favicon-32x32.png';var favimg='<img src=\"'+fav+'\" alt=\"\" style=\"width:20px;height:20px;border-radius:5px;display:block;flex:none\">';function esc(s)\{return(''+s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\}function now()\{return new Date().toTimeString().slice(0,8);\}function fmt(v)\{if(v==null)return'';var s=typeof v==='string'?v:JSON.stringify(v);if(s.length>40)s=s.slice(0,38)+'…';return s;\}function logit(kind,msg)\{st.log.unshift(\{ts:now(),kind:kind,msg:msg\});if(st.log.length>80)st.log.pop();if(st.open)renderLog();updatePill();\}function conState()\{var w=window.__lumen_ws;if(!w)return'connecting';if(w.readyState===1)return'live';if(w.readyState===0)return'connecting';return'offline';\}function conColor()\{var s=conState();return s==='live'?'#4dd4ac':s==='connecting'?ACC:'#ff5f56';\}var box=document.createElement('div');box.id='__lumen_dev';box.style.cssText='position:fixed;left:16px;bottom:16px;z-index:2147483000;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;line-height:1.5;color:#fafafa';var panel=document.createElement('div');panel.style.cssText='display:none;flex-direction:column;width:380px;max-height:74vh;margin-bottom:12px;background:#09090b;border:1px solid #232327;border-radius:14px;box-shadow:0 28px 80px rgba(0,0,0,.65);overflow:hidden';var pill=document.createElement('button');pill.type='button';pill.title=brand+' devtools';pill.style.cssText='position:relative;width:38px;height:38px;padding:0;background:none;border:none;cursor:pointer;filter:drop-shadow(0 6px 18px rgba(0,0,0,.55));transition:transform .15s';pill.onmouseenter=function()\{pill.style.transform='scale(1.08)';\};pill.onmouseleave=function()\{pill.style.transform='scale(1)';\};box.appendChild(panel);box.appendChild(pill);(document.body||document.documentElement).appendChild(box);function updatePill()\{var c=conColor();var eb=st.errors>0?'<span style=\"position:absolute;top:-5px;right:-5px;background:#ff5f56;color:#fff;border-radius:999px;min-width:16px;height:16px;padding:0 4px;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 2px #000\">'+st.errors+'</span>':'';pill.innerHTML='<img src=\"'+fav+'\" alt=\"'+brand+'\" style=\"width:38px;height:38px;border-radius:10px;display:block\">'+'<span style=\"position:absolute;bottom:-2px;right:-2px;width:11px;height:11px;border-radius:50%;background:'+c+';box-shadow:0 0 8px '+c+',0 0 0 2px #000\"></span>'+eb;\}function statCell(label,val,col)\{return '<div style=\"background:#131316;border:1px solid #232327;border-radius:10px;padding:9px 11px\"><div style=\"color:#71717a;font-size:10px;text-transform:uppercase;letter-spacing:.5px\">'+label+'</div><div style=\"color:'+(col||'#fafafa')+';font-size:18px;font-weight:700;margin-top:2px\">'+val+'</div></div>';\}function chip(id,label)\{var on=st.filter===id;return '<span data-f=\"'+id+'\" style=\"cursor:pointer;padding:2px 9px;border-radius:999px;font-size:10px;border:1px solid '+(on?ACC:'#232327')+';color:'+(on?'#09090b':'#a1a1aa')+';background:'+(on?ACC:'transparent')+'\">'+label+'</span>';\}function renderLog()\{var el=document.getElementById('__ld_log');if(!el)return;var grp=GROUP[st.filter];var rows=st.log.filter(function(e)\{return!grp||grp.indexOf(e.kind)>=0;\});if(rows.length===0)\{el.innerHTML='<div style=\"color:#52525b;padding:14px;text-align:center\">No events.</div>';return;\}var h='';for(var i=0;i<rows.length;i++)\{var e=rows[i];var col=KCOL[e.kind]||'#71717a';h+='<div style=\"display:flex;gap:9px;padding:6px 12px;border-bottom:1px solid #18181b;align-items:baseline\">'+'<span style=\"color:#52525b;font-size:10px;flex:none;width:54px\">'+e.ts+'</span>'+'<span style=\"color:'+col+';font-size:10px;font-weight:700;text-transform:uppercase;flex:none;width:46px\">'+e.kind+'</span>'+'<span style=\"color:#d4d4d8;word-break:break-word\">'+esc(e.msg)+'</span></div>';\}el.innerHTML=h;\}function renderPanel()\{var cs=conState();var cc=conColor();var up=Math.floor((Date.now()-start)/1000);var ups=up<60?up+'s':Math.floor(up/60)+'m '+(up%60)+'s';var mods=(cfg.modules&&cfg.modules.length)?cfg.modules.join(', '):'core only';var head='<div style=\"display:flex;align-items:center;gap:9px;padding:13px 14px;border-bottom:1px solid #232327;background:linear-gradient(90deg,'+(isA?'rgba(79,172,254,.10)':'rgba(245,184,41,.10)')+',transparent)\">'+favimg+'<span style=\"font-weight:800;letter-spacing:.4px\">'+brand+'</span>'+'<span style=\"color:#71717a;font-size:11px\">'+(isA?'fullstack devtools':'frontend devtools')+'</span>'+'<span id=\"__ld_x\" title=\"Esc\" style=\"margin-left:auto;cursor:pointer;color:#71717a;padding:0 6px;font-size:14px\">✕</span></div>';var status='<div style=\"display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid #18181b\">'+'<span style=\"width:10px;height:10px;border-radius:50%;background:'+cc+';box-shadow:0 0 10px '+cc+'\"></span>'+'<span style=\"font-weight:700;letter-spacing:.5px;color:'+cc+'\">'+cs.toUpperCase()+'</span>'+'<span style=\"color:#52525b;font-size:11px\">'+esc(location.pathname)+'</span>'+'<span style=\"margin-left:auto;color:#52525b;font-size:11px\">'+(isA?'uptime '+ups:'v'+(cfg.ver||'dev'))+'</span></div>';var grid='<div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;padding:12px 14px\">'+statCell('Renders',st.renders)+statCell('Actions',st.trips,ACC)+statCell('Errors',st.errors,st.errors?'#ff5f56':'#fafafa')+statCell('Avg',st.latAvg?st.latAvg+'ms':'—')+statCell('Patches',st.patches)+statCell('Modules',(cfg.modules&&cfg.modules.length)||0)+'</div>';var loghd='<div style=\"display:flex;align-items:center;gap:6px;padding:7px 14px;border-top:1px solid #232327;border-bottom:1px solid #232327;background:#0d0d0f\">'+chip('all','All')+chip('net','Network')+chip('server','Server')+chip('error','Errors')+'<span style=\"margin-left:auto;color:#52525b;font-size:10px\">'+mods+'</span></div>';var logbox='<div id=\"__ld_log\" style=\"overflow-y:auto;flex:1;min-height:90px\"></div>';var foot='<div style=\"display:flex;align-items:center;gap:8px;padding:10px 14px;border-top:1px solid #232327\">'+'<a href=\"/\" style=\"color:'+ACC+';text-decoration:none;font-size:11px\">Home</a>'+'<span id=\"__ld_clr\" style=\"cursor:pointer;color:#a1a1aa;font-size:11px\">Clear</span>'+'<span style=\"margin-left:auto;color:#52525b;font-size:10px\">window.__lumen · Esc to close</span></div>';panel.innerHTML=head+status+grid+loghd+logbox+foot;renderLog();var x=document.getElementById('__ld_x');if(x)x.onclick=function(ev)\{ev.stopPropagation();toggle(false);\};var clr=document.getElementById('__ld_clr');if(clr)clr.onclick=function(ev)\{ev.stopPropagation();st.log=[];st.errors=0;logit('info','log cleared');renderPanel();\};var fs=panel.querySelectorAll('[data-f]');for(var i=0;i<fs.length;i++)\{fs[i].onclick=function(ev)\{ev.stopPropagation();st.filter=this.getAttribute('data-f');renderPanel();\};\}\}function toggle(v)\{st.open=(v===undefined)?!st.open:v;panel.style.display=st.open?'flex':'none';if(st.open)renderPanel();\}pill.onclick=function()\{toggle();\};document.addEventListener('keydown',function(e)\{if(e.key==='Escape'&&st.open)toggle(false);\});var _send=WebSocket.prototype.send;WebSocket.prototype.send=function(data)\{try\{var m=JSON.parse(data);if(m&&m.t==='event')\{st.actq.push(\{h:m.h,t0:Date.now()\});logit('net','→ '+m.h+'('+fmt(m.v)+')');\}\}catch(_e)\{\}return _send.apply(this,arguments);\};var root=document.querySelector('[data-lumen-root]');if(root)\{new MutationObserver(function(m)\{for(var i=0;i<m.length;i++)\{if(m[i].attributeName==='class')\{var pend=root.classList.contains('lumen-pending');if(pend&&!st.t0)\{st.t0=Date.now();\}else if(!pend&&st.t0)\{st.lat=Date.now()-st.t0;st.t0=0;st.trips++;st.patches++;st.latAvg=Math.round((st.latAvg*(st.trips-1)+st.lat)/st.trips);var a=st.actq.shift();var nm=a?a.h:'action';logit('net','✓ '+nm+' · server '+st.lat+'ms');\}\}\}\}).observe(root,\{attributes:true,attributeFilter:['class']\});var rt;new MutationObserver(function()\{clearTimeout(rt);rt=setTimeout(function()\{st.renders++;if(st.open)renderPanel();\},50);\}).observe(root,\{childList:true,subtree:true,characterData:true\});\}new MutationObserver(function()\{var o=document.getElementById('__lumen_err');if(o&&!o.__ld)\{o.__ld=1;st.errors++;var pre=o.querySelector('pre');logit('error',pre?pre.textContent.split(String.fromCharCode(10))[0]:'runtime error');\}\}).observe(document.body||document.documentElement,\{childList:true\});window.addEventListener('popstate',function()\{logit('nav','navigated → '+location.pathname);\});function poll()\{var s=conState();if(s!==st.lastConn)\{st.lastConn=s;logit('ws','socket '+s);\}updatePill();if(st.open)renderPanel();\}window.__lumen=\{send:function(h,v)\{var w=window.__lumen_ws;if(w&&w.readyState===1)\{w.send(JSON.stringify(\{t:'event',h:h,v:v===undefined?null:v\}));return true;\}return false;\},reload:function()\{location.reload();\},open:function()\{toggle(true);\},clear:function()\{st.log=[];st.errors=0;if(st.open)renderPanel();\},stats:function()\{return\{renders:st.renders,actions:st.trips,patches:st.patches,errors:st.errors,avgMs:st.latAvg\};\},log:st.log\};window.__lumen_onlog=function(lines)\{if(!lines)return;for(var i=0;i<lines.length;i++)logit('server',lines[i]);\};updatePill();logit('info','devtools ready · '+brand+' '+(isA?'fullstack':'frontend'));logit('info','console API: window.__lumen.send(handler,value)');try\{if(sessionStorage.getItem('__lumen_hot'))\{sessionStorage.removeItem('__lumen_hot');logit('info','⚡ hot reload applied');\}\}catch(_e)\{\}setInterval(poll,1000);\})();"
}

// Build the dev-overlay injection: empty in production, the devtools script
// when LUMEN_DEV is set (the `vn dev` server sets it; default "aurora", user
// can `LUMEN_DEV=lumen vn dev` for the Lumen-only badge).
fn _lumen_dev_inject(manifest) {
    let dev = env.get("LUMEN_DEV")
    if dev == null { return "" }
    if dev == "" { return "" }
    let ver = env.get("VN_VERSION")
    if ver == null { ver = "dev" }
    let modjs = "["
    let resolved = _lumen_resolve_actions(manifest)
    if resolved != null {
        for i in 0..resolved.len() {
            if i > 0 { modjs = modjs + "," }
            modjs = modjs + "\"" + resolved[i] + "\""
        }
    }
    modjs = modjs + "]"
    return ";window.__LUMEN_DEV__=\{mode:\"" + dev + "\",modules:" + modjs + ",ver:\"" + ver + "\"\};" + _lumen_devtools()
}

let presence = http.create_struct(
    ["join", "leave", "list"],
    [lumen_presence_join, lumen_presence_leave, lumen_presence_list]
)
let aurora = http.create_struct(["presence"], [presence])
