// ============================================================================
//  Zenith request helpers — query strings, form bodies, cookies, uploads
//
//  Collections here are plain structs built with http.create_struct(): read a
//  field with _validate.get_field(s, key) (returns null when absent) and list
//  keys with _validate.get_keys(s). The query()/form()/cookie() accessors wrap
//  that so handler code never touches _validate directly.
// ============================================================================

fn _hex_nibble(c) {
    if c >= 48 and c <= 57 { return c - 48 }      // '0'..'9'
    if c >= 97 and c <= 102 { return c - 87 }     // 'a'..'f'
    if c >= 65 and c <= 70 { return c - 55 }      // 'A'..'F'
    return -1
}

// Percent-decode a URL-encoded component ("%20" -> space, "+" -> space).
// Invalid/short escapes are passed through literally rather than dropped.
fn url_decode(s) {
    if s == null { return "" }
    let out = []
    let n = s.len()
    let i = 0
    while i < n {
        let c = s.code_at(i)
        if c == 37 and i + 2 < n {                 // '%'
            let hi = _hex_nibble(s.code_at(i + 1))
            let lo = _hex_nibble(s.code_at(i + 2))
            if hi >= 0 and lo >= 0 {
                out = out.push(hi * 16 + lo)
                i = i + 3
            } else {
                out = out.push(c)
                i = i + 1
            }
        } else if c == 43 {                        // '+'
            out = out.push(32)
            i = i + 1
        } else {
            out = out.push(c)
            i = i + 1
        }
    }
    return "".from_codes(out)
}

// Parse "a=1&b=two&flag" into a struct {a:"1", b:"two", flag:""}, decoding
// both keys and values. Empty segments (e.g. trailing "&") are skipped.
fn parse_pairs(s) {
    let keys = []
    let vals = []
    if s == null or s == "" {
        return http.create_struct(keys, vals)
    }
    let pairs = s.split("&")
    for i in 0..pairs.len() {
        let p = pairs[i]
        if p == "" { continue }
        let eq = p.index_of("=")
        if eq < 0 {
            keys = keys.push(url_decode(p))
            vals = vals.push("")
        } else {
            keys = keys.push(url_decode(p.substring(0, eq)))
            vals = vals.push(url_decode(p.substring(eq + 1, p.len())))
        }
    }
    return http.create_struct(keys, vals)
}

// All query-string parameters as a struct.
fn query_params(req) {
    return parse_pairs(_get_req_field(req, "query", ""))
}

// A single query parameter, or `default` when absent.
fn query(req, key, default) {
    let v = _validate.get_field(query_params(req), key)
    if v == null { return default }
    return v
}

// All application/x-www-form-urlencoded body fields as a struct.
fn form_params(req) {
    return parse_pairs(_get_req_field(req, "body", ""))
}

// A single form field, or `default` when absent.
fn form(req, key, default) {
    let v = _validate.get_field(form_params(req), key)
    if v == null { return default }
    return v
}

// ── Cookies ────────────────────────────────────────────────────────────────

// Parse the inbound Cookie header ("a=1; b=2") into a struct.
fn cookies(req) {
    let keys = []
    let vals = []
    let headers = _get_req_field(req, "headers", null)
    let raw = null
    if headers != null {
        raw = _validate.get_field(headers, "cookie")
    }
    if raw == null or raw == "" {
        return http.create_struct(keys, vals)
    }
    let parts = raw.split(";")
    for i in 0..parts.len() {
        let p = _sanitize.trim(parts[i])
        if p == "" { continue }
        let eq = p.index_of("=")
        if eq < 0 { continue }
        keys = keys.push(p.substring(0, eq))
        vals = vals.push(url_decode(p.substring(eq + 1, p.len())))
    }
    return http.create_struct(keys, vals)
}

// A single inbound cookie value, or `default` when absent.
fn cookie(req, name, default) {
    let v = _validate.get_field(cookies(req), name)
    if v == null { return default }
    return v
}

// ============================================================================
//  File upload helpers — multipart/form-data accessors
//
//  These functions read the _multipart field that the HTTP parser populates
//  when Content-Type is multipart/form-data. The field is a struct with:
//    .fields  — struct of regular form field name → value
//    .files   — array of { fieldname, filename, content_type, data }
// ============================================================================

fn _get_multipart(req) {
    let mp = _get_req_field(req, "_multipart", null)
    if mp == null { return null }
    return mp
}

// Returns the files array from a multipart request, or null if none.
fn uploaded_files(req) {
    let mp = _get_multipart(req)
    if mp == null { return null }
    let files = _validate.get_field(mp, "files")
    return files
}

// Returns a single file struct by fieldname, or null if not found.
fn uploaded_file(req, fieldname) {
    let mp = _get_multipart(req)
    if mp == null { return null }
    let files = _validate.get_field(mp, "files")
    if files == null { return null }
    for i in 0..files.len() {
        let f = files[i]
        let fn_field = _validate.get_field(f, "fieldname")
        if fn_field == fieldname {
            return f
        }
    }
    return null
}

// Returns a form field value from a multipart request, or default if absent.
// This is for fields that were part of a multipart form (not urlencoded).
fn form_field(req, name, default) {
    let mp = _get_multipart(req)
    if mp == null { return default }
    let fields = _validate.get_field(mp, "fields")
    if fields == null { return default }
    let v = _validate.get_field(fields, name)
    if v == null { return default }
    return v
}

// Saves an uploaded file struct to disk. `file` is a struct returned from
// uploaded_files() or uploaded_file() with { fieldname, filename, content_type, data }.
// Returns the full path to the saved file, or null on failure.
fn save_upload(file, directory) {
    let filename = _validate.get_field(file, "filename")
    let data = _validate.get_field(file, "data")
    if filename == null or data == null { return null }
    // Sanitize filename — strip directory separators for safety
    let safe_name = filename.replace("/", "_").replace("\\", "_")
    let full_path = directory + "/" + safe_name
    let result = io.write_bytes(full_path, data)
    if result == null { return null }
    return full_path
}
