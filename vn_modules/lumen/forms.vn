// Lumen schema-bound forms and progressive live enhancement.
// Native HTML remains the transport baseline; event JS is emitted only when enabled.

// ─── Pillar 3: schema-bound forms — declare fields + validators once, get a
// live, server-validated form. Per-field @input gives inline validation as the
// user types; @submit validates all via lumen_form then calls on_submit(values).
// Because a successful on_submit writes the DB, any Pillar-1 live_query / Pillar-2
// table on that table auto-updates. ───

// Helper: build a per-field setter handler (separate fn so each closure captures
// its own field name — avoids loop-variable capture bugs).
fn _df_make_setter(core, name) {
    return |s, v| { let _ = (core.set_field)(name, v); return s }
}

fn _df_make_live_setter(cfg, name) {
    return |s, v| {
        let fields = _validate.get_field(cfg, "fields")
        let validator = null
        let field = null
        let fi = 0
        while fi < fields.len() {
            let f = fields[fi]
            if _validate.get_field(f, "name") == name {
                field = f
                validator = _validate.get_field(f, "validator")
                break
            }
            fi = fi + 1
        }
        v = _df_coerce_field(field, v)
        s.values = _tpl_bind(s.values, name, v)
        if validator != null {
            let res = _validate_parse(validator, v)
            if res.success {
                s.errors = _tpl_bind(s.errors, name, null)
            } else {
                s.errors = _tpl_bind(s.errors, name, res.error)
            }
        }
        return s
    }
}

fn _df_coerce_field(field, value) {
    if field == null { return value }
    let field_type = _validate.get_field(field, "type")
    if field_type == "number" and type_of(value) == "string" {
        let parsed = null
        try { parsed = json_decode(value) } catch e { return value }
        let parsed_type = type_of(parsed)
        if parsed_type == "int" or parsed_type == "float" { return parsed }
    }
    if field_type == "checkbox" {
        if type_of(value) == "bool" { return value }
        if value == "true" or value == "on" or value == "1" { return true }
        if value == "false" or value == "off" or value == "0" or value == "" { return false }
    }
    return value
}

fn _df_find_field(fields, name) {
    for i in 0..fields.len() {
        if _validate.get_field(fields[i], "name") == name { return fields[i] }
    }
    return null
}

fn _df_passthrough_validator() {
    let parse = |value| { return http.create_struct(["success", "data"], [true, value]) }
    return http.create_struct(["parse"], [parse])
}

fn _df_contract(fields) {
    let names = []
    let schema_keys = []
    let schema_values = []
    let allowed_types = ["text", "email", "password", "number", "date", "datetime-local", "search", "url", "tel", "textarea", "select", "checkbox", "hidden"]
    for i in 0..fields.len() {
        let field = fields[i]
        let name = _validate.get_field(field, "name")
        if _lumen_is_simple_ident(name) == false { throw("Lumen form: field names must be identifiers") }
        for j in 0..names.len() { if names[j] == name { throw("Lumen form: duplicate field '" + name + "'") } }
        let field_type = _validate.get_field(field, "type")
        if field_type == null { field_type = "text" }
        let valid_type = false
        for j in 0..allowed_types.len() { if allowed_types[j] == field_type { valid_type = true } }
        if valid_type == false { throw("Lumen form: unsupported field type '" + field_type + "'") }
        if field_type == "select" and _validate.get_field(field, "options") == null {
            throw("Lumen form: select field '" + name + "' requires options")
        }
        names = names.push(name)
        schema_keys = schema_keys.push(name)
        let validator = _validate.get_field(field, "validator")
        if validator == null { validator = _df_passthrough_validator() }
        schema_values = schema_values.push(validator)
    }
    return http.create_struct(["names", "schema"], [names, http.create_struct(schema_keys, schema_values)])
}

fn _df_result(result) {
    if result == null or type_of(result) != "struct" {
        return http.create_struct(["ok", "message", "errors"], [true, null, http.create_struct([], [])])
    }
    let ok = _validate.get_field(result, "ok")
    if ok == null { ok = true }
    let message = _validate.get_field(result, "message")
    let errors = _validate.get_field(result, "errors")
    if errors == null { errors = http.create_struct([], []) }
    return http.create_struct(["ok", "message", "errors"], [ok, message, errors])
}

fn _df_submission_values(current, fields, payload) {
    let values = current
    if payload == null or type_of(payload) != "struct" { return values }
    for i in 0..fields.len() {
        let name = _validate.get_field(fields[i], "name")
        let value = _validate.get_field(payload, name)
        if value != null {
            values = _tpl_bind(values, name, _df_coerce_field(fields[i], value))
        } else if _validate.get_field(fields[i], "type") == "checkbox" {
            // Unchecked controls are intentionally absent from FormData. The
            // submit payload is authoritative, so absence means false rather
            // than retaining a stale true value from server state.
            values = _tpl_bind(values, name, false)
        }
    }
    return values
}

fn data_form(opts) {
    let fields = _validate.get_field(opts, "fields")
    if fields == null { fields = [] }
    if type_of(fields) != "array" { throw("Lumen form: fields must be an array") }
    let on_submit = _validate.get_field(opts, "on_submit")
    let submit_label = _validate.get_field(opts, "submit_label")
    if submit_label == null { submit_label = "Submit" }
    let initial_values = _validate.get_field(opts, "initial_values")
    if initial_values == null { initial_values = http.create_struct([], []) }
    if type_of(initial_values) != "struct" { throw("Lumen form: initial_values must be a struct") }
    let action = _validate.get_field(opts, "action")
    if action == null { action = "" }
    if type_of(action) != "string" or action.index_of("\r") >= 0 or action.index_of("\n") >= 0 {
        throw("Lumen form: action must be a string without line breaks")
    }
    let method = _validate.get_field(opts, "method")
    if method == null { method = "post" }
    if type_of(method) != "string" { throw("Lumen form: method must be get or post") }
    method = method.lower()
    if method != "get" and method != "post" { throw("Lumen form: native method must be get or post") }
    let enhance = _validate.get_field(opts, "enhance")
    if enhance == null { enhance = true }
    if type_of(enhance) != "bool" { throw("Lumen form: enhance must be a boolean") }

    let contract = _df_contract(fields)
    let names = contract.names
    let schema = contract.schema
    let form = lumen_form(schema)

    let st_values = [initial_values]
    let st_errors = [http.create_struct([], [])]
    let st_status = ["idle"]
    let st_message = [null]

    let values = | | { return st_values[0] }
    let errors = | | { return st_errors[0] }
    let status = | | { return st_status[0] }
    let message = | | { return st_message[0] }

    let _wake = | | { let _ = _lumen_async_updates <- true; return null }

    // live-validate a single field; returns an error string or null
    let _validate_one = |name, val| {
        let validator = _validate.get_field(schema, name)
        if validator == null { return null }
        let res = _validate_parse(validator, val)
        if res.success { return null }
        return res.error
    }

    let set_field = |name, val| {
        let field = _df_find_field(fields, name)
        if field == null { throw("Lumen form: unknown field '" + name + "'") }
        val = _df_coerce_field(field, val)
        st_values[0] = _tpl_bind(st_values[0], name, val)
        let err = (_validate_one)(name, val)
        st_errors[0] = _tpl_bind(st_errors[0], name, err)
        return (_wake)()
    }

    let submit = | | {
        st_status[0] = "saving"
        let r = (form.validate)(st_values[0])
        if r.ok {
            st_errors[0] = http.create_struct([], [])
            if on_submit != null {
                try {
                    let outcome = _df_result(on_submit(r.values))
                    if outcome.ok {
                        st_status[0] = "saved"
                        st_message[0] = outcome.message
                    } else {
                        st_status[0] = "error"
                        st_message[0] = outcome.message
                        st_errors[0] = outcome.errors
                    }
                } catch e {
                    st_status[0] = "error"
                    st_message[0] = "" + e
                }
            } else {
                st_status[0] = "saved"
                st_message[0] = null
            }
        } else {
            st_errors[0] = r.errors
            st_status[0] = "error"
            st_message[0] = null
        }
        return (_wake)()
    }

    let reset = | | {
        st_values[0] = initial_values
        st_errors[0] = http.create_struct([], [])
        st_status[0] = "idle"
        st_message[0] = null
        return (_wake)()
    }

    return http.create_struct(
        ["fields", "names", "submit_label", "action", "method", "enhance", "values", "errors", "status", "message", "set_field", "submit", "reset"],
        [fields, names, submit_label, action, method, enhance, values, errors, status, message, set_field, submit, reset]
    )
}

fn _df_render_field(field, values, errors, enhance) {
    let name = _validate.get_field(field, "name")
    let label = _validate.get_field(field, "label")
    if label == null { label = name }
    let field_type = _validate.get_field(field, "type")
    if field_type == null { field_type = "text" }
    let placeholder = _validate.get_field(field, "placeholder")
    if placeholder == null { placeholder = "" }
    let hint = _validate.get_field(field, "hint")
    let current = _validate.get_field(values, name)
    if current == null { current = "" }
    let error = _validate.get_field(errors, name)
    let id = "lmn-field-" + name
    let handler = "df_set_" + name
    let input_event = ""
    let change_event = ""
    if enhance {
        input_event = " @input=\"" + handler + "\""
        change_event = " @change=\"" + handler + "\""
    }
    let required = ""
    if _validate.get_field(field, "required") == true { required = " required" }
    let disabled = ""
    if _validate.get_field(field, "disabled") == true { disabled = " disabled" }
    let autocomplete = _validate.get_field(field, "autocomplete")
    let autocomplete_attr = ""
    if autocomplete != null { autocomplete_attr = " autocomplete=\"" + _sanitize.escape_html("" + autocomplete) + "\"" }
    let described = ""
    if error != null or hint != null { described = " aria-describedby=\"" + id + "-help\"" }
    let invalid = ""
    if error != null { invalid = " aria-invalid=\"true\"" }

    let html = "<div class=\"lmn-field\"><label class=\"lmn-field-label\" for=\"" + id + "\">" + _sanitize.escape_html("" + label) + "</label>"
    if field_type == "textarea" {
        html = html + "<textarea id=\"" + id + "\" name=\"" + name + "\" class=\"lmn-input\"" + input_event + " placeholder=\"" + _sanitize.escape_html("" + placeholder) + "\"" + required + disabled + autocomplete_attr + described + invalid + ">" + _sanitize.escape_html("" + current) + "</textarea>"
    } else if field_type == "select" {
        html = html + "<select id=\"" + id + "\" name=\"" + name + "\" class=\"lmn-input\"" + change_event + required + disabled + described + invalid + ">"
        let options = _validate.get_field(field, "options")
        for i in 0..options.len() {
            let option = options[i]
            let value = option
            let option_label = option
            if type_of(option) == "struct" {
                value = _validate.get_field(option, "value")
                option_label = _validate.get_field(option, "label")
                if option_label == null { option_label = value }
            }
            let selected = ""
            if "" + value == "" + current { selected = " selected" }
            html = html + "<option value=\"" + _sanitize.escape_html("" + value) + "\"" + selected + ">" + _sanitize.escape_html("" + option_label) + "</option>"
        }
        html = html + "</select>"
    } else if field_type == "checkbox" {
        let checked = ""
        if current == true { checked = " checked" }
        html = html + "<input id=\"" + id + "\" name=\"" + name + "\" class=\"lmn-checkbox\" type=\"checkbox\" value=\"true\"" + change_event + checked + required + disabled + described + invalid + " />"
    } else {
        html = html + "<input id=\"" + id + "\" name=\"" + name + "\" class=\"lmn-input\" type=\"" + field_type + "\" value=\"" + _sanitize.escape_html("" + current) + "\" placeholder=\"" + _sanitize.escape_html("" + placeholder) + "\"" + input_event + required + disabled + autocomplete_attr + described + invalid + " />"
    }
    if error != null {
        html = html + "<p id=\"" + id + "-help\" class=\"lmn-field-error\">" + _sanitize.escape_html("" + error) + "</p>"
    } else if hint != null {
        html = html + "<p id=\"" + id + "-help\" class=\"lmn-field-hint\">" + _sanitize.escape_html("" + hint) + "</p>"
    }
    return html + "</div>"
}

// Render a data_form core to live HTML (label + input/textarea + inline error per
// field, submit button, status message). Run through lumen_render so events bind.
fn _data_form_html(core) {
    let fields = core.fields
    let vals = (core.values)()
    let errs = (core.errors)()

    let submit_event = ""
    if core.enhance { submit_event = " @submit=\"df_submit\"" }
    let body = "<form class=\"lmn-form\" method=\"" + core.method + "\" action=\"" + _sanitize.escape_html("" + core.action) + "\"" + submit_event + ">"
    let fi = 0
    while fi < fields.len() {
        body = body + _df_render_field(fields[fi], vals, errs, core.enhance)
        fi = fi + 1
    }

    let st = (core.status)()
    let msg = (core.message)()
    let msg_html = ""
    if st == "saved" {
        let success_message = "Saved."
        if msg != null { success_message = "" + msg }
        msg_html = "<p class=\"lmn-form-msg\" data-tone=\"success\">" + _sanitize.escape_html(success_message) + "</p>"
    } else {
        if st == "error" and msg != null {
            msg_html = "<p class=\"lmn-form-msg\" data-tone=\"danger\">" + _sanitize.escape_html("" + msg) + "</p>"
        }
    }

    body = body + "<div class=\"lmn-form-actions\"><button class=\"lmn-btn\" data-variant=\"primary\" type=\"submit\">" + _sanitize.escape_html("" + core.submit_label) + "</button>" + msg_html + "</div>"
    body = body + "</form>"
    return lumen_render(body, {})
}

// Build a live, mountable schema-bound form component.
//   let f = data_form_component({ fields: [
//       {name:"email", label:"Email", type:"email", validator: validate.str().is_email()},
//       {name:"name",  label:"Name",  validator: validate.str().min(2)} ],
//       on_submit: |values| { (conn.execute)("INSERT INTO users (email,name) VALUES (?,?)",
//                                             [values.email, values.name]) } })
//   lumen_mount(app, "/signup", f)
fn data_form_component(opts) {
    let fields = _validate.get_field(opts, "fields")
    if fields == null { fields = [] }
    if type_of(fields) != "array" { throw("Lumen form: fields must be an array") }
    let on_submit = _validate.get_field(opts, "on_submit")
    let submit_label = _validate.get_field(opts, "submit_label")
    if submit_label == null { submit_label = "Submit" }
    let initial_values = _validate.get_field(opts, "initial_values")
    if initial_values == null { initial_values = http.create_struct([], []) }
    if type_of(initial_values) != "struct" { throw("Lumen form: initial_values must be a struct") }
    let action = _validate.get_field(opts, "action")
    if action == null { action = "" }
    if type_of(action) != "string" or action.index_of("\r") >= 0 or action.index_of("\n") >= 0 {
        throw("Lumen form: action must be a string without line breaks")
    }
    let method = _validate.get_field(opts, "method")
    if method == null { method = "post" }
    if type_of(method) != "string" { throw("Lumen form: method must be get or post") }
    method = method.lower()
    if method != "get" and method != "post" { throw("Lumen form: native method must be get or post") }
    let enhance = _validate.get_field(opts, "enhance")
    if enhance == null { enhance = true }
    if type_of(enhance) != "bool" { throw("Lumen form: enhance must be a boolean") }

    let contract = _df_contract(fields)
    let names = contract.names
    let schema = contract.schema
    let form = lumen_form(schema)

    let cfg = http.create_struct(
        ["fields", "names", "submit_label", "on_submit", "form", "initial_values", "action", "method", "enhance"],
        [fields, names, submit_label, on_submit, form, initial_values, action, method, enhance]
    )

    let state_fn = | | {
        return http.create_struct(["values", "errors", "status", "message"],
            [initial_values, http.create_struct([], []), "idle", null])
    }

    let render_fn = |s| { return _render_df_live(cfg, s) }

    let handler_names = ["df_submit", "df_reset"]
    let handler_fns = [
        |s, v| {
            let form = _validate.get_field(cfg, "form")
            let on_submit = _validate.get_field(cfg, "on_submit")
            s.values = _df_submission_values(s.values, fields, v)
            s.status = "saving"
            let r = (form.validate)(s.values)
            if r.ok {
                s.errors = http.create_struct([], [])
                if on_submit != null {
                    try {
                        let outcome = _df_result(on_submit(r.values))
                        if outcome.ok {
                            s.status = "saved"
                            s.message = outcome.message
                        } else {
                            s.status = "error"
                            s.message = outcome.message
                            s.errors = outcome.errors
                        }
                    } catch e {
                        s.status = "error"
                        s.message = "" + e
                    }
                } else {
                    s.status = "saved"
                    s.message = null
                }
            } else {
                s.errors = r.errors
                s.status = "error"
                s.message = null
            }
            return s
        },
        |s, v| {
            s.values = initial_values
            s.errors = http.create_struct([], [])
            s.status = "idle"
            s.message = null
            return s
        }
    ]
    let i = 0
    while i < names.len() {
        let nm = names[i]
        handler_names = handler_names.push("df_set_" + nm)
        handler_fns = handler_fns.push(_df_make_live_setter(cfg, nm))
        i = i + 1
    }
    return lumen_component(state_fn, render_fn, handler_names, handler_fns)
}

fn _render_df_live(cfg, s) {
    let fields = _validate.get_field(cfg, "fields")
    let submit_label = _validate.get_field(cfg, "submit_label")
    let vals = s.values
    let errs = s.errors

    let method = _validate.get_field(cfg, "method")
    let action = _validate.get_field(cfg, "action")
    let enhance = _validate.get_field(cfg, "enhance")
    let submit_event = ""
    if enhance { submit_event = " @submit=\"df_submit\"" }
    let body = "<form class=\"lmn-form\" method=\"" + method + "\" action=\"" + _sanitize.escape_html("" + action) + "\"" + submit_event + ">"
    let fi = 0
    while fi < fields.len() {
        body = body + _df_render_field(fields[fi], vals, errs, enhance)
        fi = fi + 1
    }

    let st = s.status
    let msg = s.message
    let msg_html = ""
    if st == "saved" {
        let success_message = "Saved."
        if msg != null { success_message = "" + msg }
        msg_html = "<p class=\"lmn-form-msg\" data-tone=\"success\">" + _sanitize.escape_html(success_message) + "</p>"
    } else {
        if st == "error" and msg != null {
            msg_html = "<p class=\"lmn-form-msg\" data-tone=\"danger\">" + _sanitize.escape_html("" + msg) + "</p>"
        }
    }

    body = body + "<div class=\"lmn-form-actions\"><button class=\"lmn-btn\" data-variant=\"primary\" type=\"submit\">" + _sanitize.escape_html("" + submit_label) + "</button>" + msg_html + "</div>"
    body = body + "</form>"
    return lumen_render(body, {})
}


// ─── Lumen form: validated form fields (Zod-style) ───
// `lumen_form(field_schemas)` where field_schemas maps name -> validator.
// Returns { validate(values) -> { ok, values, errors } }.
//
// Usage:
//   let f = lumen_form(http.create_struct(["email"], [validate.str().is_email()]))
//   let r = (f.validate)(form_values)
//   if r.ok { ...save r.values... } else { state.errors = r.errors }
//   template:  {{ errors.email }}
fn lumen_form(field_schemas) {
    let validate = |values| {
        let schema_keys = _validate.get_keys(field_schemas)
        let error_keys = []
        let error_vals = []
        let clean_keys = []
        let clean_vals = []
        for ki in 0..schema_keys.len() {
            let key = schema_keys[ki]
            let validator = _validate.get_field(field_schemas, key)
            let val = _validate.get_field(values, key)
            let res = _validate_parse(validator, val)
            if res.success {
                clean_keys = clean_keys.push(key)
                clean_vals = clean_vals.push(res.data)
            } else {
                error_keys = error_keys.push(key)
                error_vals = error_vals.push(res.error)
            }
        }
        let ok = error_keys.len() == 0
        let clean_struct = http.create_struct(clean_keys, clean_vals)
        let errors_struct = http.create_struct(error_keys, error_vals)
        return http.create_struct(["ok","values","errors"], [ok, clean_struct, errors_struct])
    }
    return http.create_struct(["validate"], [validate])
}
