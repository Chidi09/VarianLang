// Lumen live-channel security policy. Browser WebSockets are not covered by
// CORS, so every mount consults this package before performing an upgrade.
// The top-level lumen.vn facade loads this file through `use "lumen"`.

let _lumen_live_trusted_origins = []

fn _lumen_valid_origin(origin) {
    if origin == null or origin == "" or origin == "null" { return false }
    let authority_at = 7
    if origin.index_of("https://") == 0 { authority_at = 8 }
    else if origin.index_of("http://") != 0 { return false }
    if origin.len() <= authority_at { return false }
    return origin.index_of("/", authority_at) < 0 and origin.index_of("\\", authority_at) < 0 and
           origin.index_of("?") < 0 and origin.index_of("#") < 0 and
           origin.index_of("\r") < 0 and origin.index_of("\n") < 0
}

fn lumen_trust_live_origins(origins) {
    if type_of(origins) != "array" { throw("Lumen trusted live origins must be an array") }
    let exact = []
    for i in 0..origins.len() {
        let origin = origins[i]
        if type_of(origin) != "string" or _lumen_valid_origin(origin) == false {
            throw("Lumen trusted live origins must be exact http(s) origins without paths")
        }
        if _lumen_list_has(exact, origin) == false { exact = exact.push(origin) }
    }
    _lumen_live_trusted_origins = exact
    return exact
}

fn _lumen_live_origin_allowed(req) {
    let headers = _validate.get_field(req, "headers")
    let origin = _validate.get_field(headers, "origin")
    if _lumen_valid_origin(origin) == false { return false }
    if _lumen_list_has(_lumen_live_trusted_origins, origin) { return true }
    let scheme = _validate.get_field(req, "scheme")
    let host = _validate.get_field(req, "host")
    if scheme == null or host == null or host == "" { return false }
    return origin == ("" + scheme + "://" + host)
}

fn _lumen_live_origin_error() {
    return http.create_struct(["status","body","content_type"], [403, "Forbidden: invalid WebSocket origin", "text/plain"])
}
