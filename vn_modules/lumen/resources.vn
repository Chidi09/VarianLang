// Server-owned Lumen resource, cache, infinite-query, and mutation state.
// Loaded by the ambient Lumen facade; these primitives require no browser JS.

let _lumen_resource_cache = [http.create_struct([], [])]
let _lumen_resource_versions = [http.create_struct([], [])]
let _lumen_resource_stats = [http.create_struct(["hits", "misses", "deduped", "evicted"], [0, 0, 0, 0])]

// ─── Lumen resource: reactive async-shaped data (React-Query-style) ───
// v1 is synchronous (fetcher runs on the render/handler thread).
// FUTURE (separate milestone): off-thread fetch + live re-render.
//
// Usage:
//   let users = lumen_resource(| | { return db.query("select ...") })
//   render:  if (r.state)().loading { ... } else { each (r.state)().data ... }
//   handler: let _ = (r.refetch)()   // re-runs the fetcher; loop re-renders after
fn lumen_resource(fetcher) {
    let holder = [http.create_struct(["loading","error","data"], [true, null, null])]
    let apply = |st| { holder[0] = st; return st }
    let run = | | {
        let st = null
        try {
            let d = fetcher()
            st = http.create_struct(["loading","error","data"], [false, null, d])
        } catch e {
            st = http.create_struct(["loading","error","data"], [false, "" + e, null])
        }
        return (apply)(st)
    }
    let _ = (run)()
    let snapshot = | | { return holder[0] }
    return http.create_struct(
        ["state", "refetch"],
        [snapshot, run]
    )
}

// ─── Keyed server resource cache ───
// A Varian-native query primitive: request keys are deterministic JSON values,
// data is shared across component instances, freshness is explicit, recursive
// duplicate loads collapse, and invalidation never requires browser state.
fn _lumen_resource_key(key) {
    return json_encode(key)
}

fn _lumen_resource_version(cache_key) {
    let version = _validate.get_field(_lumen_resource_versions[0], cache_key)
    if version == null { return 0 }
    return version
}

fn _lumen_resource_state(cache_key, entry, stale) {
    if entry == null {
        return http.create_struct(
            ["key", "status", "loading", "fetching", "stale", "error", "data", "updated_at"],
            [cache_key, "pending", true, false, true, null, null, null]
        )
    }
    let error = _validate.get_field(entry, "error")
    let status = "success"
    if error != null { status = "error" }
    if _validate.get_field(entry, "fetching") { status = "pending" }
    return http.create_struct(
        ["key", "status", "loading", "fetching", "stale", "error", "data", "updated_at"],
        [cache_key, status, status == "pending", _validate.get_field(entry, "fetching"), stale,
         error, _validate.get_field(entry, "data"), _validate.get_field(entry, "updated_at")]
    )
}

fn lumen_cached_resource(key, fetcher, opts) {
    let cache_key = _lumen_resource_key(key)
    let stale_ms = 30000
    let gc_ms = 300000
    if opts != null {
        let configured = _validate.get_field(opts, "stale_ms")
        if configured != null { stale_ms = configured }
        let configured_gc = _validate.get_field(opts, "gc_ms")
        if configured_gc != null { gc_ms = configured_gc }
    }
    if type_of(stale_ms) != "int" or stale_ms < 0 { throw("Lumen resource stale_ms must be a non-negative integer") }
    if type_of(gc_ms) != "int" or gc_ms < 0 { throw("Lumen resource gc_ms must be a non-negative integer") }
    let _ = lumen_resource_cache_gc(gc_ms)
    let holder = [_lumen_resource_state(cache_key, null, true)]
    let load = |force| {
        let now = time.now_ms()
        let version = _lumen_resource_version(cache_key)
        let entry = _validate.get_field(_lumen_resource_cache[0], cache_key)
        if entry != null {
            if _validate.get_field(entry, "fetching") {
                entry = _tpl_bind(entry, "accessed_at", now)
                _lumen_resource_cache[0] = _tpl_bind(_lumen_resource_cache[0], cache_key, entry)
                let deduped = _validate.get_field(_lumen_resource_stats[0], "deduped")
                _lumen_resource_stats[0] = _tpl_bind(_lumen_resource_stats[0], "deduped", deduped + 1)
                holder[0] = _lumen_resource_state(cache_key, entry, true)
                return holder[0]
            }
            let same_version = _validate.get_field(entry, "version") == version
            let age = now - _validate.get_field(entry, "updated_at")
            let fresh = same_version and age <= stale_ms
            if force == false and fresh {
                entry = _tpl_bind(entry, "accessed_at", now)
                _lumen_resource_cache[0] = _tpl_bind(_lumen_resource_cache[0], cache_key, entry)
                let hits = _validate.get_field(_lumen_resource_stats[0], "hits")
                _lumen_resource_stats[0] = _tpl_bind(_lumen_resource_stats[0], "hits", hits + 1)
                holder[0] = _lumen_resource_state(cache_key, entry, false)
                return holder[0]
            }
        }
        let previous = null
        if entry != null { previous = _validate.get_field(entry, "data") }
        let pending = http.create_struct(
            ["data", "error", "updated_at", "accessed_at", "version", "fetching"],
            [previous, null, now, now, version, true]
        )
        _lumen_resource_cache[0] = _tpl_bind(_lumen_resource_cache[0], cache_key, pending)
        holder[0] = _lumen_resource_state(cache_key, pending, true)
        let final = null
        try {
            let data = fetcher()
            final = http.create_struct(
                ["data", "error", "updated_at", "accessed_at", "version", "fetching"],
                [data, null, time.now_ms(), time.now_ms(), version, false]
            )
        } catch e {
            final = http.create_struct(
                ["data", "error", "updated_at", "accessed_at", "version", "fetching"],
                [previous, "" + e, time.now_ms(), time.now_ms(), version, false]
            )
        }
        _lumen_resource_cache[0] = _tpl_bind(_lumen_resource_cache[0], cache_key, final)
        let misses = _validate.get_field(_lumen_resource_stats[0], "misses")
        _lumen_resource_stats[0] = _tpl_bind(_lumen_resource_stats[0], "misses", misses + 1)
        holder[0] = _lumen_resource_state(cache_key, final, false)
        return holder[0]
    }
    let initial = (load)(false)
    let state = | | {
        let entry = _validate.get_field(_lumen_resource_cache[0], cache_key)
        if entry != null {
            entry = _tpl_bind(entry, "accessed_at", time.now_ms())
            _lumen_resource_cache[0] = _tpl_bind(_lumen_resource_cache[0], cache_key, entry)
        }
        return holder[0]
    }
    let refetch = | | { return (load)(true) }
    let invalidate = | | { lumen_resource_invalidate(key); holder[0] = _lumen_resource_state(cache_key, _validate.get_field(_lumen_resource_cache[0], cache_key), true); return holder[0] }
    return http.create_struct(["state", "refetch", "invalidate"], [state, refetch, invalidate])
}

fn lumen_resource_invalidate(key) {
    let cache_key = _lumen_resource_key(key)
    let version = _lumen_resource_version(cache_key)
    _lumen_resource_versions[0] = _tpl_bind(_lumen_resource_versions[0], cache_key, version + 1)
    return null
}

fn lumen_resource_cache_stats() {
    return http.create_struct(
        ["hits", "misses", "deduped", "evicted", "entries"],
        [_validate.get_field(_lumen_resource_stats[0], "hits"),
         _validate.get_field(_lumen_resource_stats[0], "misses"),
         _validate.get_field(_lumen_resource_stats[0], "deduped"),
         _validate.get_field(_lumen_resource_stats[0], "evicted"),
         _validate.get_keys(_lumen_resource_cache[0]).len()]
    )
}

fn lumen_resource_cache_gc(max_age_ms) {
    if type_of(max_age_ms) != "int" or max_age_ms < 0 { throw("Lumen resource GC age must be a non-negative integer") }
    let now = time.now_ms()
    let keys = _validate.get_keys(_lumen_resource_cache[0])
    let kept_keys = []
    let kept_values = []
    let evicted = 0
    for i in 0..keys.len() {
        let key = keys[i]
        let entry = _validate.get_field(_lumen_resource_cache[0], key)
        let accessed = _validate.get_field(entry, "accessed_at")
        if accessed == null { accessed = _validate.get_field(entry, "updated_at") }
        let fetching = _validate.get_field(entry, "fetching") == true
        if fetching or accessed == null or now - accessed <= max_age_ms {
            kept_keys = kept_keys.push(key)
            kept_values = kept_values.push(entry)
        } else {
            evicted = evicted + 1
        }
    }
    _lumen_resource_cache[0] = http.create_struct(kept_keys, kept_values)
    let version_keys = []
    let version_values = []
    for i in 0..kept_keys.len() {
        let version = _validate.get_field(_lumen_resource_versions[0], kept_keys[i])
        if version != null {
            version_keys = version_keys.push(kept_keys[i])
            version_values = version_values.push(version)
        }
    }
    _lumen_resource_versions[0] = http.create_struct(version_keys, version_values)
    if evicted > 0 {
        let total = _validate.get_field(_lumen_resource_stats[0], "evicted")
        _lumen_resource_stats[0] = _tpl_bind(_lumen_resource_stats[0], "evicted", total + evicted)
    }
    return evicted
}

// ─── Cursor/infinite resources ───
// Pages use the deterministic server cache. fetch_page(cursor) returns
// { items: [...], next_cursor: value|null }; no browser cache is required.
fn lumen_infinite_resource(key, fetch_page, opts) {
    let pages = [[]]
    let page_keys = [[]]
    let cursor = [null]
    let has_next = [true]
    let error = [null]
    let fetching_next = [false]

    let snapshot = | | {
        let items = []
        for i in 0..pages[0].len() {
            let page_items = _validate.get_field(pages[0][i], "items")
            for j in 0..page_items.len() { items = items.push(page_items[j]) }
        }
        let status = "success"
        if fetching_next[0] { status = "pending" }
        if error[0] != null { status = "error" }
        return http.create_struct(
            ["key", "status", "pages", "items", "next_cursor", "has_next", "fetching_next", "error"],
            [_lumen_resource_key(key), status, pages[0], items, cursor[0], has_next[0], fetching_next[0], error[0]]
        )
    }

    let load_next = | | {
        if fetching_next[0] or has_next[0] == false { return snapshot() }
        let retrying = error[0] != null
        fetching_next[0] = true
        error[0] = null
        let page_cursor = cursor[0]
        let page_key = ["lumen-infinite", key, page_cursor]
        let resource = lumen_cached_resource(page_key, | | { return fetch_page(page_cursor) }, opts)
        let resource_state = (resource.state)()
        if retrying and resource_state.error != null { resource_state = (resource.refetch)() }
        if resource_state.error != null {
            error[0] = resource_state.error
            fetching_next[0] = false
            return snapshot()
        }
        let page = resource_state.data
        if page == null or type_of(_validate.get_field(page, "items")) != "array" {
            error[0] = "Lumen infinite resource page must contain an items array"
            fetching_next[0] = false
            return snapshot()
        }
        pages[0] = pages[0].push(page)
        page_keys[0] = page_keys[0].push(page_key)
        cursor[0] = _validate.get_field(page, "next_cursor")
        has_next[0] = cursor[0] != null
        fetching_next[0] = false
        return snapshot()
    }

    let invalidate = | | {
        for i in 0..page_keys[0].len() { lumen_resource_invalidate(page_keys[0][i]) }
        return snapshot()
    }
    let reset = | | {
        let _ = (invalidate)()
        pages[0] = []
        page_keys[0] = []
        cursor[0] = null
        has_next[0] = true
        error[0] = null
        fetching_next[0] = false
        return load_next()
    }
    let _ = load_next()
    return http.create_struct(
        ["state", "fetch_next", "invalidate", "reset"],
        [snapshot, load_next, invalidate, reset]
    )
}

// ─── Server mutation lifecycle ───
// `opts` may provide on_mutate(value)->context, on_success(data,value,context),
// on_error(error,value,context), and invalidate_keys (an array of resource keys).
// The context is deliberately application-defined: it can contain the exact
// previous server state needed for rollback without a second client cache.
fn _lumen_mutation_state(status, data, error, variables, context, submitted_at) {
    return http.create_struct(
        ["status", "idle", "pending", "success", "failed", "data", "error", "variables", "context", "submitted_at"],
        [status, status == "idle", status == "pending", status == "success", status == "error",
         data, error, variables, context, submitted_at]
    )
}

fn lumen_mutation(mutate_fn, opts) {
    let holder = [_lumen_mutation_state("idle", null, null, null, null, null)]
    let generation = [0]
    let prepare = |value| {
        generation[0] = generation[0] + 1
        let context = null
        let on_mutate = null
        if opts != null { on_mutate = _validate.get_field(opts, "on_mutate") }
        if on_mutate != null { context = (on_mutate)(value) }
        holder[0] = _lumen_mutation_state("pending", null, null, value, context, time.now_ms())
        return http.create_struct(["context", "generation"], [context, generation[0]])
    }
    let settle = |value, prepared| {
        let context = prepared.context
        try {
            let data = mutate_fn(value)
            let keys = null
            if opts != null { keys = _validate.get_field(opts, "invalidate_keys") }
            if keys != null {
                for i in 0..keys.len() { lumen_resource_invalidate(keys[i]) }
            }
            let on_success = null
            if opts != null { on_success = _validate.get_field(opts, "on_success") }
            if on_success != null { let _ = (on_success)(data, value, context) }
            if prepared.generation == generation[0] {
                holder[0] = _lumen_mutation_state("success", data, null, value, context, holder[0].submitted_at)
            }
        } catch e {
            let message = "" + e
            let on_error = null
            if opts != null { on_error = _validate.get_field(opts, "on_error") }
            if on_error != null { let _ = (on_error)(message, value, context) }
            if prepared.generation == generation[0] {
                holder[0] = _lumen_mutation_state("error", null, message, value, context, holder[0].submitted_at)
            }
        }
        return holder[0]
    }
    let execute = |value| { return (settle)(value, (prepare)(value)) }
    let execute_async = |value| {
        let prepared = (prepare)(value)
        let run = | | {
            let result = (settle)(value, prepared)
            let _ = _lumen_async_updates <- true
            return result
        }
        return task.spawn(run, [])
    }
    let state = | | { return holder[0] }
    let reset = | | { generation[0] = generation[0] + 1; holder[0] = _lumen_mutation_state("idle", null, null, null, null, null); return holder[0] }
    return http.create_struct(["state", "mutate", "mutate_async", "reset"], [state, execute, execute_async, reset])
}
