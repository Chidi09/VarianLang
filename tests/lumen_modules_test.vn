fn _assert_module(name, marker) {
    let js = _lumen_module(name)
    assert_ne(js, "")
    assert_ne(js.index_of(marker), -1)
}

fn _count_text(haystack, needle) {
    let count = 0
    let at = haystack.index_of(needle)
    while at >= 0 {
        count = count + 1
        at = haystack.index_of(needle, at + needle.len())
    }
    return count
}

test "pure browser modules are implemented" {
    _assert_module("events", "new FormData")
    _assert_module("vtable", "data-lumen-vtable")
    _assert_module("clipboard", "navigator.clipboard")
    _assert_module("focus", "data-lumen-focus")
    _assert_module("scroll", "scrollIntoView")
    _assert_module("persist", "localStorage")
    _assert_module("time", "RelativeTimeFormat")
    _assert_module("media", "IntersectionObserver")
    _assert_module("window", "prefers-color-scheme")
    _assert_module("nav", "history.pushState")
    _assert_module("prefetch", "rel='prefetch'")
    _assert_module("transition", "requestAnimationFrame")
    _assert_module("defer", "data-lumen-defer-result")
    _assert_module("anchor", "getBoundingClientRect")
    _assert_module("inview", "intersectionRatio")
    _assert_module("sortable", "data-lumen-sort-item")
    _assert_module("toast", "__lumen_toast")
    _assert_module("key", "data-lumen-key")
}

test "deferred replacement action is emitted only for its marker" {
    assert_eq(_lumen_action_list_has(_lumen_scan_directives("<main>static</main>"), "defer"), false)
    let actions = _lumen_scan_directives("<lumen-defer data-lumen-defer=\"report\"></lumen-defer>")
    assert_eq(_lumen_action_list_has(actions, "defer"), true)
    let js = _lumen_client_js_with_manifest(actions)
    assert_ne(js.index_of("data-lumen-defer-result"), -1)
}

test "core capability scanner selects interaction and virtual table actions" {
    let mods = _lumen_scan_directives("<form data-lumen-submit=\"save\"><div data-lumen-vtable></div></form>")
    assert_eq(mods.len(), 2)
    assert_eq(mods[0], "events")
    assert_eq(mods[1], "vtable")
    let resolved = _lumen_resolve_actions(mods)
    assert_eq(resolved.len(), 3)
    assert_eq(resolved[0], "events")
    assert_eq(resolved[1], "event-bridge")
    assert_eq(resolved[2], "vtable")
}

test "presentation-only toggle module is implemented" {
    _assert_module("toggle", "aria-expanded")
}

test "scroll restoration is route aware and initialized without a click" {
    let js = _lumen_module("scroll")
    assert_ne(js.index_of("location.pathname+location.search"), -1)
    assert_ne(js.index_of("requestAnimationFrame(G)"), -1)
    assert_ne(js.index_of("beforeunload"), -1)
    assert_ne(js.index_of("popstate"), -1)
    assert_ne(js.index_of("a[data-lumen-nav]"), -1)
    assert_eq(_lumen_scan_directives("<main>plain</main>").len(), 0)
}

test "directive scanner tree-shakes and deduplicates modules" {
    let tpl = "<time data-lumen-time=\"relative\"></time>" +
              "<input data-lumen-persist=\"draft\">" +
              "<a data-lumen-nav href=\"/next\">Next</a>" +
              "<time data-lumen-time=\"countdown\"></time>"
    let mods = _lumen_scan_directives(tpl)
    assert_eq(mods.len(), 3)
    assert_eq(mods[0], "persist")
    assert_eq(mods[1], "time")
    assert_eq(mods[2], "nav")
}

test "core-only pages do not ship optional modules" {
    let mods = _lumen_scan_directives("<button data-lumen-click=\"save\">Save</button>")
    assert_eq(mods.len(), 1)
    assert_eq(mods[0], "events")
    let js = _lumen_client_js_with_manifest(mods)
    assert_ne(js.index_of("new FormData"), -1)
    assert_eq(js.index_of("navigator.clipboard"), -1)
    assert_eq(js.index_of("RelativeTimeFormat"), -1)
}

test "selected manifest ships only selected modules" {
    let js = _lumen_client_js_with_manifest(["persist", "time"])
    assert_ne(js.index_of("localStorage"), -1)
    assert_ne(js.index_of("RelativeTimeFormat"), -1)
    assert_eq(js.index_of("navigator.clipboard"), -1)
    assert_eq(js.index_of("history.pushState"), -1)
}

test "prefetch is opt-in, deduplicated, and independent of navigation" {
    let hint = lumen_prefetch("/reports?range=week&team=core")
    assert_ne(hint.index_of("rel=\"prefetch\""), -1)
    assert_ne(hint.index_of("range=week&amp;team=core"), -1)
    assert_eq(_lumen_scan_directives(hint).len(), 0)

    let anchor = lumen_prefetch_link("/reports", "Reports")
    let actions = _lumen_scan_directives(anchor)
    assert_eq(actions.len(), 1)
    assert_eq(actions[0], "prefetch")
    let js = _lumen_client_js_with_manifest(actions)
    assert_ne(js.index_of("new Set"), -1)
    assert_ne(js.index_of("a.origin!==location.origin"), -1)
    assert_eq(js.index_of("preventDefault"), -1)
    assert_eq(js.index_of("history.pushState"), -1)
}

test "event modules share reconnect-safe queued transport" {
    let js = _lumen_client_js_with_manifest(["key", "nav", "inview", "sortable"])
    assert_ne(js.index_of("window.__lumen_push"), -1)
    assert_ne(js.index_of("else q.push(m)"), -1)
    assert_ne(js.index_of("while(q.length"), -1)
    assert_eq(_count_text(js, "else q.push(m)"), 1)
}

test "action registry resolves dependencies in stable order" {
    let a = _lumen_resolve_actions(["sortable", "nav", "key", "inview", "nav"])
    let b = _lumen_resolve_actions(["inview", "key", "nav", "sortable"])
    assert_eq(b.len(), a.len())
    for i in 0..a.len() { assert_eq(b[i], a[i]) }
    assert_eq(a.len(), 5)
    assert_eq(a[0], "event-bridge")
    assert_eq(a[1], "key")
    assert_eq(a[2], "nav")
    assert_eq(a[3], "inview")
    assert_eq(a[4], "sortable")
}

test "unknown actions and unused dependencies emit zero bytes" {
    let core = _lumen_client_core() + ";" + _lumen_error_brand()
    assert_eq(_lumen_resolve_actions(["unknown"]).len(), 0)
    assert_eq(_lumen_client_js_with_manifest([]).len(), core.len())
    assert_eq(_lumen_client_js_with_manifest(["unknown"]).len(), core.len())
    assert_eq(_lumen_client_js_with_manifest(["clipboard"]).len(),
              core.len() + 1 + _lumen_module("clipboard").len())
}

test "browser action payloads stay within explicit regression ceilings" {
    // These are uncompressed emitted bytes. The core ceiling records today's
    // baseline until transport/morph/form concerns are split into actions.
    assert_eq((_lumen_client_core().len() + 1 + _lumen_error_brand().len()) <= 4100, 1)
    let registry = _lumen_action_registry()
    for i in 0..registry.len() {
        let name = _validate.get_field(registry[i], "name")
        let ceiling = 850
        if name == "events" { ceiling = 1800 }
        if name == "scroll" { ceiling = 950 }
        assert_eq(_lumen_module(name).len() <= ceiling, 1)
    }
}
