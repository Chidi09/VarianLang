test "mutation exposes success lifecycle and callbacks" {
    let events = [[]]
    let m = lumen_mutation(
        |value| { events[0] = events[0].push("run:" + value); return value * 2 },
        {
            on_mutate: |value| { events[0] = events[0].push("optimistic:" + value); return { previous: 7 } },
            on_success: |data, value, context| { events[0] = events[0].push("success:" + data); return null }
        }
    )
    assert_eq((m.state)().status, "idle")
    let result = (m.mutate)(4)
    assert_eq(result.status, "success")
    assert_eq(result.data, 8)
    assert_eq(result.variables, 4)
    assert_eq(result.context.previous, 7)
    assert_eq(events[0][0], "optimistic:4")
    assert_eq(events[0][1], "run:4")
    assert_eq(events[0][2], "success:8")
}

test "mutation error callback receives optimistic rollback context" {
    let rolled_back = [null]
    let m = lumen_mutation(
        |value| { throw("save failed") },
        {
            on_mutate: |value| { return { previous: "before" } },
            on_error: |error, value, context| {
                rolled_back[0] = context.previous
                return null
            }
        }
    )
    let result = (m.mutate)("after")
    assert_eq(result.status, "error")
    assert_eq(result.failed, true)
    assert_eq(result.error.contains("save failed"), true)
    assert_eq(rolled_back[0], "before")
}

test "successful mutation invalidates declared resource keys" {
    let key = ["mutation-users", 404]
    let calls = [0]
    let fetch = | | { calls[0] = calls[0] + 1; return calls[0] }
    let before = lumen_cached_resource(key, fetch, { stale_ms: 60000 })
    assert_eq((before.state)().data, 1)
    let m = lumen_mutation(|value| { return value }, { invalidate_keys: [key] })
    let result = (m.mutate)("saved")
    assert_eq(result.status, "success")
    let after = lumen_cached_resource(key, fetch, { stale_ms: 60000 })
    assert_eq(calls[0], 2)
    assert_eq((after.state)().data, 2)
}

test "mutation reset returns to idle and clears payload" {
    let m = lumen_mutation(|value| { return value }, null)
    let _ = (m.mutate)(9)
    let idle = (m.reset)()
    assert_eq(idle.status, "idle")
    assert_eq(idle.data, null)
    assert_eq(idle.error, null)
    assert_eq(idle.variables, null)
}

test "background mutation exposes pending state then settles" {
    let events = [[]]
    let m = lumen_mutation(
        |value| { events[0] = events[0].push("run"); return value * 3 },
        { on_mutate: |value| { events[0] = events[0].push("optimistic"); return { previous: 2 } } }
    )
    let job = (m.mutate_async)(5)
    assert_eq(task.id(job) >= 0, 1)
    assert_eq((m.state)().status, "pending")
    assert_eq((m.state)().context.previous, 2)
    task.yield()
    assert_eq((m.state)().status, "success")
    assert_eq((m.state)().data, 15)
    assert_eq(events[0][0], "optimistic")
    assert_eq(events[0][1], "run")
}

test "older background completion cannot overwrite a newer mutation" {
    let m = lumen_mutation(|value| {
        if value == 1 { task.sleep(5) }
        return value
    }, null)
    let first = (m.mutate_async)(1)
    let second = (m.mutate_async)(2)
    task.yield()
    assert_eq((m.state)().status, "success")
    assert_eq((m.state)().data, 2)
    task.sleep(10)
    assert_eq((m.state)().data, 2)
    assert_eq(task.id(first) >= 0, 1)
    assert_eq(task.id(second) >= 0, 1)
}
