<script>
fn state() {
    return { scrapers: [] }
}
</script>

<client>
window.saveWorkflow = async function() {
    let name = prompt("Enter workflow name:");
    if (!name) return;

    let btn = document.querySelector("button.btn-gradient");
    let originalText = btn.innerHTML;
    btn.innerHTML = "Saving...";
    btn.disabled = true;

    try {
        let res = await fetch("/api/workflows", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                name: name,
                definition: { nodes: ["cron", "scraper", "webhook"] }, // dummy
                schedule: "0 0 * * *"
            })
        });

        if (res.ok) {
            alert("Workflow saved successfully!");
        } else {
            let data = await res.json();
            alert("Error: " + data.error);
        }
    } catch(e) {
        alert("Failed to save: " + e);
    } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
};
</client>
