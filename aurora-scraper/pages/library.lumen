<template>
<Page class="flex min-h-screen bg-[#051424]">
  <Sidebar active_library={true} />

  <div class="flex-1 flex flex-col min-h-screen overflow-x-hidden relative pb-12">
    <div class="fixed inset-0 z-[-1] pointer-events-none">
      <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-[#3b82f6]/10 rounded-full blur-[150px]"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-[#1d4ed8]/10 rounded-full blur-[150px]"></div>
    </div>

    <Header />

    <main class="flex-grow pt-24 px-10 max-w-[1440px] mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Create Scraper Form (4 cols) -->
      <aside class="lg:col-span-4 flex flex-col gap-6">
        <div class="glass-panel rounded-xl p-6 flex flex-col gap-6 glow-border-primary">
          <div class="flex items-center gap-3 border-b border-[#3b494b]/20 pb-4">
            <span class="material-symbols-outlined text-[#3b82f6]" style="font-variation-settings: 'FILL' 1;">add_box</span>
            <h2 class="font-bold text-lg text-white">New Agent Configuration</h2>
          </div>
          
          <form class="flex flex-col gap-4" onsubmit="createScraper(event)">
            <div class="flex flex-col gap-2">
              <label class="text-[11px] font-bold text-[#b9cacb] uppercase tracking-wider">Agent Name</label>
              <input id="agent-name" class="w-full bg-[#020617] border border-[#3b494b]/50 rounded-lg px-4 py-3 text-white text-sm input-glow transition-all" placeholder="e.g. E-Comm Price Tracker" type="text" required />
            </div>

            <div class="flex flex-col gap-2">
              <label class="text-[11px] font-bold text-[#b9cacb] uppercase tracking-wider">Gemini System Prompt / Rules</label>
              <textarea id="agent-prompt" class="w-full bg-[#020617] border border-[#3b494b]/50 rounded-lg px-4 py-3 text-white text-sm input-glow transition-all resize-none" placeholder="Instruct Gemini how to extract and shape the scraped text data. e.g. Find all pricing plans and features, output as JSON." rows="6" required></textarea>
            </div>

            <button type="submit" class="w-full btn-gradient text-white text-sm font-semibold py-3.5 rounded-lg shadow-[0_4px_14px_0_rgba(0,219,233,0.25)] flex justify-center items-center gap-2 mt-2 transition-all">
              Save Agent configuration
              <span class="material-symbols-outlined text-[16px]">save</span>
            </button>
          </form>
        </div>
      </aside>

      <!-- Scrapers List (8 cols) -->
      <section class="lg:col-span-8 flex flex-col gap-6">
        <div class="glass-panel rounded-xl flex-1 flex flex-col overflow-hidden">
          <div class="p-4 border-b border-[#3b494b]/20 flex justify-between items-center bg-[#122131]/30">
            <h3 class="font-bold text-white flex items-center gap-2 text-sm">
              <span class="material-symbols-outlined text-[#3b82f6]">list_alt</span>
              Configured Agents Library
            </h3>
            <span class="text-xs text-[#b9cacb] font-mono">SQLite backed</span>
          </div>

          <!-- Bento Grid of Scraper cards -->
          <div class="p-6 overflow-y-auto max-h-[70vh] grid grid-cols-1 md:grid-cols-2 gap-4">
            {{#each scrapers as s}}
              <div class="glass-card rounded-xl p-5 relative overflow-hidden group border-[#3b494b]/20 hover:border-[#3b82f6]/40 transition-colors">
                <div class="flex justify-between items-start mb-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-[#273647] flex items-center justify-center border border-[#3b494b]/30">
                      <span class="material-symbols-outlined text-[#3b82f6]">psychology</span>
                    </div>
                    <div>
                      <h4 class="font-bold text-sm text-white">{{ s.name }}</h4>
                      <p class="text-[10px] text-[#b9cacb] font-mono mt-0.5">ID: #AGT-{{ s.id }}</p>
                    </div>
                  </div>
                </div>
                <div class="bg-[#010f1f]/50 p-3 rounded-lg border border-[#3b494b]/20 max-h-[120px] overflow-y-auto">
                  <p class="text-xs text-[#b9cacb] font-mono leading-relaxed">{{ s.prompt }}</p>
                </div>
                <div class="flex justify-between items-center mt-4 pt-3 border-t border-[#3b494b]/10 text-[10px] text-[#b9cacb]/60">
                  <span>Saved: {{ s.created }}</span>
                  <button class="hover:text-white transition-colors flex items-center gap-1 font-semibold uppercase" onclick="deleteScraper({{ s.id }})"><span class="material-symbols-outlined text-xs">delete</span> Delete</button>
                </div>
              </div>
            {{/each}}
          </div>
        </div>
      </section>
    </main>
  </div>
</Page>
</template>

<script>
fn state() {
    return { scrapers: [] }
}
</script>

<client>
window.createScraper = async function(event) {
    event.preventDefault();
    let name = document.getElementById("agent-name").value;
    let prompt = document.getElementById("agent-prompt").value;
    
    let btn = event.target.querySelector("button");
    let originalText = btn.innerHTML;
    btn.innerHTML = "Saving... <span class='material-symbols-outlined animate-spin text-[16px]'>sync</span>";
    btn.disabled = true;
    
    try {
        let res = await fetch("/api/scrapers", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name: name, prompt: prompt })
        });
        
        if (res.ok) {
            window.location.reload();
        } else {
            let data = await res.json();
            alert("Error: " + data.error);
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    } catch (e) {
        alert("Failed to save configuration: " + e);
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
};

window.deleteScraper = async function(id) {
    if (!confirm("Are you sure you want to delete this agent configuration?")) return;
    try {
        let res = await fetch("/api/scrapers/" + id, { method: "DELETE" });
        if (res.ok) {
            window.location.reload();
        } else {
            let data = await res.json();
            alert("Error: " + data.error);
        }
    } catch(e) {
        alert("Failed to delete scraper: " + e);
    }
};
</client>
