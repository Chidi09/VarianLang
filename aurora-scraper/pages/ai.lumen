<template>
<Page class="flex min-h-screen bg-[#051424]">
  <Sidebar active_ai={true} />

  <div class="flex-1 flex flex-col min-h-screen overflow-x-hidden relative">
    <div class="fixed inset-0 z-[-1] pointer-events-none">
      <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-[#3b82f6]/10 rounded-full blur-[150px]"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-[#1d4ed8]/10 rounded-full blur-[150px]"></div>
    </div>

    <Header />

    <!-- Chat Interface Container -->
    <main class="flex-grow pt-24 px-10 max-w-[1000px] mx-auto w-full flex flex-col h-[calc(100vh-64px)] pb-6 gap-6">

      <!-- Top Title -->
      <div class="border-b border-[#3b494b]/20 pb-4 shrink-0">
        <h2 class="font-bold text-2xl text-white">Synthetic Intelligence Interface</h2>
        <p class="text-xs text-[#b9cacb] mt-1">Converse with Gemini to query, filter, and summarize your SQLite datasets.</p>
      </div>

      <!-- Chat area (glass panel) -->
      <div class="glass-panel rounded-xl flex-grow flex flex-col overflow-hidden min-h-[300px]">
        <!-- Messages stream -->
        <div id="ai-chat-box" class="flex-1 p-6 overflow-y-auto flex flex-col gap-4">
          <div class="flex gap-4">
            <div class="w-8 h-8 rounded bg-[#3b82f6]/10 border border-[#3b82f6]/20 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[#3b82f6] text-[20px]">smart_toy</span>
            </div>
            <div class="bg-[#122131]/30 p-4 rounded-xl border border-[#3b494b]/20 max-w-[80%]">
              <p class="text-xs text-white leading-relaxed">
                Welcome to the Synthetic Intelligence Interface. I have loaded context from the scraped datasets table. Ask me anything about the pricing, titles, or URLs of your crawled pages!
              </p>
            </div>
          </div>
          <!-- Additional dynamic messages append here -->
        </div>

        <!-- Chat input area -->
        <div class="p-4 border-t border-[#3b494b]/20 bg-[#122131]/30 shrink-0">
          <form class="flex gap-4" onsubmit="queryAi(event)">
            <input id="ai-message" class="flex-grow bg-[#020617] border border-[#3b494b]/50 rounded-lg px-4 py-3 text-white text-xs input-glow" placeholder="e.g. Find all products priced above $500, or summarize the listings found." type="text" autocomplete="off" required />
            <button type="submit" class="btn-gradient text-white text-xs font-semibold px-6 py-3 rounded-lg shadow-md flex items-center gap-1.5">
              Send <span class="material-symbols-outlined text-xs">send</span>
            </button>
          </form>
        </div>
      </div>

    </main>
  </div>
</Page>
</template>

<script>
fn state() {
    return { datasets: [] }
}
</script>

<client>
window.queryAi = async function(event) {
    event.preventDefault();
    let messageInput = document.getElementById("ai-message");
    let message = messageInput.value;
    messageInput.value = "";

    let chatBox = document.getElementById("ai-chat-box");

    // Append User Message
    let userMsg = document.createElement("div");
    userMsg.className = "flex gap-4 justify-end";
    userMsg.innerHTML = `
        <div class="bg-[#1d4ed8]/20 p-4 rounded-xl border border-[#1d4ed8]/30 max-w-[80%] text-right">
            <p class="text-xs text-white leading-relaxed">${message}</p>
        </div>
        <div class="w-8 h-8 rounded bg-[#1d4ed8]/10 border border-[#1d4ed8]/20 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[#dcb8ff] text-[20px]">person</span>
        </div>
    `;
    chatBox.appendChild(userMsg);
    chatBox.scrollTop = chatBox.scrollHeight;

    // Append Loading Indicator
    let loader = document.createElement("div");
    loader.className = "flex gap-4";
    loader.innerHTML = `
        <div class="w-8 h-8 rounded bg-[#3b82f6]/10 border border-[#3b82f6]/20 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[#3b82f6] text-[20px] animate-spin">sync</span>
        </div>
        <div class="bg-[#122131]/30 p-4 rounded-xl border border-[#3b494b]/20 text-xs text-[#b9cacb] font-mono">
            Gemini is thinking...
        </div>
    `;
    chatBox.appendChild(loader);
    chatBox.scrollTop = chatBox.scrollHeight;

    try {
        let res = await fetch("/api/ai/query", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message: message })
        });

        loader.remove();

        if (res.ok) {
            let data = await res.json();
            let aiMsg = document.createElement("div");
            aiMsg.className = "flex gap-4";
            aiMsg.innerHTML = `
                <div class="w-8 h-8 rounded bg-[#3b82f6]/10 border border-[#3b82f6]/20 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[#3b82f6] text-[20px]">smart_toy</span>
                </div>
                <div class="bg-[#122131]/30 p-4 rounded-xl border border-[#3b494b]/20 max-w-[80%]">
                    <p class="text-xs text-white leading-relaxed">${data.response}</p>
                </div>
            `;
            chatBox.appendChild(aiMsg);
        } else {
            let data = await res.json();
            let err = document.createElement("div");
            err.className = "flex gap-4";
            err.innerHTML = `
                <div class="w-8 h-8 rounded bg-red-500/10 border border-red-500/20 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-red-400 text-[20px]">error</span>
                </div>
                <div class="bg-red-500/10 p-4 rounded-xl border border-red-500/20 max-w-[80%] text-xs text-red-400">
                    Error: ${data.error}
                </div>
            `;
            chatBox.appendChild(err);
        }
    } catch (e) {
        loader.remove();
        alert("Failed to query AI: " + e);
    }

    chatBox.scrollTop = chatBox.scrollHeight;
};
</client>
