<style>
  * { box-sizing: border-box; }
  html, body { background: #030d1a !important; color: #f0f6ff !important; min-height: 100vh; }
  section, footer, nav, header, main, div { color: inherit; }

  /* ── Navbar states ── */
  #navbar {
    transition: background 0.3s ease, border-color 0.3s ease, padding 0.3s ease, backdrop-filter 0.3s ease;
  }
  #navbar.scrolled {
    background: rgba(3, 13, 26, 0.88) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(0, 219, 233, 0.12);
  }
  #navbar:not(.scrolled) {
    background: transparent !important;
    border-bottom: 1px solid transparent;
  }

  /* ── Scroll-triggered animations ── */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  .reveal-delay-4 { transition-delay: 0.4s; }
  .reveal-delay-5 { transition-delay: 0.5s; }

  /* ── Hero blur reveal ── */
  @keyframes blurReveal {
    0% { opacity: 0; filter: blur(14px); transform: scale(1.03); }
    100% { opacity: 1; filter: blur(0); transform: scale(1); }
  }
  .hero-line-1 { animation: blurReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both; }
  .hero-line-2 { animation: blurReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.7s both; }
  .hero-sub { animation: blurReveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) 1.2s both; }
  .hero-cta { animation: blurReveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) 1.4s both; }
  .hero-stats { animation: blurReveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) 1.6s both; }

  /* ── Gradient text utility ── */
  .gradient-text {
    background: linear-gradient(135deg, #3b82f6, #1d4ed8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Card hover lift ── */
  .card-lift {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease, box-shadow 0.4s ease;
  }
  .card-lift:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 219, 233, 0.25);
    box-shadow: 0 12px 40px rgba(0, 219, 233, 0.08);
  }

  /* ── Feature alternating rows ── */
  .feature-icon-glow {
    box-shadow: 0 0 20px rgba(0, 219, 233, 0.15);
  }

  /* ── Pill hover ── */
  .pill-hover {
    transition: all 0.3s ease;
  }
  .pill-hover:hover {
    border-color: rgba(0, 219, 233, 0.3);
    background: rgba(0, 219, 233, 0.06);
  }

  /* ── Scroll indicator bounce ── */
  @keyframes softBounce {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50% { transform: translateY(8px); opacity: 0.7; }
  }
  .scroll-indicator {
    animation: softBounce 2.5s ease-in-out infinite;
  }

  /* ── Mobile menu ── */
  #mobile-menu {
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding-top: 0;
    padding-bottom: 0;
  }
  #mobile-menu.open {
    max-height: 400px;
    opacity: 1;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
</style>

