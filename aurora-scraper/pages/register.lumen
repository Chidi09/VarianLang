<template>
<link rel="stylesheet" href="/public/styles/tailwind.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<Page class="flex min-h-screen">
  <div class="flex w-full min-h-screen">
    <!-- Left Pane: Form (50%) -->
    <div class="relative w-full lg:w-1/2 min-h-screen bg-[#051424] flex flex-col overflow-hidden">
      <!-- Glowing blobs -->
      <div class="absolute inset-0 z-0 pointer-events-none">
        <div class="absolute top-[-15%] left-[-15%] w-[50%] h-[50%] bg-[#3b82f6]/20 rounded-full blur-[200px]"></div>
        <div class="absolute bottom-[-15%] right-[-15%] w-[50%] h-[50%] bg-[#1d4ed8]/20 rounded-full blur-[200px]"></div>
      </div>
      <!-- Dot grid SVG pattern overlay -->
      <div class="absolute inset-0 z-0 pointer-events-none opacity-[0.04]">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="dotGrid-reg" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r="1.2" fill="#ffffff"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#dotGrid-reg)"/>
        </svg>
      </div>

      <!-- Content -->
      <div class="relative z-10 flex flex-col min-h-screen">
        <!-- Logo -->
        <div class="pt-8 px-10 lg:px-16">
          <a href="/" class="inline-flex items-center gap-2.5 group">
            <svg width="34" height="34" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="transition-transform duration-300 group-hover:scale-110">
              <path d="M18 2L8 18H14L12 30L24 14H18L20 2H18Z" fill="url(#aurora-grad-reg)" />
              <defs>
                <linearGradient id="aurora-grad-reg" x1="8" y1="2" x2="24" y2="30" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#3b82f6"/>
                  <stop offset="1" stop-color="#1d4ed8"/>
                </linearGradient>
              </defs>
            </svg>
            <span class="text-2xl font-extrabold bg-gradient-to-r from-[#3b82f6] to-[#1d4ed8] bg-clip-text text-transparent tracking-tight" style="font-family: 'Outfit', sans-serif;">Aurora</span>
          </a>
        </div>

        <!-- Vertically centered form -->
        <div class="flex-1 flex items-center justify-center px-10 lg:px-16">
          <div class="w-full max-w-sm flex flex-col gap-7">
            <div class="flex flex-col gap-2">
              <h1 class="text-3xl font-bold text-white tracking-tight" style="font-family: 'Outfit', sans-serif;">Create your account</h1>
              <p class="text-sm text-[#b9cacb]">Start extracting intelligence from the web.</p>
            </div>

            <form class="flex flex-col gap-5" onsubmit="doRegister(event)">
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-[#b9cacb] uppercase tracking-widest">Full Name</label>
                <input id="register-name" class="w-full bg-[#020617] border border-[#3b494b]/50 rounded-2xl px-5 py-4 text-sm font-medium text-white placeholder-[#6b8a8c] focus:border-[#3b82f6]/50 focus:ring-4 focus:ring-[#3b82f6]/10 transition-all outline-none" placeholder="John Doe" type="text" required />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-[#b9cacb] uppercase tracking-widest">Email Address</label>
                <input id="register-email" class="w-full bg-[#020617] border border-[#3b494b]/50 rounded-2xl px-5 py-4 text-sm font-medium text-white placeholder-[#6b8a8c] focus:border-[#3b82f6]/50 focus:ring-4 focus:ring-[#3b82f6]/10 transition-all outline-none" placeholder="name@domain.com" type="email" required autocomplete="email" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-[#b9cacb] uppercase tracking-widest">Password</label>
                <input id="register-pass" class="w-full bg-[#020617] border border-[#3b494b]/50 rounded-2xl px-5 py-4 text-sm font-medium text-white placeholder-[#6b8a8c] focus:border-[#3b82f6]/50 focus:ring-4 focus:ring-[#3b82f6]/10 transition-all outline-none" placeholder="Create a strong password" type="password" required autocomplete="new-password" />
              </div>
              <button type="submit" class="w-full bg-gradient-to-r from-[#3b82f6] to-[#1d4ed8] text-white font-bold py-4 rounded-2xl shadow-lg shadow-[#3b82f6]/20 hover:shadow-[#3b82f6]/30 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 text-sm tracking-wide">
                Create Account
              </button>
            </form>

            <div class="relative">
              <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-[#3b494b]/30"></div></div>
              <div class="relative flex justify-center"><span class="bg-[#051424] px-4 text-xs text-[#6b8a8c]">already registered?</span></div>
            </div>

            <p class="text-center text-sm text-[#b9cacb]">
              Already have an account? <a href="/login" class="text-[#3b82f6] hover:text-[#3b82f6]/80 font-semibold hover:underline transition-all">Sign in</a>
            </p>
          </div>
        </div>

        <!-- Footer -->
        <div class="px-10 lg:px-16 pb-8">
          <p class="text-xs text-[#6b8a8c]">&copy; 2026 Aurora Scraper. All rights reserved.</p>
        </div>
      </div>
    </div>

    <!-- Right Pane: Image (50%) - hidden on mobile -->
    <div class="relative w-1/2 min-h-screen hidden lg:block overflow-hidden">
      <img src="/public/hero-auth.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#030d1a] via-[#030d1a]/30 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#051424]/70 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-12 lg:p-16">
        <div class="max-w-md">
          <svg width="44" height="44" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="mb-5 opacity-90">
            <path d="M18 2L8 18H14L12 30L24 14H18L20 2H18Z" fill="url(#aurora-grad-reg-r)" />
            <defs>
              <linearGradient id="aurora-grad-reg-r" x1="8" y1="2" x2="24" y2="30" gradientUnits="userSpaceOnUse">
                <stop stop-color="#3b82f6"/>
                <stop offset="1" stop-color="#1d4ed8"/>
              </linearGradient>
            </defs>
          </svg>
          <h2 class="text-3xl font-bold text-white mb-3 leading-tight" style="font-family: 'Outfit', sans-serif;">Join the Future of Web Data</h2>
          <p class="text-[#b9cacb] text-sm leading-relaxed">Unlock the power of AI-driven extraction. Aurora intelligently scrapes, structures, and delivers the data you need.</p>
          <div class="flex items-center gap-4 mt-6">
            <div class="flex items-center gap-2">
              <div class="w-1.5 h-1.5 rounded-full bg-[#3b82f6] shadow-[0_0_8px_#3b82f6]"></div>
              <span class="text-xs text-[#b9cacb]">Free tier available</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-1.5 h-1.5 rounded-full bg-[#1d4ed8] shadow-[0_0_8px_#1d4ed8]"></div>
              <span class="text-xs text-[#b9cacb]">No credit card</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Page>
</template>

<script>
fn state() { return {} }
</script>

<client>
window.doRegister = async function(event) {
    event.preventDefault();
    let name = document.getElementById("register-name").value;
    let email = document.getElementById("register-email").value;
    let pass = document.getElementById("register-pass").value;
    let btn = event.target.querySelector("button");
    let originalText = btn.innerHTML;
    btn.innerHTML = "Creating Account...";
    btn.disabled = true;
    try {
        let res = await fetch("/auth/register", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name: name, email: email, password: pass })
        });
        if (res.ok) {
            window.location.href = "/login";
        } else {
            let data = await res.json();
            alert("Error: " + data.error);
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    } catch(e) {
        alert("Registration failed: " + e);
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
};
</client>
