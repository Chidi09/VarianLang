<template>
<link rel="stylesheet" href="/public/styles/tailwind.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
<Page class="flex min-h-screen bg-[#051424]">
  <Sidebar active_jobs={true} />

  <div class="flex-1 flex flex-col min-h-screen overflow-x-hidden relative pb-12">
    <div class="fixed inset-0 z-[-1] pointer-events-none">
      <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-[#3b82f6]/10 rounded-full blur-[150px]"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-[#1d4ed8]/10 rounded-full blur-[150px]"></div>
    </div>

    <Header />

    <main class="flex-grow pt-24 px-10 max-w-[1440px] mx-auto w-full flex flex-col gap-6 animate-fade-in">
      <div class="flex justify-between items-center border-b border-[#3b494b]/20 pb-4">
        <div>
          <h2 class="font-bold text-2xl text-white">Jobs History</h2>
          <p class="text-xs text-[#b9cacb] mt-1">Full audit log of all scraping operations.</p>
        </div>
        <div class="flex gap-2">
          <button class="px-4 py-2 rounded-lg border border-[#3b82f6] text-[#3b82f6] text-xs font-semibold hover:bg-[#3b82f6]/10 transition-colors" onclick="window.location.reload()">
            Refresh Jobs
          </button>
        </div>
      </div>

      <div class="glass-panel rounded-xl flex-1 flex flex-col overflow-hidden">
        <div class="p-4 border-b border-[#3b494b]/20 flex justify-between items-center bg-[#122131]/30">
          <h3 class="font-bold text-white flex items-center gap-2 text-sm">
            <span class="material-symbols-outlined text-[#3b82f6]">history</span>
            Operation Records
          </h3>
        </div>

        <div class="overflow-x-auto flex-grow max-h-[70vh]">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-[#3b494b]/20 bg-[#010f1f]/50 text-[#b9cacb] text-[11px] font-bold uppercase tracking-wider">
                <th class="px-6 py-4">Job ID</th>
                <th class="px-6 py-4">Agent type</th>
                <th class="px-6 py-4">Target URL</th>
                <th class="px-6 py-4">Depth</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4">Progress</th>
                <th class="px-6 py-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="text-xs text-white divide-y divide-[#3b494b]/10 bg-[#0d1c2d]/20">
              {{#each jobs as j}}
                <tr class="hover:bg-[#2c3a4c]/20 transition-colors">
                  <td class="px-6 py-4 font-mono text-[#3b82f6]">#JOB-{{ j.id }}</td>
                  <td class="px-6 py-4 font-semibold">{{ j.scraper_name }}</td>
                  <td class="px-6 py-4 font-mono truncate max-w-[200px]" title="{{ j.target_url }}">{{ j.target_url }}</td>
                  <td class="px-6 py-4 font-mono">{{ j.depth }}</td>
                  <td class="px-6 py-4">
                    {{#if j.status == 'running'}}
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#3b82f6]/10 text-[#3b82f6] border border-[#3b82f6]/20 text-[10px] font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#3b82f6] animate-pulse-dot"></span> RUNNING
                      </span>
                    {{/if}}
                    {{#if j.status == 'pending'}}
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 text-[10px] font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse-dot"></span> QUEUED
                      </span>
                    {{/if}}
                    {{#if j.status == 'completed'}}
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-green-500/10 text-green-400 border border-green-500/20 text-[10px] font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> COMPLETED
                      </span>
                    {{/if}}
                    {{#if j.status == 'failed'}}
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20 text-[10px] font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span> FAILED
                      </span>
                    {{/if}}
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-2">
                      <div class="w-24 h-1.5 bg-[#122131] rounded-full overflow-hidden border border-[#3b494b]/30">
                        <div class="h-full {{#if j.status == 'running'}}progress-bar-animated{{else}}bg-[#3b82f6]{/if}}" style="width: {{ j.progress }}%;"></div>
                      </div>
                      <span class="font-mono text-[10px]">{{ j.progress }}%</span>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-right flex justify-end gap-2">
                    {{#if j.status == 'running' or j.status == 'pending'}}
                      <button onclick="cancelJob({{ j.id }})" class="px-2 py-1 bg-red-500/10 text-red-400 rounded hover:bg-red-500/20 transition-colors" title="Cancel Job">
                        <span class="material-symbols-outlined text-[14px]">cancel</span>
                      </button>
                    {{else}}
                      <button onclick="retryJob({{ j.id }})" class="px-2 py-1 bg-green-500/10 text-green-400 rounded hover:bg-green-500/20 transition-colors" title="Retry Job">
                        <span class="material-symbols-outlined text-[14px]">replay</span>
                      </button>
                    {{/if}}
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</Page>
</template>

<script>
fn state() { return { jobs: [] } }
</script>

<client>
window.cancelJob = async function(id) {
    if (!confirm("Are you sure you want to cancel Job #" + id + "?")) return;
    try {
        let res = await fetch("/api/jobs/" + id, { method: "DELETE" });
        if (res.ok) window.location.reload();
        else alert("Failed to cancel job.");
    } catch(e) {
        alert("Error: " + e);
    }
};

window.retryJob = async function(id) {
    if (!confirm("Retry Job #" + id + " with the same parameters?")) return;
    try {
        let res = await fetch("/api/jobs/" + id + "/retry", { method: "POST" });
        if (res.ok) window.location.reload();
        else alert("Failed to retry job.");
    } catch(e) {
        alert("Error: " + e);
    }
};
</client>
